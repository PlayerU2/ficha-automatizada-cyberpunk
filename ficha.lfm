<?xml version="1.0" encoding="UTF-8"?>
<!--
  ===========================================================================
  NIGHT CITY NOIR — Ficha de Personagem  ·  v2.1
  Baseada no Livro do Jogador v2.1 (28 páginas, 15 capítulos + apêndice)

  ARQUITETURA
    regras.lua              fórmulas puras, testáveis fora do Firecast
    dadosSistema.lua        as 28 perícias, alcance, tipos de arma
    catalogoCyberware.lua   Cap. 6
    catalogoEquipamento.lua Cap. 9, 10 e 12
    catalogoTracos.lua      Cap. 8
    itens/*.lfm             linhas das recordLists

  Todo o código vive na tabela global NCN. Um único nome global, para não
  colidir com outros plugins e para que os blocos CDATA de evento — que são
  chunks separados — enxerguem as funções.

  ===========================================================================
  PALETA — neon sobre preto, seguindo a arte do próprio livro

    pagina    #05060A    o fundo de tudo, quase preto
    painel    #0E1017    caixa de conteúdo
    painelAlt #12151E    caixa em destaque / aba ativa
    caixa     #080A0F    poço de campo, mais fundo que o painel
    borda     #1C2130    linha de contorno normal
    bordaViva #2A3145    contorno de coisa ativa

    ciano     #23E5D3    frio: rótulos, estrutura, o que é neutro
    magenta   #FF3B7F    quente: vida, perigo, números de ataque
    ambar     #FFB03A    aviso, iniciativa, dinheiro
    verde     #3DD68C    ok, saldo positivo, bônus
    roxo      #8A63C9    net, foco neural, o digital

    texto     #E8EAF2    corpo
    apagado   #8B90A6    rótulo secundário
    fraco     #4E5468    a conta, o que só se lê quando se procura

  ATENÇÃO: o parser de estilo do Firecast NÃO aceita comentário /* */.
  Ele espera um seletor (.class, #identifier, element ou *) no começo de
  cada regra e trata o conteúdo do comentário como seletor inválido,
  derrubando a compilação. Documentação de estilo fica AQUI FORA.

  A fonte monoespaçada dos rótulos é Consolas: existe em toda instalação
  Windows e é o que dá o ar de terminal sem precisar embarcar arquivo.
  Onde ela não existir, o Firecast cai na fonte padrão sozinho.
  ===========================================================================
-->
<form name="frmFichaNCN" formType="sheetTemplate" dataType="nightcitynoir_ficha"
      title="Night City Noir" theme="dark">

    <style>
    #frmFichaNCN label { fontColor: #E8EAF2; fontFamily: Rajdhani; fontSize: 14; }
    #frmFichaNCN edit  { fontColor: #FFFFFF; fontFamily: Rajdhani; fontSize: 14; }
    #frmFichaNCN comboBox   { fontFamily: Rajdhani; fontSize: 14; }
    #frmFichaNCN textEditor { fontFamily: Rajdhani; fontSize: 14; }

    .h1 { fontColor: #23E5D3; fontStyle: bold; fontSize: 19; fontFamily: Rajdhani; }
    .h2 { fontColor: #FF3B7F; fontStyle: bold; fontSize: 15; fontFamily: Rajdhani; }
    .rot { fontColor: #9AA0B8; fontSize: 13; fontFamily: Rajdhani; }
    .rotMin { fontColor: #757C96; fontSize: 12; fontFamily: Rajdhani; }
    .conta { fontColor: #6A7189; fontSize: 12; fontFamily: Consolas; }
    .val { fontColor: #E8EAF2; fontSize: 15; fontFamily: Rajdhani; }
    .valForte { fontColor: #E8EAF2; fontStyle: bold; fontSize: 15; fontFamily: Rajdhani; }
    .num { fontColor: #23E5D3; fontStyle: bold; fontSize: 26; fontFamily: Rajdhani; }
    .numG { fontColor: #FF3B7F; fontStyle: bold; fontSize: 36; fontFamily: Rajdhani; }
    .cab { fontColor: #23E5D3; fontStyle: bold; fontSize: 12; fontFamily: Rajdhani; }
    .aviso { fontColor: #FFB03A; fontSize: 14; fontFamily: Rajdhani; }
    .perigo { fontColor: #FF3B7F; fontStyle: bold; fontSize: 14; fontFamily: Rajdhani; }
    .ok { fontColor: #3DD68C; fontSize: 14; fontFamily: Rajdhani; }
    .ajuda { fontColor: #6A7189; fontSize: 12; fontFamily: Rajdhani; }
    .aba { fontColor: #9AA0B8; fontStyle: bold; fontSize: 13; fontFamily: Rajdhani; }
    </style>

    <script><![CDATA[
    -- =======================================================================
    -- MÓDULOS. Declarados no TOPO, antes de qualquer função que os use:
    -- em Lua, uma `local` só existe a partir da linha em que aparece, e o
    -- arquivo compila igual — o erro só aparece na tela do jogador.
    -- =======================================================================
    local R  = require("regras.lua")
    local D  = require("dadosSistema.lua")
    local CY = require("catalogoCyberware.lua")
    local EQ = require("catalogoEquipamento.lua")
    local TR = require("catalogoTracos.lua")

    if NCN == nil then NCN = {} end

    NCN.R, NCN.D, NCN.CY, NCN.EQ, NCN.TR = R, D, CY, EQ, TR

    NCN.COR = {
        pagina="#05060A", painel="#0E1017", painelAlt="#12151E", caixa="#080A0F",
        borda="#1C2130",  bordaViva="#2A3145",
        ciano="#23E5D3",  magenta="#FF3B7F", ambar="#FFB03A",
        verde="#3DD68C",  roxo="#8A63C9",
        texto="#E8EAF2",  apagado="#8B90A6", fraco="#4E5468",
        trilho="#171B26",
    }

    -- Sufixo do campo de bônus de cada atributo: cor -> bonusCor
    NCN.SUFIXO_ATRIBUTO = { cor="Cor", ref="Ref", men="Men", von="Von" }

    -- As dez abas, na ordem em que aparecem na barra.
    NCN.ABAS = {
        { id=1,  titulo="PERFIL",      cor="#23E5D3" },
        { id=2,  titulo="ATRIB/PER",   cor="#23E5D3" },
        { id=3,  titulo="COMBATE",     cor="#FF3B7F" },
        { id=4,  titulo="CYBERWARE",   cor="#FF3B7F" },
        { id=5,  titulo="TRAÇOS",      cor="#FFB03A" },
        { id=6,  titulo="EQUIPAMENTO", cor="#FFB03A" },
        { id=7,  titulo="NETRUNNING",  cor="#8A63C9" },
        { id=8,  titulo="VEÍCULOS",    cor="#3DD68C" },
        { id=9,  titulo="PROGRESSÃO",  cor="#3DD68C" },
        { id=10, titulo="BACKGROUND",  cor="#8B90A6" },
    }

    -- =======================================================================
    -- UTILITÁRIOS DE WIDGET
    -- Tudo em pcall: um widget ausente não pode derrubar o recálculo inteiro.
    -- =======================================================================

    function NCN.num(v, padrao)
        return tonumber(v) or (padrao or 0)
    end

    function NCN.txt(ctrl, s)
        if ctrl == nil then return end
        pcall(function() ctrl.text = tostring(s or "") end)
    end

    function NCN.pintar(ctrl, cor)
        if ctrl == nil then return end
        pcall(function() ctrl.fontColor = cor end)
    end

    function NCN.fundo(ctrl, cor)
        if ctrl == nil then return end
        pcall(function() ctrl.color = cor end)
    end

    function NCN.contorno(ctrl, cor)
        if ctrl == nil then return end
        pcall(function() ctrl.strokeColor = cor end)
    end

    -- Esconder por ALTURA ZERO, nunca por visible=false, em pilha align="top":
    -- um elemento escondido e mostrado de novo vai para o topo da pilha, não
    -- para a posição original. A exceção são os painéis de aba, que trocam
    -- `align` junto (ver NCN.irParaAba).
    function NCN.altura(ctrl, h)
        if ctrl == nil then return end
        pcall(function() ctrl.height = h end)
    end

    function NCN.largura(ctrl, w)
        if ctrl == nil then return end
        pcall(function() ctrl.width = w end)
    end

    function NCN.habilitar(ctrl, lig)
        if ctrl == nil then return end
        pcall(function() ctrl.enabled = (lig == true) end)
    end

    function NCN.mostrar(ctrl, lig)
        if ctrl == nil then return end
        pcall(function() ctrl.visible = (lig == true) end)
    end

    --- Dica de mouse em tempo de execução. É por aqui que o texto que saiu da
    --  linha continua acessível sem custar um pixel de largura.
    function NCN.dica(ctrl, texto)
        if ctrl == nil then return end
        pcall(function() ctrl.hint = tostring(texto or "") end)
    end

    --- LINHA DE NOTA de um item: some quando não tem nada do jogador.
    --
    -- Toda linha de lista tinha DUAS alturas: a do item e a da nota. Como a nota
    -- do livro era COPIADA para o campo ao adicionar, ela aparecia escrita em
    -- toda linha — dezenas de segundas linhas repetindo o que o catálogo já diz
    -- a um clique de distância. Era metade da altura da aba Equipamento.
    --
    -- Agora a nota do livro vive no `hint` do nome, e a linha só abre quando o
    -- JOGADOR escreveu algo diferente dela. Anotação de mesa continua visível;
    -- eco do livro, não.
    -- ETIQUETA DE OCULTAÇÃO (Cap. 9, pág. 23-A). Três tamanhos, três cores:
    -- dá para varrer a mochila e ver o que não passa numa revista sem abrir
    -- item nenhum. Quem o livro não cita fica sem etiqueta — o mestre decide, e
    -- inventar tamanho seria inventar regra.
    NCN.COR_OCULTACAO = { oculto="#3DD68C", volumoso="#FFB03A", aberto="#FF3B7F" }

    NCN.DICA_OCULTACAO = {
        oculto   = "Oculto — passa por revista de mão (Cap. 9)",
        volumoso = "Volumoso — denuncia quem se mexe (Cap. 9)",
        aberto   = "Aberto — quem olha, vê (Cap. 9)",
    }

    --- ETIQUETA DE OCULTAÇÃO — POR QUE VIROU UM PONTO.
    --
    -- Ela escrevia "VOLUMOSO" e crescia a própria largura EM TEMPO DE EXECUÇÃO,
    -- depois que a largura da linha já tinha sido repartida. Largura variável
    -- dentro de um orçamento fixo é a receita da linha estourar: com a etiqueta
    -- aberta, a arma reservava ~682 px de coluna fixa, e em janela menor que
    -- isso o espaço restante virava negativo — foi o que quebrou a linha na
    -- tela do jogador.
    --
    -- Agora é um ponto de largura FIXA. O texto vive na dica do mouse, que não
    -- ocupa pixel nenhum. A cor continua dizendo tudo de relance.
    function NCN.pintarOcultacao(self, it)
        local oc = it and it.ocultacao or nil
        local cor = NCN.COR_OCULTACAO[oc]
        NCN.fundo(self.pontoOcultacao, cor or "#232B3D")
        NCN.contorno(self.pontoOcultacao, cor or "#232B3D")
        NCN.dica(self.pontoOcultacao, NCN.DICA_OCULTACAO[oc]
                 or "Sem tamanho de ocultação no livro — o mestre decide")
    end

    -- Altura da linha fechada de QUALQUER lista. Uma constante só: quando a
    -- tipografia sobe, sobe em todas as listas juntas, e nenhuma fica com 26
    -- enquanto as outras estão em 30.
    NCN.ALTURA_LINHA = 28

    function NCN.ajustarNota(self, sheet, notaDoLivro, alturaAberta)
        local minha = tostring(sheet.nota or "")
        local livro = tostring(notaDoLivro or "")
        local propria = minha ~= "" and minha ~= livro
        local aberta = alturaAberta or 48
        NCN.altura(self.linhaNota, propria and (aberta - NCN.ALTURA_LINHA) or 0)
        -- `NCN.altura(self, ...)` e não `self.height = ...`: o form também é um
        -- controle, e escrever a propriedade direto faria a verificação 6 ler
        -- "height" como nome de widget inexistente.
        NCN.altura(self, propria and aberta or NCN.ALTURA_LINHA)
        -- A nota do livro continua a um clique: ela vive no popup do catálogo,
        -- que abre sempre, inclusive com a ficha finalizada.
        return propria
    end

    --- Linha de item com SEGUNDA LINHA SOB DEMANDA.
    --
    -- Perícia de ataque, alcance e traço são escolhas de COMPRA: mexe-se uma vez
    -- e nunca mais. Elas ocupavam metade da largura de toda arma, para sempre.
    -- Agora descem para uma linha que abre no botão.
    --
    -- `campo` é o que a segunda linha guarda: "nota" na arma e na armadura,
    -- "efeito" no equipamento e no programa. Sem esse parâmetro a lista de
    -- equipamento comparava `sheet.nota`, campo que ela não tem.
    --
    -- ⚠️ O CONTEÚDO DECIDE O PADRÃO; O BOTÃO DECIDE DEPOIS.
    --
    -- A v2.9.6 fazia `aberto = clicou OR temConteudo`. Com um `or` no meio, o
    -- conteúdo GANHAVA do clique: todo item com efeito próprio abria e o `···`
    -- não conseguia mais fechar. Eu tinha escrito isso de propósito — "esconder
    -- o que o jogador escreveu é pior" — e estava errado: virou a ficha decidindo
    -- por ele. Mostrar sem deixar esconder não é cuidado, é teimosia.
    --
    -- Agora são três estados, e a escolha do jogador vence sempre:
    --   `detalheModo` 1 = ele abriu · 2 = ele fechou · vazio = ainda não escolheu
    --
    -- Só no "ainda não escolheu" o conteúdo decide — assim nada nasce escondido
    -- e nada fica preso aberto.
    --
    -- É NÚMERO, não booleano, de propósito: o NDB só materializa campo
    -- PREENCHIDO, e não dá para provar por inspeção que um `false` gravado volta
    -- como `false` em vez de `nil`. Com `nil` voltando, "fechado" viraria "nunca
    -- escolheu" e a linha reabriria sozinha — o mesmo bug de novo, com outra
    -- roupa. Dois números distintos de zero sobrevivem à minha explicação estar
    -- errada.
    NCN.DETALHE_ABERTO, NCN.DETALHE_FECHADO = 1, 2

    function NCN.detalheEstaAberto(sheet, it, campo)
        local modo = NCN.num(sheet.detalheModo)
        if modo == NCN.DETALHE_ABERTO  then return true end
        if modo == NCN.DETALHE_FECHADO then return false end
        local qual = campo or "nota"
        local minha = tostring(sheet[qual] or "")
        local livro = tostring(it and it[qual] or "")
        return minha ~= "" and minha ~= livro
    end

    --- O clique inverte O QUE ESTÁ NA TELA, não o que está gravado.
    --  Inverter o campo gravado deixaria o primeiro clique sem efeito em toda
    --  linha aberta por conteúdo: o campo está vazio, viraria "aberto", e ela
    --  já estava aberta.
    function NCN.alternarDetalhe(self, sheet, it, alturaAberta, campo)
        sheet.detalheModo = NCN.detalheEstaAberto(sheet, it, campo)
                            and NCN.DETALHE_FECHADO or NCN.DETALHE_ABERTO
        NCN.ajustarLinhaItem(self, sheet, it, alturaAberta, campo)
    end

    function NCN.ajustarLinhaItem(self, sheet, it, alturaAberta, campo)
        local aberto = NCN.detalheEstaAberto(sheet, it, campo)
        local aberta = alturaAberta or 54

        NCN.altura(self.linhaNota, aberto and (aberta - NCN.ALTURA_LINHA) or 0)
        NCN.altura(self, aberto and aberta or NCN.ALTURA_LINHA)
        -- O botão não troca de PALAVRA, troca de COR. Trocar "detalhes" por
        -- "fechar" obrigava a coluna a caber a maior das duas palavras; o "···"
        -- cabe em 28 px sempre, e é a borda que diz se está aberto.
        NCN.pintar(self.txtDetalhe, aberto and NCN.COR.ciano or NCN.COR.apagado)
        NCN.contorno(self.btDetalhe, aberto and NCN.COR.ciano or NCN.COR_BOTAO_BORDA)
        NCN.dica(self.btDetalhe, aberto and "Fecha a segunda linha"
                 or "Perícia de ataque, alcance, traço e nota")
        NCN.pintarOcultacao(self, it)
        return aberto
    end

    --- LINHA DE CONTA — só quando há o que explicar.
    --
    -- A Terceira Lei deste projeto manda mostrar de onde veio o número. Mas
    -- imprimir "= MEN 12" embaixo de um 12 não explica nada: ocupa uma linha de
    -- cinza e treina o olho a ignorar a região onde as contas QUE IMPORTAM
    -- aparecem. Foi essa repetição que os jogadores chamaram de poluição.
    --
    -- A régua: a conta aparece quando o número tem MAIS DE UMA PARCELA ou um
    -- ajuste manual. "(REF 10 + COR 14) / 4" fica sempre, porque some duas
    -- fontes; "Vel 6 + 3" some, porque é a fórmula fixa do livro.
    function NCN.conta(texto, temParcela)
        if temParcela then return texto end
        return ""
    end

    --- Grava só se mudou. Evita disparar cascata de onChange à toa.
    function NCN.gravar(no, campo, valor)
        if no == nil then return end
        if no[campo] ~= valor then no[campo] = valor end
    end

    --- Altura de um texto que vai quebrar linha. Um label de 26px com texto
    --  longo corta com reticências; estimar as linhas resolve.
    function NCN.alturaDeTexto(texto, base, charsPorLinha, maxLinhas)
        local n = R.contarCaracteres(texto)
        local linhas = math.ceil(n / math.max(1, charsPorLinha or 60))
        if linhas < 1 then linhas = 1 end
        if maxLinhas and linhas > maxLinhas then linhas = maxLinhas end
        return (base or 18) + (linhas - 1) * 14
    end

    --- Barra de preenchimento. `trilho` é o retângulo de fundo (largura
    --  conhecida), `barra` é o que cresce dentro dele.
    function NCN.barra(barra, atual, maximo, larguraTrilho, cor)
        if barra == nil then return end
        local a, m = NCN.num(atual), NCN.num(maximo)
        local frac = 0
        if m > 0 then frac = a / m end
        if frac < 0 then frac = 0 end
        if frac > 1 then frac = 1 end
        local w = math.floor((larguraTrilho or 100) * frac)
        -- largura 0 some da tela; 1px mantém a barra visível quando zera
        if w < 1 and frac > 0 then w = 1 end
        NCN.largura(barra, w)
        if cor ~= nil then NCN.fundo(barra, cor) end
    end

    -- =======================================================================
    -- LARGURA EM TEMPO DE EXECUÇÃO
    -- Ler .width antes do primeiro desenho devolve 0 ou um valor minúsculo.
    -- Dividir esse número entre os cards faz todos nascerem espremidos — e só
    -- se ajustarem quando algo força um recálculo. Medimos em várias fontes,
    -- em ordem, e ignoramos valores pequenos demais para serem verdade.
    -- =======================================================================

    NCN.LARGURA_FALLBACK = 1240
    NCN.LARGURA_MINIMA_CRIVEL = 320

    function NCN.larguraDisponivel(self, nomes, desconto, fallback)
        local disp = 0
        for _, nome in ipairs(nomes or {}) do
            if disp <= 0 then
                local c = self[nome]
                if c ~= nil then
                    pcall(function()
                        local v = c.width
                        if type(v) == "number" and v > NCN.LARGURA_MINIMA_CRIVEL then
                            disp = v
                        end
                    end)
                end
            end
        end
        if disp <= 0 then disp = fallback or NCN.LARGURA_FALLBACK end
        disp = disp - (desconto or 0)
        if disp < 200 then disp = 200 end
        return disp
    end

    --- Altura disponível, pelo mesmo critério da largura.
    function NCN.alturaDisponivel(self, nomes, desconto, fallback)
        local disp = 0
        for _, nome in ipairs(nomes or {}) do
            if disp <= 0 then
                local c = self[nome]
                if c ~= nil then
                    pcall(function()
                        local v = c.height
                        if type(v) == "number" and v > 120 then disp = v end
                    end)
                end
            end
        end
        if disp <= 0 then disp = fallback or 700 end
        disp = disp - (desconto or 0)
        if disp < 240 then disp = 240 end
        return disp
    end

    --- Distribui uma fileira de cards. Piso BAIXO de propósito: um mínimo alto
    --  empurra o último card para fora da tela em janela estreita.
    function NCN.distribuirCards(self, prefixo, ids, total, folga, minimo)
        local n = #ids
        if n == 0 then return end
        local livre = total - (folga or 6) * n
        local w = math.floor(livre / n)
        if w < (minimo or 88) then w = (minimo or 88) end
        for _, id in ipairs(ids) do
            NCN.largura(self[prefixo .. id], w)
        end
        return w
    end

    -- =======================================================================
    -- LEITURA DE LISTAS (NDB)
    -- =======================================================================

    function NCN.filhos(no, campo)
        if no == nil then return {} end
        local lista = no[campo]
        if lista == nil then return {} end
        local filhos = NDB.getChildNodes(lista)
        return filhos or {}
    end

    function NCN.somar(no, campo, subcampo, filtro)
        local total = 0
        for _, f in ipairs(NCN.filhos(no, campo)) do
            if filtro == nil or filtro(f) then
                total = total + NCN.num(f[subcampo])
            end
        end
        return total
    end

    function NCN.contar(no, campo, filtro)
        local n = 0
        for _, f in ipairs(NCN.filhos(no, campo)) do
            if filtro == nil or filtro(f) then n = n + 1 end
        end
        return n
    end

    -- =======================================================================
    -- EFEITOS AUTOMÁTICOS DO CATÁLOGO
    --
    -- Só entra aqui o que o livro diz que é NUMÉRICO, PERMANENTE e
    -- INCONDICIONAL. Efeito condicional ("sempre que", "ao atacar",
    -- "bônus em X" sem valor) fica como texto: automatizar o condicional é
    -- exatamente como se inventa uma regra que o livro não tem.
    --
    -- O vínculo com o catálogo é o campo `catId`, gravado na hora de
    -- adicionar e nunca editado — assim renomear o item na ficha não faz o
    -- efeito sumir.
    -- =======================================================================

    -- =======================================================================
    -- O SINAL DO CUSTO DE HUMANIDADE
    --
    -- O livro imprime o custo como NEGATIVO (0, -1, -2, -3) e a conta é
    -- `Humanidade = 10 + soma`. Mas a v1 da ficha calculava `10 - custo`, o
    -- que fazia a mesa digitar o número POSITIVO. Herdar esse valor sem
    -- inverter fez a Humanidade SUBIR a cada implante instalado — quatro
    -- implantes levaram uma ficha a 17 de 10.
    --
    -- Em vez de confiar no sinal que está gravado, a ficha lê sempre a
    -- magnitude: instalar cyberware só desce. Quem digitar "3" na linha vê o
    -- campo se corrigir para "-3" no recálculo seguinte, e a conta bate dos
    -- dois jeitos.
    -- =======================================================================

    function NCN.custoHumanidade(no)
        if no == nil then return 0 end
        return -math.abs(NCN.num(no.humanidade))
    end

    --- Soma dos custos dos implantes instalados, já normalizada. Também
    --  conserta o sinal gravado, para a linha mostrar o que o livro mostra.
    function NCN.somaHumanidade(sheet)
        local total = 0
        for _, no in ipairs(NCN.filhos(sheet, NCN.LISTAS.cyberware)) do
            local v = NCN.custoHumanidade(no)
            if no.humanidade ~= nil and NCN.num(no.humanidade) ~= v then
                no.humanidade = v
            end
            if no.instalado ~= false then total = total + v end
        end
        return total
    end

    function NCN.efeitosZerados()
        return {
            pericia = {}, atributo = {},
            rdNatural = 0, iniciativa = 0, pv = 0, humanidade = 0, bonusDano = 0,
            interfaceDeCombate = false, autoEstabiliza = false,
            imuneEnvenenado = false, maoFirme = false,
            dobraCuraNatural = false, metadeEddiesIniciais = false,
            armasEmbutidas = {},
            fontes = {},
        }
    end

    function NCN.aplicarMecanico(ef, mec, origem)
        if type(mec) ~= "table" then return end
        if type(mec.pericia) == "table" then
            for campo, v in pairs(mec.pericia) do
                ef.pericia[campo] = (ef.pericia[campo] or 0) + v
                ef.fontes[#ef.fontes+1] = string.format("%s: %s em %s",
                    origem, R.comSinal(v), campo)
            end
        end
        if type(mec.bonusAtributo) == "table" then
            for chave, v in pairs(mec.bonusAtributo) do
                ef.atributo[chave] = (ef.atributo[chave] or 0) + v
                ef.fontes[#ef.fontes+1] = string.format("%s: %s em %s",
                    origem, R.comSinal(v), string.upper(chave))
            end
        end
        if mec.rdNatural  then ef.rdNatural  = ef.rdNatural  + mec.rdNatural  end
        -- Bonus de Dano corpo a corpo vindo de implante (Cap. 6 da v3.0):
        -- Braco de Combate, Borgware Militar, Glandula de Adrenalina.
        -- Soma ao bonus da COR, nao substitui.
        if mec.bonusDano  then
            ef.bonusDano = ef.bonusDano + mec.bonusDano
            ef.fontes[#ef.fontes+1] = string.format("%s: %s no dano c.c.",
                origem, R.comSinal(mec.bonusDano))
        end
        if mec.iniciativa then ef.iniciativa = ef.iniciativa + mec.iniciativa end
        if mec.pv         then ef.pv         = ef.pv         + mec.pv         end
        if mec.humanidade then ef.humanidade = ef.humanidade + mec.humanidade end
        -- ARMA EMBUTIDA (Lâmina Retrátil, Garras Retráteis — Cap. 6).
        -- Isto ficou DECLARADO NO CATÁLOGO E NUNCA APLICADO até a v2.8: o
        -- popup do item dizia "Automático: sim — a ficha aplica sozinha" e a
        -- arma não aparecia em lugar nenhum. Mesmo formato do bug do
        -- Cyberdeck: visível na tela, alimentando nada.
        if type(mec.armaEmbutida) == "table" then
            ef.armasEmbutidas[#ef.armasEmbutidas+1] = {
                nome  = mec.armaEmbutida.nome,
                dano  = mec.armaEmbutida.dano,
                tipo  = mec.armaEmbutida.tipo or "corpoArmado",
                origem = origem,
            }
            ef.fontes[#ef.fontes+1] = string.format("%s: arma embutida %s (%s)",
                origem, mec.armaEmbutida.nome, mec.armaEmbutida.dano)
        end
        if mec.interfaceDeCombate   then ef.interfaceDeCombate = true end
        if mec.autoEstabiliza       then ef.autoEstabiliza = true end
        if mec.imuneEnvenenado      then ef.imuneEnvenenado = true end
        if mec.maoFirme             then ef.maoFirme = true end
        if mec.dobraCuraNatural     then ef.dobraCuraNatural = true end
        if mec.metadeEddiesIniciais then ef.metadeEddiesIniciais = true end
    end

    function NCN.coletarEfeitos(sheet)
        local ef = NCN.efeitosZerados()

        -- Sempre por NCN.LISTAS, nunca pelo nome cru: três listas mantêm o
        -- nome da v1 e escrever "armaduras" aqui faz a penalidade de
        -- Furtividade da blindagem simplesmente não acontecer, sem erro.
        for _, no in ipairs(NCN.filhos(sheet, NCN.LISTAS.cyberware)) do
            if no.instalado ~= false then
                local it = CY.porNome(no.catId or no.nome)
                if it then NCN.aplicarMecanico(ef, it.mecanico, it.nome) end
            end
        end

        -- Armadura EQUIPADA: as penalidades de Furtividade/Atletismo do Cap. 9
        -- só valem quando ela está vestida.
        for _, no in ipairs(NCN.filhos(sheet, NCN.LISTAS.armaduras)) do
            if no.equipada == true then
                local it = EQ.armaduraPorNome(no.catId or no.nome)
                if it then NCN.aplicarMecanico(ef, it.mecanico, it.nome) end
            end
        end

        for _, no in ipairs(NCN.filhos(sheet, NCN.LISTAS.vantagens)) do
            local it = TR.vantagemPorNome(no.catId or no.nome)
            if it then NCN.aplicarMecanico(ef, it.mecanico, it.nome) end
        end

        for _, no in ipairs(NCN.filhos(sheet, NCN.LISTAS.desvantagens)) do
            local it = TR.desvantagemPorNome(no.catId or no.nome)
            if it then NCN.aplicarMecanico(ef, it.mecanico, it.nome) end
        end

        return ef
    end

    -- =======================================================================
    -- CONTROLES DESENHADOS
    --
    -- `edit`, `comboBox` e `textEditor` têm a propriedade `transparent`: dá
    -- para apagar a moldura branca do sistema e desenhar a caixa por baixo,
    -- com a cor da ficha. `button` e `checkBox` NÃO têm — herdam só
    -- propriedades de fonte. Para tirar o cinza deles não há atalho: viram
    -- retângulo com rótulo e onClick, a mesma técnica que a barra de abas.
    --
    -- Como um retângulo não tem `enabled` visual, quem "desabilita" é a
    -- própria ação: ela confere a condição e recusa. O botão só fica pálido.
    -- =======================================================================

    NCN.COR_BOTAO      = "#141A26"
    NCN.COR_BOTAO_BORDA= "#2A3145"
    NCN.COR_CHIP_OFF   = "#080A0F"

    --- Um chip ligado/desligado. Muito mais legível que o quadradinho do
    --  sistema: o estado é a cor do bloco inteiro, não um risco de 8 pixels.
    function NCN.pintarChip(self, sheet, campo, cor)
        local ligado = sheet[campo] == true
        NCN.fundo(self["chipChk" .. campo],  ligado and cor or NCN.COR_CHIP_OFF)
        NCN.contorno(self["chipChk" .. campo], ligado and cor or NCN.COR_BOTAO_BORDA)
        NCN.pintar(self["txtChk" .. campo],  ligado and "#05060A" or NCN.COR.apagado)
    end

    --- O mesmo chip, mas numa LINHA de lista: ali o `sheet` é o nó do item,
    --  não a ficha. Precisa de nome próprio porque a exclusividade (só uma
    --  arma equipada) apaga o chip do irmão, e o irmão tem de se repintar.
    --  A barra da borda esquerda (`barra_<campo>`) é opcional e é pintada aqui
    --  de propósito: "equipada" é o estado mais importante da linha — é ele que
    --  alimenta a aba COMBATE — e um chip de 44 px no meio de outros seis
    --  retângulos iguais não se vê de longe. Pintar as duas coisas no mesmo
    --  lugar impede o caso em que o chip acende e a barra fica apagada.
    function NCN.chipItem(self, sheet, campo, cor)
        local ligado = sheet[campo] == true
        NCN.fundo(self["chip_" .. campo],   ligado and cor or NCN.COR_CHIP_OFF)
        NCN.contorno(self["chip_" .. campo], ligado and cor or NCN.COR_BOTAO_BORDA)
        NCN.pintar(self["txt_" .. campo],   ligado and "#05060A" or NCN.COR.apagado)
        NCN.fundo(self["barra_" .. campo],  ligado and cor or "#080A0F")
    end

    function NCN.alternar(self, sheet, campo, cor)
        sheet[campo] = not (sheet[campo] == true)
        NCN.pintarChip(self, sheet, campo, cor)
        NCN.recalcular(sheet, self)
    end

    -- Todo chip da ficha, com a cor que ele ganha quando ligado.
    NCN.CHIPS = {
        { campo="cenaFurtivo",      cor="#3DD68C" },
        { campo="cenaAlvoCaido",    cor="#FFB03A" },
        { campo="cenaEuCaido",      cor="#FF3B7F" },
        { campo="cenaSupressao",    cor="#FF3B7F" },
        { campo="cenaRajada",       cor="#FFB03A" },
        { campo="cenaDeVeiculo",    cor="#23E5D3" },
        { campo="cenaNoMotorista",  cor="#23E5D3" },
        { campo="cenaEmboscada",    cor="#3DD68C" },
        { campo="rolarDireto",      cor="#8A63C9" },
        { campo="cond_sangramento", cor="#FF3B7F" },
        { campo="cond_envenenado",  cor="#3DD68C" },
        { campo="cond_emChamas",    cor="#FFB03A" },
        { campo="cond_amedrontado", cor="#8A63C9" },
        { campo="cond_cego",        cor="#8B90A6" },
        { campo="cond_atordoado",   cor="#FF3B7F" },
        { campo="cond_exausto",     cor="#FFB03A" },
        { campo="cond_imobilizado", cor="#8B90A6" },
        { campo="cond_cyberpsicose",cor="#FF3B7F" },
    }

    function NCN.pintarChips(self, sheet)
        for _, c in ipairs(NCN.CHIPS) do
            NCN.pintarChip(self, sheet, c.campo, c.cor)
        end
    end

    --- Pinta um botão desenhado. `ativo=false` deixa pálido, para dizer que
    --  clicar ali não vai adiantar — e a ação diz por quê quando clicada.
    function NCN.pintarBotao(self, acao, ativo, cor)
        NCN.fundo(self["btBt" .. acao], ativo and NCN.COR_BOTAO or "#0C1018")
        NCN.contorno(self["btBt" .. acao], ativo and (cor or NCN.COR_BOTAO_BORDA) or "#1A1F2B")
        NCN.pintar(self["txtBt" .. acao], ativo and (cor or NCN.COR.texto) or NCN.COR.fraco)
    end

    -- =======================================================================
    -- ROLAGENS — Cap. 15
    --
    -- A mesa já tem as macros /a e /d instaladas (o próprio livro manda
    -- instalá-las no Cap. 15). A ficha NÃO rola por conta própria: ela monta
    -- o comando e manda pro chat, para que a rolagem saia exatamente igual à
    -- de quem digita na mão — mesmo veredito, mesma cor, mesmo formato.
    --
    -- Formato, conforme os exemplos impressos:
    --   /a <valor-alvo> [modificador] [rótulo]     ex.: /a 12 Katana
    --   /d <dado> <RD do alvo> [perfurante] [rótulo]
    --                                              ex.: /d 3d6+2 6 perfurante Fuzil de Precisão
    --
    -- O modificador NÃO é enviado: a ficha já o embutiu no Valor-Alvo, e a
    -- conta de onde ele veio vai no rótulo. Mandar "0" faria a macro imprimir
    -- um modificador que não existe.
    -- =======================================================================

    -- ACENTO NÃO ATRAVESSA A LINHA DE COMANDO DO CHAT.
    --
    -- O bug: "/a 11 Combate à Distância (Fogo)" saiu na mesa assim —
    --     [Â§K11]â¬â¬â¬â¬  âœ" TESTE ...   ðŸŽ¯ Combate Ã DistÃ¢ncia
    -- Mojibake na MENSAGEM INTEIRA, e as tags de cor impressas literalmente.
    --
    -- A causa: um único trecho de bytes inválidos envenena a mensagem toda. O
    -- chat desiste de ler aquilo como UTF-8 e reinterpreta TUDO como Latin-1,
    -- então os literais da própria macro (— ▬ ✔ 🎯) viram mojibake junto, e o
    -- `§` das tags vira `Â§` — que o parser de cor não reconhece mais.
    --
    -- A prova está no próprio print: Atletismo, Furtividade, Manha e Etiqueta
    -- Corporativa saíram perfeitos. São os quatro rótulos SEM acento. Doze
    -- perícias do sistema têm — e toda arma com "ã" ou "é" também teria.
    --
    -- A saída: o rótulo viaja em ASCII puro (`~C3` para cada byte alto) e a
    -- macro remonta os bytes do outro lado. Se o modelo estiver errado, a falha
    -- é visível e inofensiva — aparece "~C3" na tela em vez de corromper.
    function NCN.paraChat(texto)
        local t = tostring(texto or ""):gsub("[\r\n]", " ")
        return (t:gsub("[\128-\255]", function(c)
            return string.format("~%02X", string.byte(c))
        end))
    end

    function NCN.comandoTeste(alvo, rotulo)
        return string.format("/a %d %s", math.floor(NCN.num(alvo)),
                             NCN.paraChat(rotulo))
    end

    function NCN.comandoDano(dado, rd, perfurante, rotulo)
        return string.format("/d %s %d %s%s", tostring(dado or "1d6"),
            math.floor(NCN.num(rd)), perfurante and "perfurante " or "",
            NCN.paraChat(rotulo))
    end

    function NCN.mesaDe(sheet)
        local ok, mesa = pcall(function() return Firecast.getRoomOf(sheet) end)
        if ok then return mesa end
        return nil
    end

    function NCN.chatDe(sheet)
        local mesa = NCN.mesaDe(sheet)
        if mesa == nil then return nil end
        local ok, chat = pcall(function() return mesa.activeChat or mesa.chat end)
        if ok then return chat end
        return nil
    end

    --- Manda um texto para o chat como se tivesse sido digitado — é assim que
    --  as macros da mesa são acionadas.
    function NCN.enviar(sheet, texto)
        local chat = NCN.chatDe(sheet)
        if chat == nil then return false end
        local ok = pcall(function() chat:enviarMensagem(texto) end)
        return ok
    end

    --- Rolagem crua, sem macro. Só entra em cena quando o jogador marca
    --  "rolar sem a macro" — por exemplo numa mesa onde ela não foi instalada.
    --  Nada de TaleMark aqui: `escrever` não interpreta as marcações e elas
    --  saíam literais no chat, no meio da frase.
    function NCN.rolarCru(sheet, alvo, rotulo)
        local chat = NCN.chatDe(sheet)
        if chat == nil then return end
        pcall(function()
            chat:rolarDados("3d6", string.format("%s — %s · Alvo %d",
                sheet.nome or "Personagem", rotulo or "Teste", NCN.num(alvo)),
                function(rol)
                    local v = nil
                    pcall(function() v = rol.resultado end)
                    if v == nil then return end
                    local _, texto, margem = R.interpretarTeste(v, NCN.num(alvo))
                    pcall(function()
                        chat:escrever(string.format("%s — rolou %d contra %d · margem %d",
                            texto, v, NCN.num(alvo), margem))
                    end)
                end)
        end)
    end

    function NCN.rolarTeste(sheet, alvo, rotulo, detalhe)
        local nome = rotulo or "Teste"
        if detalhe ~= nil and detalhe ~= "" then nome = nome .. " [" .. detalhe .. "]" end
        if sheet.rolarDireto == true then
            NCN.rolarCru(sheet, alvo, nome)
        else
            NCN.enviar(sheet, NCN.comandoTeste(alvo, nome))
        end
    end

    --- /d com a RD já resolvida.
    --  Atenção ao caso composto: quando o tiro é na cabeça, a RD é dividida
    --  duas vezes (Cap. 4), e isso a macro não sabe fazer. Nesse caso mandamos
    --  a RD JÁ COMPOSTA e não passamos "perfurante" — senão a macro dividiria
    --  de novo e o dano sairia alto demais.
    function NCN.rolarDano(sheet, dadoDano, rdAlvo, perfurante, naCabeca, rotulo)
        local rd = NCN.num(rdAlvo)
        if naCabeca then
            NCN.enviar(sheet, NCN.comandoDano(dadoDano,
                R.rdEfetiva(rd, perfurante, true), false,
                -- O rótulo NÃO pode conter a palavra "perfurante": uma macro
                -- que a procure em qualquer posição dividiria a RD outra vez.
                (rotulo or "") .. (perfurante and " (na cabeca, RD ja composta)"
                                              or " (na cabeca, RD ja composta)")))
        else
            NCN.enviar(sheet, NCN.comandoDano(dadoDano, rd, perfurante, rotulo))
        end
    end

    -- =======================================================================
    -- BARRINHAS DE STATUS DO JOGADOR
    --
    -- O Firecast dá a cada jogador QUATRO barras e DUAS linhas de texto ao
    -- lado do nome, e elas NAO dependem de token no grid. A API é do objeto
    -- Jogador (SDK3):
    --
    --     jogador:requestSetBarValue(indice, atual, maximo)   -- indice 1..4
    --     jogador:getBarValue(indice)      -> atual, maximo, porcentagem
    --     jogador:requestSetEditableLine(indice, texto)       -- indice 1..2
    --
    -- DUAS COISAS QUE A DOCUMENTAÇÃO AVISA E VALEM OURO AQUI:
    --
    -- 1) A escrita é uma REQUISIÇÃO ao servidor, enfileirada e assíncrona. Não
    --    devolve sucesso nem erro. Mandar a cada recálculo entope a fila por
    --    nada — por isso só sai o que MUDOU desde a última vez.
    --
    -- 2) Só funciona se o dono da mesa for Gold Plus (ou o plugin pertencer a
    --    assinante). Quando não funciona, não há erro: simplesmente não
    --    acontece. Então a ficha nunca depende disso para calcular — as barras
    --    são espelho, nunca fonte.
    -- =======================================================================

    NCN.BARRAS = {
        { i = 1, atual = "pvAtual",    maximo = "pv",         nome = "PV" },
        { i = 2, atual = "focoAtual",  maximo = "focoNeural", nome = "Foco" },
        { i = 3, atual = "humanidade", maximo = "humanidadeMax", nome = "Humanidade" },
        -- humanidadeMax e netAlertaMax nao vinham de lugar nenhum: sao
        -- gravados em calcularDerivados so para as barras terem denominador
        { i = 4, atual = "netAlerta",  maximo = "netAlertaMax", nome = "Alerta" },
    }

    NCN.__barras = {}      -- último valor enviado, por ficha, para não repetir

    function NCN.chaveDaFicha(sheet)
        local id
        pcall(function() id = NDB.getRoot(sheet).id end)
        return id or tostring(sheet.nome or "ficha")
    end

    function NCN.jogadorDaFicha(sheet)
        local mesa = NCN.mesaDe(sheet)
        if mesa == nil then return nil end
        local j
        -- o dono do personagem é quem tem as barras; o mestre vendo a ficha
        -- alheia não deve sobrescrever as barras dele
        pcall(function() j = Firecast.getCharacterOf(sheet).dono end)
        if j == nil then pcall(function() j = mesa.meuJogador end) end
        return j
    end

    --- Espelha PV, Foco, Humanidade e Alerta nas barrinhas do jogador.
    --  Só manda o que mudou. Devolve quantas requisições saíram.
    function NCN.sincronizarBarras(sheet)
        if sheet == nil or sheet.barrasLigadas == false then return 0 end
        local jog = NCN.jogadorDaFicha(sheet)
        if jog == nil then return 0 end

        local chave = NCN.chaveDaFicha(sheet)
        local anterior = NCN.__barras[chave]
        if anterior == nil then anterior = {}; NCN.__barras[chave] = anterior end

        local enviados = 0
        for _, b in ipairs(NCN.BARRAS) do
            local atual  = math.floor(NCN.num(sheet[b.atual]))
            local maximo = math.floor(NCN.num(sheet[b.maximo]))
            if maximo > 0 then
                local marca = atual .. "/" .. maximo
                if anterior["b" .. b.i] ~= marca then
                    anterior["b" .. b.i] = marca
                    pcall(function() jog:requestSetBarValue(b.i, atual, maximo) end)
                    enviados = enviados + 1
                end
            end
        end

        for i, texto in ipairs(NCN.linhasDoJogador(sheet)) do
            if anterior["L" .. i] ~= texto then
                anterior["L" .. i] = texto
                pcall(function() jog:requestSetEditableLine(i, texto) end)
                enviados = enviados + 1
            end
        end
        return enviados
    end

    --- O que dizer embaixo do botão. A escrita nas barras é assíncrona e não
    --  devolve erro: quando o dono da mesa não é Gold Plus, ela simplesmente
    --  não acontece. Então a ficha diz o que TENTOU, e o jogador confere na
    --  tela se apareceu — é mais honesto que fingir confirmação.
    function NCN.estadoDasBarras(sheet, enviados)
        if sheet.barrasLigadas == false then
            return "desligado — as barrinhas do seu jogador não são atualizadas"
        end
        if NCN.jogadorDaFicha(sheet) == nil then
            return "ligado, mas a ficha não achou o jogador dono — abra pela mesa"
        end
        local base = "ligado · PV, Foco, Humanidade e Alerta nas barras 1 a 4"
        if (enviados or 0) > 0 then base = base .. "  (" .. enviados .. " atualizadas agora)" end
        -- `getIsGoldPlus()` existe no objeto Jogador — confirmado pelo despejo
        -- do /sniff jogador, não deduzido. Antes desta linha a ficha dizia
        -- "exige mesa Gold Plus" como aviso genérico; agora ela SABE, e quem
        -- é Gold Plus para de ler um aviso que não vale para ele.
        local gold
        pcall(function() gold = NCN.jogadorDaFicha(sheet):getIsGoldPlus() end)
        if gold == false then
            return base .. " · **sua conta não é Gold Plus** — o Firecast aceita "
                .. "a ficha calcular, mas não escreve nas barras"
        end
        if gold == nil then return base .. " · exige conta Gold Plus" end
        return base .. " · conta Gold Plus confirmada"
    end

    --- As duas linhas de texto ao lado do nome: identidade e estado de combate.
    function NCN.linhasDoJogador(sheet)
        local ident = tostring(sheet.nome or "Sem nome")
        if (sheet.profissao or "") ~= "" then ident = ident .. " · " .. sheet.profissao end
        if (sheet.afiliacao or "") ~= "" then ident = ident .. " · " .. sheet.afiliacao end

        local partes = {}
        partes[#partes+1] = "Esq " .. math.floor(NCN.num(sheet.esquiva))
        partes[#partes+1] = "RD " .. tostring(NCN.rdEquipada(sheet))
        partes[#partes+1] = "Dano " .. R.comSinal(NCN.num(sheet.bonusDano))
        if NCN.num(sheet.pvAtual) * 2 <= NCN.num(sheet.pv) and NCN.num(sheet.pv) > 0 then
            partes[#partes+1] = "FERIDO"
        end
        if NCN.num(sheet.humanidade) <= 5 then partes[#partes+1] = "HUM BAIXA" end
        return { ident, table.concat(partes, " · ") }
    end

    --- Dado de dano da arma com o Bonus de Dano ja somado.
    --  As tabelas do Cap. 9 imprimem "1d6+COR" / "2d6+COR"; "+COR" e o Bonus
    --  de Dano do Cap. 2 (-3 a +3), NAO o valor do atributo. Sem esta funcao
    --  a ficha mandava "/d 2d6+COR 4 Katana" e a macro nao sabia ler "COR".
    --  `sheet.bonusDano` ja vem com o bonus de cyberware somado (Cap. 6).
    function NCN.danoDaArma(sheet, arma)
        local d = tostring((arma and arma.dano) or "1d6")
        return R.dadoComBonus(d, NCN.num(sheet.bonusDano))
    end

    --- Tabela rolada (Flatline, Choque). Manda o dado pelo chat e escreve o
    --  resultado em texto puro logo abaixo.
    function NCN.rolarTabela(sheet, dado, titulo, resolver)
        local chat = NCN.chatDe(sheet)
        if chat == nil then return end
        pcall(function()
            chat:rolarDados(dado, string.format("%s — %s", sheet.nome or "Personagem", titulo),
                function(rol)
                    local v = nil
                    pcall(function() v = rol.resultado end)
                    if v == nil then return end
                    local linha = resolver(v)
                    if linha == nil then return end
                    pcall(function()
                        chat:escrever(string.format("%s: %s",
                            linha.nome or linha.faixa, linha.efeito or linha.texto))
                    end)
                end)
        end)
    end

    function NCN.rolarSimples(sheet, dado, texto)
        local chat = NCN.chatDe(sheet)
        if chat == nil then return end
        pcall(function() chat:rolarDados(dado, texto) end)
    end

    -- =======================================================================
    -- NOMES DAS LISTAS
    --
    -- Três listas mantêm o nome que tinham na v1 (`armasEquipamento`,
    -- `armadurasEquipamento`, `itensUtilitarios`). Renomeá-las teria deixado
    -- invisível tudo que a mesa já havia cadastrado — e uma lista que some é
    -- indistinguível de dado perdido para quem está do outro lado da tela.
    -- =======================================================================

    NCN.LISTAS = {
        cyberware    = "cyberware",
        armas        = "armasEquipamento",
        armaduras    = "armadurasEquipamento",
        itens        = "itensUtilitarios",
        vantagens    = "vantagens",
        desvantagens = "desvantagens",
        programas    = "programas",
        veiculos     = "veiculos",
        xp           = "xpLog",
    }

    -- =======================================================================
    -- ATRIBUTOS
    -- "Faixa normal: 7 a 16" e "Piso de 7 — sem exceções. Atributos nunca vão
    --  abaixo de 7 POR COMPRA DE PONTOS." (Cap. 2)
    -- O piso vale para o valor COMPRADO. O campo de bônus não tem teto: é por
    -- ele que cyberware e vantagem passam do 16, e é a válvula de escape do
    -- mestre quando o livro não previu o caso.
    -- =======================================================================

    function NCN.atributoBase(sheet, chave)
        local v = NCN.num(sheet[chave], R.ATRIBUTO_BASE)
        if v < R.ATRIBUTO_MIN then v = R.ATRIBUTO_MIN end
        if v > R.ATRIBUTO_MAX then v = R.ATRIBUTO_MAX end
        return v
    end

    function NCN.atributoTotal(sheet, chave, ef)
        local bonusManual = NCN.num(sheet["bonus" .. NCN.SUFIXO_ATRIBUTO[chave]])
        local bonusAuto   = (ef and ef.atributo[chave]) or 0
        return NCN.atributoBase(sheet, chave) + bonusManual + bonusAuto
    end

    function NCN.calcularAtributos(sheet, ef)
        local total = 0
        for _, a in ipairs(R.ATRIBUTOS) do
            local base = NCN.atributoBase(sheet, a.chave)
            NCN.gravar(sheet, a.chave, base)
            local custo = R.custoAtributo(base, a.custoPorPonto)
            NCN.gravar(sheet, "custo" .. NCN.SUFIXO_ATRIBUTO[a.chave], custo)
            NCN.gravar(sheet, "total" .. NCN.SUFIXO_ATRIBUTO[a.chave],
                       NCN.atributoTotal(sheet, a.chave, ef))
            total = total + custo
        end
        NCN.gravar(sheet, "custoAtributosTotal", total)
        return total
    end

    -- =======================================================================
    -- DERIVADOS — Cap. 2
    -- =======================================================================

    function NCN.calcularDerivados(sheet, ef)
        local cor = NCN.atributoTotal(sheet, "cor", ef)
        local ref = NCN.atributoTotal(sheet, "ref", ef)
        local men = NCN.atributoTotal(sheet, "men", ef)

        local ajPv = NCN.num(sheet.ajustePv) + ef.pv
        local pv = R.pontosDeVida(cor, ajPv)
        if pv < 1 then pv = 1 end
        NCN.gravar(sheet, "pv", pv)
        NCN.gravar(sheet, "pvConta", NCN.conta(string.format("COR %d x 2%s", cor,
            ajPv ~= 0 and (" " .. R.comSinal(ajPv)) or ""), ajPv ~= 0))

        NCN.gravar(sheet, "percepcao", R.percepcao(men, NCN.num(sheet.ajustePercepcao)))
        NCN.gravar(sheet, "percepcaoConta", NCN.conta("= MEN " .. men .. " " ..
            R.comSinal(NCN.num(sheet.ajustePercepcao)), NCN.num(sheet.ajustePercepcao) ~= 0))

        local vel = R.velocidadeBasica(ref, cor, NCN.num(sheet.ajusteVel))
        NCN.gravar(sheet, "velBasica", vel)
        NCN.gravar(sheet, "velConta", string.format("(REF %d + COR %d) / 4", ref, cor))

        local esq = R.esquiva(vel, NCN.num(sheet.ajusteEsquiva))
        NCN.gravar(sheet, "esquiva", esq)
        -- Esquiva = Vel + 3 é fórmula fixa do Cap. 4: só aparece com ajuste.
        NCN.gravar(sheet, "esquivaConta", NCN.conta(string.format("Vel %d + 3 %s", vel,
            R.comSinal(NCN.num(sheet.ajusteEsquiva))), NCN.num(sheet.ajusteEsquiva) ~= 0))

        -- "+1 na Velocidade Básica (SÓ INICIATIVA)" — Reflexos Rápidos e
        -- Acelerador de Reflexos. Por isso a iniciativa é um número separado:
        -- somar na Velocidade Básica mudaria também Esquiva e deslocamento.
        local ini = vel + ef.iniciativa + NCN.num(sheet.ajusteIniciativa)
        NCN.gravar(sheet, "iniciativa", ini)
        NCN.gravar(sheet, "iniciativaConta", NCN.conta(
            string.format("Vel %d %s so iniciativa", vel, R.comSinal(ef.iniciativa)),
            ef.iniciativa ~= 0 or NCN.num(sheet.ajusteIniciativa) ~= 0))

        local foco = R.focoNeural(men, NCN.num(sheet.ajusteFoco))
        NCN.gravar(sheet, "focoNeural", foco)
        NCN.gravar(sheet, "focoConta", NCN.conta(string.format("MEN %d x 2 %s", men,
            R.comSinal(NCN.num(sheet.ajusteFoco))), NCN.num(sheet.ajusteFoco) ~= 0))

        local somaCyber = NCN.somaHumanidade(sheet)
        NCN.gravar(sheet, "somaCyberware", somaCyber)
        local hum = R.humanidade(somaCyber, NCN.num(sheet.ajusteHumanidade) + ef.humanidade)
        NCN.gravar(sheet, "humanidade", hum)
        -- Aqui a conta FICA quase sempre: o número só é 10 em ficha sem metal,
        -- e a Humanidade é o valor que mais gera pergunta em mesa.
        NCN.gravar(sheet, "humanidadeConta", NCN.conta(string.format("10 %s cyberware%s",
            R.comSinal(somaCyber),
            ef.humanidade ~= 0 and (" " .. R.comSinal(ef.humanidade) .. " traco") or ""),
            somaCyber ~= 0 or ef.humanidade ~= 0 or NCN.num(sheet.ajusteHumanidade) ~= 0))

        local estado, aviso = R.estadoHumanidade(hum)
        NCN.gravar(sheet, "humanidadeEstado", estado)
        NCN.gravar(sheet, "humanidadeAviso", aviso)

        -- BONUS DE DANO CORPO A CORPO — Cap. 2 do livro v3.0.
        -- "+COR" das tabelas de arma significa "+ este bonus", nunca o valor
        -- do atributo. Sem isto a ficha mandava "/d 2d6+COR 4 Katana" para o
        -- chat e a macro nao tinha como interpretar "COR".
        local bd = R.bonusDano(cor) + ef.bonusDano + NCN.num(sheet.ajusteBonusDano)
        NCN.gravar(sheet, "bonusDano", bd)
        NCN.gravar(sheet, "bonusDanoConta", string.format("COR %d%s%s", cor,
            ef.bonusDano ~= 0 and (" " .. R.comSinal(ef.bonusDano) .. " cyberware") or "",
            NCN.num(sheet.ajusteBonusDano) ~= 0
                and (" " .. R.comSinal(NCN.num(sheet.ajusteBonusDano)) .. " ajuste") or ""))

        -- Denominadores das barrinhas do jogador. Existem so para isso: a
        -- barra precisa de um maximo, e Humanidade e Alerta nao tinham campo.
        NCN.gravar(sheet, "humanidadeMax", R.HUMANIDADE_BASE)
        NCN.gravar(sheet, "netAlertaMax", R.ALERTA_MAX or 5)

        NCN.gravar(sheet, "rdNatural", ef.rdNatural)
        NCN.gravar(sheet, "limiteMorte", R.limiteMorte(cor))
        NCN.gravar(sheet, "curaDescanso", R.curaDescansoCompleto(pv)
                   * (ef.dobraCuraNatural and 2 or 1))
        NCN.gravar(sheet, "temInterfaceCombate", ef.interfaceDeCombate)
        NCN.gravar(sheet, "temAutoEstabiliza", ef.autoEstabiliza)

        local pvAtual = NCN.num(sheet.pvAtual, pv)
        if sheet.pvAtual == nil then pvAtual = pv end
        if pvAtual > pv then pvAtual = pv end
        NCN.gravar(sheet, "pvAtual", pvAtual)

        local focoAtual = NCN.num(sheet.focoAtual, foco)
        if sheet.focoAtual == nil then focoAtual = foco end
        if focoAtual > foco then focoAtual = foco end
        if focoAtual < 0 then focoAtual = 0 end
        NCN.gravar(sheet, "focoAtual", focoAtual)
    end

    -- =======================================================================
    -- PERÍCIAS — Valor-Alvo = Atributo + Nível + Modificadores (Cap. 1)
    -- =======================================================================

    --- Atributo que a perícia usa. Manha (MEN/VON) e Sobrevivência (COR/MEN)
    --  têm dois: o livro só escreve a barra, sem dizer como escolher.
    --  DECISÃO DE MESA (não está no livro): a ficha usa sempre o MAIOR.
    function NCN.atributoDaPericia(sheet, per, ef)
        local v = NCN.atributoTotal(sheet, per.atributo, ef)
        local sigla = string.upper(per.atributo)
        if per.atributoAlt then
            local alt = NCN.atributoTotal(sheet, per.atributoAlt, ef)
            if alt > v then v, sigla = alt, string.upper(per.atributoAlt) end
        end
        return v, sigla
    end

    function NCN.calcularPericias(sheet, ef)
        local total = 0
        for _, per in ipairs(D.PERICIAS) do
            local nivel = NCN.num(sheet[per.campo .. "_nivel"])
            if nivel < 0 then nivel = 0 end
            if nivel > R.PERICIA_NIVEL_MAX then nivel = R.PERICIA_NIVEL_MAX end
            NCN.gravar(sheet, per.campo .. "_nivel", nivel)

            local atrib, sigla = NCN.atributoDaPericia(sheet, per, ef)
            local bonusCat  = ef.pericia[per.campo] or 0
            local ajuste    = NCN.num(sheet[per.campo .. "_ajuste"])
            local alvo      = R.valorAlvo(atrib, nivel, bonusCat + ajuste)

            NCN.gravar(sheet, per.campo .. "_alvo", alvo)
            NCN.gravar(sheet, per.campo .. "_bonus", bonusCat)

            local custo = R.custoPericia(nivel)
            NCN.gravar(sheet, per.campo .. "_custo", custo)
            total = total + custo

            -- A conta da perícia só aparece quando explica alguma coisa.
            -- São 28 linhas: repetir "COR 14 -3 sem treino" em vinte delas não
            -- informa, treina o olho a ignorar a coluna — e aí a conta que
            -- IMPORTA, a da perícia com bônus de cyberware, passa despercebida.
            -- Nível 0 e nível 1 sem bônus não têm o que explicar: o próprio
            -- alvo já aparece apagado quando a perícia é destreinada.
            local conta
            if nivel <= 0 then
                conta = string.format("%s %d -3 sem treino", sigla, atrib)
            else
                conta = string.format("%s %d %s", sigla, atrib,
                    R.comSinal(R.modificadorPericia(nivel)))
            end
            if bonusCat ~= 0 then conta = conta .. " " .. R.comSinal(bonusCat) .. " cat" end
            if ajuste   ~= 0 then conta = conta .. " " .. R.comSinal(ajuste)   .. " aj"  end
            -- ERRO MEU NA v2.9.1: eu tirei também o nível 0, e como a maioria
            -- das perícias de uma ficha nova é destreinada, a coluna inteira
            -- ficou vazia — pior do que estava. Na prévia aprovada o nível 0
            -- MOSTRAVA "COR 15 -3 sem treino", e mostra: aquele -3 é informação
            -- de verdade, não repetição de fórmula.
            -- O único caso realmente vazio é o nível 1 sem bônus: "REF 10 +0"
            -- não diz nada que o alvo já não diga.
            NCN.gravar(sheet, per.campo .. "_conta",
                NCN.conta(conta, nivel ~= 1 or bonusCat ~= 0 or ajuste ~= 0))
        end
        NCN.gravar(sheet, "custoPericiasTotal", total)
        return total
    end

    -- =======================================================================
    -- RIQUEZA — Cap. 7
    -- =======================================================================

    function NCN.calcularRiqueza(sheet, ef)
        local chave = sheet.riquezaTier
        if chave == nil or chave == "" then chave = "classeMedia" end
        local t = R.riquezaPorChave(chave)
        NCN.gravar(sheet, "riquezaTier", t.chave)
        NCN.gravar(sheet, "riquezaNome", t.nome)
        NCN.gravar(sheet, "custoRiqueza", t.custo)
        NCN.gravar(sheet, "rendaMensal", t.rendaMensal)
        NCN.gravar(sheet, "rendaLivre", R.rendaLivre(t.chave))
        NCN.gravar(sheet, "pctLivre", t.pctLivre)

        -- "Pobreza: metade dos eddies iniciais" (Cap. 8)
        local iniciais = t.eddiesIniciais
        if ef and ef.metadeEddiesIniciais then iniciais = math.floor(iniciais / 2) end
        NCN.gravar(sheet, "eddiesIniciaisTier", iniciais)

        NCN.gravar(sheet, "riquezaConta", string.format(
            "%s eddies iniciais  ·  renda %s/mes  ·  %d%% livre = %s",
            R.eddies(iniciais), R.eddies(t.rendaMensal), t.pctLivre,
            R.eddies(R.rendaLivre(t.chave))))
        return t.custo
    end

    -- =======================================================================
    -- ORÇAMENTO — Cap. 14
    -- =======================================================================

    function NCN.calcularOrcamento(sheet, ef)
        local custoVant = NCN.somar(sheet, NCN.LISTAS.vantagens,    "custo")
        local retDesv   = NCN.somar(sheet, NCN.LISTAS.desvantagens, "retorno")
        local custoRiq  = NCN.num(sheet.custoRiqueza)

        NCN.gravar(sheet, "custoVantagensTotal", custoVant)
        NCN.gravar(sheet, "retornoDesvantagensTotal", retDesv)
        NCN.gravar(sheet, "qtdDesvantagens", NCN.contar(sheet, NCN.LISTAS.desvantagens))

        local o = R.orcamento({
            retornoDesvantagens = retDesv,
            xpGanho             = NCN.num(sheet.xpGanho),
            ajusteManual        = NCN.num(sheet.ajustePontos),
            custoAtributos      = NCN.num(sheet.custoAtributosTotal),
            custoPericias       = NCN.num(sheet.custoPericiasTotal),
            custoVantagens      = custoVant,
            custoRiqueza        = custoRiq,
        })

        NCN.gravar(sheet, "pontosDisponiveis", o.disponivel)
        NCN.gravar(sheet, "pontosGastos",      o.gasto)
        NCN.gravar(sheet, "saldo",             o.saldo)
        NCN.gravar(sheet, "retornoAplicado",   o.retornoAplicado)
        NCN.gravar(sheet, "retornoCortado",    o.retornoCortado)
        NCN.gravar(sheet, "orcamentoConta", string.format(
            "80 base %s desvantagens %s XP %s ajuste = %d disponiveis",
            R.comSinal(o.retornoAplicado), R.comSinal(o.xpGanho),
            R.comSinal(o.ajusteManual), o.disponivel))
        NCN.gravar(sheet, "gastoConta", string.format(
            "atributos %d + pericias %d + vantagens %d + riqueza %d = %d",
            o.custoAtributos, o.custoPericias, o.custoVantagens, o.custoRiqueza, o.gasto))
        return o
    end

    -- =======================================================================
    -- MODIFICADORES DE CENA (aba Combate) — Cap. 4 e Cap. 5
    -- =======================================================================

    function NCN.condicoesAtivas(sheet)
        local ativas = {}
        for _, c in ipairs(R.CONDICOES) do
            if sheet["cond_" .. c.chave] == true then ativas[c.chave] = true end
        end
        return ativas
    end

    function NCN.modificadorDeCena(sheet, arma)
        local partes, total = {}, 0

        local function soma(v, rotulo)
            if v ~= 0 then
                total = total + v
                partes[#partes+1] = string.format("%s %s", R.comSinal(v), rotulo)
            end
        end

        for _, c in ipairs(R.COBERTURA) do
            if c.chave == (sheet.cenaCobertura or "nenhuma") and c.mod ~= 0 then
                soma(c.mod, c.nome)
            end
        end
        for _, a in ipairs(R.ALVO_CORPO) do
            if a.chave == (sheet.cenaAlvoCorpo or "torso") and a.mod ~= 0 then
                soma(a.mod, a.nome)
            end
        end
        local alcancavel = true
        if arma ~= nil and arma.classeAlcance ~= nil and arma.classeAlcance ~= "" then
            local mod, ok = D.modAlcance(arma.classeAlcance, sheet.cenaAlcance or "curta")
            alcancavel = ok
            if ok then soma(mod, "alcance") end
        end
        local ordinal = NCN.num(sheet.cenaOrdinalAtaque, 1)
        if ordinal > 1 then
            soma(R.penalidadeAtaqueMultiplo(ordinal, sheet.temInterfaceCombate == true),
                 string.format("%do ataque%s", ordinal,
                     sheet.temInterfaceCombate == true and " (Interface)" or ""))
        end
        if sheet.cenaRajada == true and arma ~= nil and arma.rajada then soma(-2, "rajada") end
        if sheet.cenaAlvoCaido == true then
            if arma ~= nil and (arma.tipo == "corpoArmado" or arma.tipo == "corpoDesarmado") then
                soma(R.MOD_ATACAR_CAIDO_CC, "alvo caido")
            else
                soma(R.MOD_ATACAR_CAIDO_DISTANCIA, "alvo caido")
            end
        end
        if sheet.cenaEuCaido      == true then soma(R.MOD_ESTANDO_CAIDO,     "voce caido") end
        if sheet.cenaSupressao    == true then soma(R.MOD_FOGO_SUPRESSAO,    "supressao") end
        if sheet.cenaFurtivo      == true then soma(R.BONUS_ATAQUE_FURTIVO,  "furtivo") end
        if sheet.cenaDeVeiculo    == true then soma(R.MOD_ATIRAR_DE_VEICULO, "de veiculo") end
        if sheet.cenaNoMotorista  == true then soma(R.MOD_MIRAR_NO_MOTORISTA,"no motorista") end

        local modCond, nomesCond = R.modificadorDeCondicoes(NCN.condicoesAtivas(sheet))
        if modCond ~= 0 then
            total = total + modCond
            partes[#partes+1] = string.format("%s condicoes", R.comSinal(modCond))
        end

        -- ATAQUE ENGANOSO (Cap. 4, pág. 11-A). Entra por último entre as
        -- manobras porque é o único modificador que o jogador COMPRA: ele tira
        -- do próprio alvo para tirar da Reação do outro.
        --
        -- "Não empilha com Rajada na mesma rolagem — as duas já mexem no mesmo
        --  número, e juntas viram penalidade sem retorno."
        local enganoso = NCN.num(sheet.cenaEnganoso)
        local rajadaAtiva = (sheet.cenaRajada == true and arma ~= nil and arma.rajada)
        if enganoso ~= 0 and not rajadaAtiva then
            local aplicado = R.ataqueEnganoso(enganoso)
            soma(aplicado, "enganoso")
        end

        soma(NCN.num(sheet.cenaModManual), "manual")

        return total, table.concat(partes, "  ·  "), alcancavel, nomesCond
    end

    --- Efeitos que os PROGRAMAS instalados dão sozinhos.
    --  Mesma régua do resto do projeto: só entra o que é numérico, permanente e
    --  incondicional. Chave-Mestra (+2 só contra fechadura digital), Backdoor
    --  (−2 só em sistema já invadido) e Autópsia (−2 só em sistema morto) NÃO
    --  entram — são condicionais e viram nota, com o valor para o jogador
    --  lançar na hora.
    function NCN.efeitosNet(sheet)
        local ef = { danoNeural = 0, alertaPorFalha = 0, fontes = {} }
        for _, no in ipairs(NCN.filhos(sheet, NCN.LISTAS.programas)) do
            local it = EQ.programaPorNome(no.catId or no.nome)
            local m = it and it.mecanicoNet
            if type(m) == "table" then
                if m.danoNeural then
                    ef.danoNeural = ef.danoNeural + m.danoNeural
                    ef.fontes[#ef.fontes+1] = string.format("%s %s no dano neural",
                        it.nome, R.comSinal(m.danoNeural))
                end
                if m.alertaPorFalha then
                    ef.alertaPorFalha = ef.alertaPorFalha + m.alertaPorFalha
                    ef.fontes[#ef.fontes+1] = string.format("%s %s no Alerta por falha",
                        it.nome, R.comSinal(m.alertaPorFalha))
                end
                -- `alertaAoUsar` é de USO, não passivo: quem soma é o botão do
                -- programa, não a presença dele na mochila. Fica declarado no
                -- catálogo para a verificação 33 e para o texto do item.
            end
        end
        return ef
    end

    --- O que o Ataque Enganoso faz do outro lado da mesa. A ficha não conhece a
    --  Reação do alvo, então ela informa o CORTE — quem aplica é o mestre.
    function NCN.textoEnganoso(sheet, arma)
        local enganoso = NCN.num(sheet.cenaEnganoso)
        if enganoso == 0 then return "" end
        if sheet.cenaRajada == true and arma ~= nil and arma.rajada then
            return "Ataque Enganoso DESLIGADO nesta rolagem: não empilha com Rajada (Cap. 4, 11-A)."
        end
        local aplicado, corte = R.ataqueEnganoso(enganoso)
        return string.format(
            "Ataque Enganoso: %s no seu alvo, e a Reação do alvo cai %d — "
            .. "nunca abaixo de 3. Avise o mestre antes de rolar.",
            R.comSinal(aplicado), corte)
    end

    -- =======================================================================
    -- TRAVA DE CRIAÇÃO × JOGO — Cap. 8, 13 e 14
    -- =======================================================================

    function NCN.travada(sheet)
        return sheet ~= nil and sheet.fichaFinalizada == true
    end

    function NCN.recusar(self, sheet, motivo)
        NCN.gravar(sheet, "ultimaRecusa", motivo)
        NCN.txt(self.lblRecusa, motivo)
        NCN.altura(self.linhaRecusa, NCN.alturaDeTexto(motivo, 22, 150, 3))
    end

    function NCN.limparRecusa(self, sheet)
        NCN.gravar(sheet, "ultimaRecusa", "")
        NCN.txt(self.lblRecusa, "")
        NCN.altura(self.linhaRecusa, 0)
    end

    function NCN.souMestre(sheet)
        local mesa = NCN.mesaDe(sheet)
        if mesa == nil then return false end
        local ok, v = pcall(function() return mesa.me.isMestre == true end)
        return ok and v or false
    end

    --- Sinal que as linhas das listas emitem para a ficha se repintar.
    function NCN.tocar(raiz)
        if raiz == nil then return end
        raiz.revisao = NCN.num(raiz.revisao) + 1
    end

    -- =======================================================================
    -- NAVEGAÇÃO ENTRE ABAS
    --
    -- A barra de abas é desenhada por nós — o tabControl nativo não tem
    -- nenhuma propriedade de estilo, e a tira cinza do sistema brigava com
    -- todo o resto da ficha.
    --
    -- O painel inativo recebe visible=false E align="none" ao mesmo tempo.
    -- Só o `visible` seria o suficiente na maioria dos casos, mas dois filhos
    -- align="client" no mesmo pai é a receita para o segundo simplesmente não
    -- aparecer. Trocando o `align` junto, existe sempre exatamente um.
    -- =======================================================================

    NCN.ABA_PADRAO = 1

    function NCN.irParaAba(self, sheet, n)
        n = math.floor(NCN.num(n, NCN.ABA_PADRAO))
        if n < 1 or n > #NCN.ABAS then n = NCN.ABA_PADRAO end
        NCN.gravar(sheet, "abaAtiva", n)

        for _, aba in ipairs(NCN.ABAS) do
            local painel = self["painel" .. aba.id]
            local ativo  = (aba.id == n)
            if painel ~= nil then
                if ativo then
                    pcall(function() painel.align = "client" end)
                    NCN.mostrar(painel, true)
                else
                    NCN.mostrar(painel, false)
                    pcall(function() painel.align = "none" end)
                end
            end
        end
        NCN.pintarAbas(self, sheet)
        NCN.ajustarGrades(self)
    end

    function NCN.pintarAbas(self, sheet)
        local ativa = NCN.num(sheet and sheet.abaAtiva, NCN.ABA_PADRAO)
        for _, aba in ipairs(NCN.ABAS) do
            local eh = (aba.id == ativa)
            NCN.fundo(self["fundoAba" .. aba.id], eh and NCN.COR.painelAlt or NCN.COR.pagina)
            NCN.fundo(self["marcaAba" .. aba.id], eh and aba.cor or NCN.COR.borda)
            NCN.pintar(self["txtAba" .. aba.id], eh and aba.cor or NCN.COR.apagado)
            NCN.altura(self["marcaAba" .. aba.id], eh and 3 or 1)
        end
    end

    -- =======================================================================
    -- CATÁLOGO — um único popup serve os oito catálogos.
    --
    -- O item do catálogo COPIA seus valores para a ficha ao ser adicionado.
    -- Dali em diante ele vive por conta própria: é o que permite uma arma
    -- modificada, um cyberware ajustado ou um preço negociado divergirem do
    -- modelo. O campo `catId` guarda o nome original e nunca é editado — é
    -- por ele que os efeitos automáticos continuam achando o item.
    -- =======================================================================

    NCN.CATALOGOS = {}

    NCN.CATALOGOS.cyberware = {
        titulo = "CYBERWARE — Cap. 6",
        lista  = "listaCyberware",
        categorias = function() return CY.CATEGORIAS end,
        itens = function(cat) return CY.daCategoria(cat) end,
        detalhe = function(it)
            local tipo, moeda = CY.tipoDe(it.humanidade)
            return {
                { "Efeito",     it.efeito },
                { "Preço",      R.eddies(it.preco) .. " eddies" },
                { "Humanidade", tostring(it.humanidade) },
                { "Tipo",       tipo },
                { "Moeda",      moeda .. "   (derivado do custo — o mestre decide)" },
                { "Nota",       it.nota },
                { "Automático", it.mecanico and "sim — a ficha aplica sozinha"
                                             or "não — efeito narrativo ou sem valor fixo no livro" },
            }
        end,
        adicionar = function(no, it)
            no.catId, no.nome, no.categoria = it.nome, it.nome, it.categoria
            no.efeito, no.preco, no.humanidade = it.efeito, it.preco, it.humanidade
            no.nota, no.instalado = "", true
        end,
    }

    NCN.CATALOGOS.arma = {
        titulo = "ARMAS — Cap. 9",
        lista  = "listaArmas",
        categorias = function() return EQ.CATEGORIAS_ARMA end,
        itens = function(cat) return EQ.armasDaCategoria(cat) end,
        detalhe = function(it)
            local per = D.PERICIA_POR_CAMPO[D.PERICIA_DE_ATAQUE[it.tipo]]
            local alc = "corpo a corpo"
            if it.classeAlcance then
                local t = D.ALCANCE[it.classeAlcance]
                alc = string.format("%s — curta %s · média %s · longa %s",
                    it.classeAlcance,
                    t.curta and R.comSinal(t.curta) or "N/A",
                    t.media and R.comSinal(t.media) or "N/A",
                    t.longa and R.comSinal(t.longa) or "N/A")
            end
            return {
                { "Dano",    it.dano },
                { "Perícia", per and (per.nome .. "   (" .. string.upper(per.atributo) .. ")") or "—" },
                { "Traço",   it.traco ~= "" and it.traco or "—" },
                { "Alcance", alc },
                { "Preço",   it.preco > 0 and (R.eddies(it.preco) .. " eddies") or "—" },
                { "Nota",    it.nota },
            }
        end,
        adicionar = function(no, it)
            no.catId, no.nome, no.categoria = it.nome, it.nome, it.categoria
            no.dano, no.tipo = it.dano, it.tipo
            no.classeAlcance = it.classeAlcance or ""
            no.traco, no.perfurante, no.rajada = it.traco or "", it.perfurante == true, it.rajada == true
            no.preco, no.nota, no.equipada = it.preco, "", false
        end,
    }

    NCN.CATALOGOS.armadura = {
        titulo = "ARMADURAS — Cap. 9",
        lista  = "listaArmaduras",
        categorias = function() return { "Armaduras" } end,
        itens = function() return EQ.ARMADURAS end,
        detalhe = function(it)
            return {
                { "Redução de Dano", tostring(it.rd) },
                { "Preço", R.eddies(it.preco) .. " eddies" },
                { "Nota",  it.nota },
                { "Automático", it.mecanico and "sim — penalidade aplicada quando equipada" or "não" },
            }
        end,
        adicionar = function(no, it)
            no.catId, no.nome, no.rd = it.nome, it.nome, it.rd
            no.preco, no.nota, no.equipada = it.preco, "", false
        end,
    }

    NCN.CATALOGOS.item = {
        titulo = "EQUIPAMENTO — Cap. 9",
        lista  = "listaItens",
        categorias = function() return EQ.CATEGORIAS_ITEM end,
        itens = function(cat) return EQ.itensDaCategoria(cat) end,
        detalhe = function(it)
            return {
                { "Efeito", it.efeito },
                { "Preço",  R.eddies(it.preco) .. " eddies" },
                { "Cargas", it.cargas and tostring(it.cargas) or "—" },
                { "Consumível", it.consumivel and "sim" or "não" },
            }
        end,
        adicionar = function(no, it)
            no.catId, no.nome, no.categoria = it.nome, it.nome, it.categoria
            no.efeito, no.preco, no.qtd = it.efeito, it.preco, 1
            no.cargas = it.cargas or 0
        end,
    }

    NCN.CATALOGOS.vantagem = {
        titulo = "VANTAGENS — Cap. 8",
        lista  = "listaVantagens",
        categorias = function()
            return { "Criação apenas", "XP-comprável", "Criação / Narrativa", "Narrativa" }
        end,
        itens = function(cat)
            local mapa = { ["Criação apenas"]="criacao", ["XP-comprável"]="xp",
                           ["Criação / Narrativa"]="social", ["Narrativa"]="narrativa" }
            local chave, out = mapa[cat], {}
            for _, v in ipairs(TR.VANTAGENS) do
                if v.categoria == chave then out[#out+1] = v end
            end
            return out
        end,
        detalhe = function(it)
            local c = TR.CATEGORIA[it.categoria]
            local custo = tostring(it.custo) .. " pts"
            if it.escalonado then
                custo = table.concat(it.escalonado, " / ") .. " pts (escolha o degrau)"
            elseif it.custoMax then
                custo = string.format("%d a %d pts", it.custoMin or it.custo, it.custoMax)
            end
            return {
                { "Efeito",    it.efeito },
                { "Custo",     custo },
                { "Categoria", c and c.nome or it.categoria },
                { "O que isso significa", c and c.explica or "" },
                { "Nota",      it.nota },
                { "Automático", it.mecanico and "sim — a ficha aplica sozinha"
                                             or "não — condicional ou sem valor fixo no livro" },
            }
        end,
        adicionar = function(no, it)
            no.catId, no.nome, no.custo = it.nome, it.nome, it.custo
            no.efeito, no.categoria, no.nota = it.efeito, it.categoria, ""
        end,
        travaAoFinalizar = function(sheet, it)
            return TR.podeComprarVantagem(it.nome, NCN.travada(sheet))
        end,
    }

    NCN.CATALOGOS.desvantagem = {
        titulo = "DESVANTAGENS — Cap. 8",
        lista  = "listaDesvantagens",
        categorias = function() return { "Todas (ordem do livro)" } end,
        itens = function() return TR.DESVANTAGENS end,
        detalhe = function(it)
            local retorno = tostring(it.retorno) .. " pts"
            if it.retornoMax then
                retorno = string.format("%d a %d pts", it.retornoMin or it.retorno, it.retornoMax)
            end
            return {
                { "Efeito",  it.efeito },
                { "Retorno", retorno },
                { "Resolve depois", it.resolve },
                { "Remover custa",  tostring(TR.custoRemoverDesvantagem(it.nome))
                                    .. " XP (o dobro) + arco narrativo — Cap. 13" },
                { "Nota",    it.nota },
                { "Automático", it.mecanico and "sim — a ficha aplica sozinha" or "não" },
            }
        end,
        adicionar = function(no, it)
            no.catId, no.nome, no.retorno = it.nome, it.nome, it.retorno
            no.efeito, no.resolve, no.nota = it.efeito, it.resolve, ""
        end,
        travaAoFinalizar = function(sheet)
            return TR.podeAdicionarDesvantagem(NCN.travada(sheet))
        end,
    }

    NCN.CATALOGOS.programa = {
        titulo = "PROGRAMAS — Cap. 10",
        lista  = "listaProgramas",
        categorias = function() return { "Programas" } end,
        itens = function() return EQ.PROGRAMAS end,
        detalhe = function(it)
            return { { "Efeito", it.efeito }, { "Preço", R.eddies(it.preco) .. " eddies" } }
        end,
        adicionar = function(no, it)
            no.catId, no.nome, no.efeito, no.preco = it.nome, it.nome, it.efeito, it.preco
        end,
    }

    NCN.CATALOGOS.veiculo = {
        titulo = "VEÍCULOS — Cap. 12",
        lista  = "listaVeiculos",
        categorias = function() return { "Veículos" } end,
        itens = function() return EQ.VEICULOS end,
        detalhe = function(it)
            return {
                { "Velocidade",      tostring(it.vel) },
                { "Manobrabilidade", R.comSinal(it.man) .. " no teste de perseguição" },
                { "Estrutura",       tostring(it.pe) },
                { "Redução de Dano", tostring(it.rd) },
                { "Preço",           R.eddies(it.preco) .. " eddies" },
                { "Pilotagem",       it.aereo and "Pilotagem Aérea/Drones" or "Pilotagem Terrestre" },
                { "Nota",            it.nota },
            }
        end,
        adicionar = function(no, it)
            no.catId, no.nome, no.vel, no.man = it.nome, it.nome, it.vel, it.man
            no.pe, no.peAtual, no.rd, no.preco = it.pe, it.pe, it.rd, it.preco
            no.aereo, no.nota = it.aereo == true, ""
        end,
    }

    NCN.LINHAS_DETALHE_CATALOGO = 7

    function NCN.catalogoItemAtual(sheet)
        local def = NCN.CATALOGOS[sheet.catalogoAtivo or ""]
        if def == nil then return nil, nil end
        for _, it in ipairs(def.itens(sheet.catalogoCategoria)) do
            if it.nome == sheet.catalogoItem then return it, def end
        end
        return nil, def
    end

    --- Preenche um comboBox e FORÇA a exibição do valor atual.
    --  Sem o `.value` explícito, um combo que recebe `items`/`values` depois
    --  de o `field=` já ter resolvido fica com a caixa em branco mesmo tendo
    --  o dado por trás — foi o que aconteceu com os cinco combos de cena.
    function NCN.encherCombo(ctrl, nomes, valores, valorAtual)
        if ctrl == nil then return end
        -- `values` ANTES de `items`: entre uma atribuição e outra o combo fica
        -- com a lista de nomes nova e a de valores velha, e um combo ligado a
        -- `field` reescreve o campo com o que estiver no índice corrente.
        if valores ~= nil then pcall(function() ctrl.values = valores end) end
        pcall(function() ctrl.items = nomes end)
        if valorAtual == nil then return end
        pcall(function() ctrl.value = valorAtual end)
        if valores == nil then pcall(function() ctrl.text = valorAtual end) end
    end

    --- Enche um combo LIGADO A UM CAMPO, sem deixar que ele mude o campo.
    --
    -- O BUG QUE ISTO EVITA, e ele chegou à mesa: ao ganhar o tipo `explosivo`,
    -- a lista de tipos de arma passou de 5 para 6 itens — e o Soco/Chute de uma
    -- ficha em uso amanheceu como "Explosivo". O ataque desarmado passou a rolar
    -- **Explosivos (MEN)** em vez de Combate C.C. (Desarmado): 5 pontos de
    -- diferença no Valor-Alvo, sem erro nenhum na tela.
    --
    -- Não dá para inspecionar o que o Firecast faz por dentro na hora de trocar
    -- `items`. Então aqui não se depende de saber: o valor do campo é guardado
    -- antes e devolvido depois, e o combo não tem como reescrever nada.
    -- É a mesma regra da escada das macros — escreva o código que sobrevive à
    -- explicação estar errada.
    function NCN.encherComboDeCampo(ctrl, no, campo, nomes, valores)
        if ctrl == nil or no == nil then return end
        local guardado = no[campo]
        NCN.encherCombo(ctrl, nomes, valores, guardado)
        if no[campo] ~= guardado then no[campo] = guardado end
    end

    function NCN.preencherCategoriasCatalogo(self, sheet)
        local def = NCN.CATALOGOS[sheet.catalogoAtivo or ""]
        if def == nil then return end
        local cats = def.categorias()
        local achou = false
        for _, c in ipairs(cats) do if c == sheet.catalogoCategoria then achou = true end end
        if not achou then NCN.gravar(sheet, "catalogoCategoria", cats[1]) end
        NCN.encherComboDeCampo(self.cboCatCategoria, sheet, "catalogoCategoria", cats, nil)
    end

    function NCN.preencherItensCatalogo(self, sheet)
        local def = NCN.CATALOGOS[sheet.catalogoAtivo or ""]
        if def == nil then return end
        local nomes = {}
        for _, it in ipairs(def.itens(sheet.catalogoCategoria)) do nomes[#nomes+1] = it.nome end
        local achou = false
        for _, n in ipairs(nomes) do if n == sheet.catalogoItem then achou = true end end
        if not achou then NCN.gravar(sheet, "catalogoItem", nomes[1]) end
        NCN.encherComboDeCampo(self.cboCatItem, sheet, "catalogoItem", nomes, nil)
        NCN.pintarDetalheCatalogo(self, sheet)
    end

    function NCN.pintarDetalheCatalogo(self, sheet)
        local it, def = NCN.catalogoItemAtual(sheet)
        NCN.txt(self.lblCatNome, it and it.nome or "—")
        local linhas = (it and def) and def.detalhe(it) or {}
        for i = 1, NCN.LINHAS_DETALHE_CATALOGO do
            local par = linhas[i]
            if par ~= nil and par[2] ~= nil and tostring(par[2]) ~= "" then
                NCN.txt(self["lblCatRot" .. i], string.upper(par[1]))
                NCN.txt(self["lblCatVal" .. i], tostring(par[2]))
                NCN.altura(self["linhaCat" .. i], NCN.alturaDeTexto(tostring(par[2]), 20, 72, 4))
            else
                NCN.txt(self["lblCatRot" .. i], "")
                NCN.txt(self["lblCatVal" .. i], "")
                NCN.altura(self["linhaCat" .. i], 0)
            end
        end

        local motivo = ""
        if it and def and def.travaAoFinalizar then
            local pode, m = def.travaAoFinalizar(sheet, it)
            if not pode then motivo = m or "" end
        end
        NCN.txt(self.lblCatAviso, motivo)
        NCN.altura(self.linhaCatAviso, motivo ~= "" and NCN.alturaDeTexto(motivo, 20, 90, 4) or 0)
        NCN.pintarBotao(self, "catAdicionar", motivo == "", NCN.COR.ciano)
    end

    --- Abre o catálogo. SEMPRE abre: consultar o dado do próprio equipamento
    --  no meio do turno não pode depender de a ficha estar destravada.
    -- POPUP EM TELA PEQUENA.
    --
    -- O popup nasceu com 820×605 fixos. Numa janela menor que isso o Firecast
    -- não encolhe: ele desenha o popup do tamanho pedido e o conteúdo sai pela
    -- borda — as duas colunas do topo se afastam, o painel de detalhe ocupa a
    -- tela inteira e os botões somem. É o mesmo problema dos cards do HUD, só
    -- que dentro de um popup, onde nada é medido.
    --
    -- Aqui o popup passa a ser MEDIDO como o resto da ficha: pega o espaço real
    -- da ficha, tira uma folga, e nunca passa do tamanho de projeto nem cai
    -- abaixo do piso em que o conteúdo ainda cabe.
    NCN.CAT_LARGURA_MAX, NCN.CAT_ALTURA_MAX = 820, 605
    NCN.CAT_LARGURA_MIN, NCN.CAT_ALTURA_MIN = 380, 320

    function NCN.ajustarCatalogo(self)
        local disp = NCN.larguraDisponivel(self, { "painel1", "corpo" }, 40,
                                           NCN.CAT_LARGURA_MAX)
        local altDisp = NCN.alturaDisponivel(self, { "painel1", "corpo" }, 40,
                                             NCN.CAT_ALTURA_MAX)

        local w = disp
        if w > NCN.CAT_LARGURA_MAX then w = NCN.CAT_LARGURA_MAX end
        if w < NCN.CAT_LARGURA_MIN then w = NCN.CAT_LARGURA_MIN end
        local h = altDisp
        if h > NCN.CAT_ALTURA_MAX then h = NCN.CAT_ALTURA_MAX end
        if h < NCN.CAT_ALTURA_MIN then h = NCN.CAT_ALTURA_MIN end

        NCN.largura(self.popCatalogo, w)
        NCN.altura(self.popCatalogo, h)

        -- A coluna CATEGORIA some antes de tudo em popup estreito: ela é a
        -- única com largura fixa no topo, e é ela que empurra o resto.
        local wCat = math.floor((w - 44) * 0.42)
        if wCat > 280 then wCat = 280 end
        if wCat < 120 then wCat = 120 end
        NCN.largura(self.colCatCategoria, wCat)

        -- E o rótulo de cada linha de detalhe: 146 fixos comem metade de um
        -- popup de 380, e o valor sai cortado.
        local wRot = math.floor(w * 0.20)
        if wRot > 146 then wRot = 146 end
        if wRot < 84 then wRot = 84 end
        for i = 1, 7 do NCN.largura(self["lblCatRot" .. i], wRot) end

        -- O botão de adicionar não cabe inteiro em popup estreito.
        local wBt = w < 560 and 130 or 210
        NCN.largura(self.wrapBtcatAdicionar, wBt)
    end

    function NCN.abrirCatalogo(self, sheet, tipo)
        local def = NCN.CATALOGOS[tipo]
        if def == nil then return end
        if sheet.catalogoAtivo ~= tipo then
            NCN.gravar(sheet, "catalogoAtivo", tipo)
            NCN.gravar(sheet, "catalogoCategoria", nil)
            NCN.gravar(sheet, "catalogoItem", nil)
        end
        NCN.txt(self.lblCatTitulo, def.titulo)
        NCN.preencherCategoriasCatalogo(self, sheet)
        NCN.preencherItensCatalogo(self, sheet)
        NCN.ajustarCatalogo(self)
        pcall(function() self.popCatalogo:show() end)
    end

    function NCN.adicionarDoCatalogo(self, sheet)
        local it, def = NCN.catalogoItemAtual(sheet)
        if it == nil or def == nil then return end
        if def.travaAoFinalizar then
            local pode, motivo = def.travaAoFinalizar(sheet, it)
            if not pode then NCN.recusar(self, sheet, motivo); return end
        end
        local rl = self[def.lista]
        if rl == nil then return end
        local no = rl:append()
        if no == nil then return end
        def.adicionar(no, it)
        NCN.limparRecusa(self, sheet)
        NCN.recalcular(sheet, self)
    end

    -- =======================================================================
    -- PINTURA
    -- =======================================================================

    NCN.LARGURA_TRILHO = 92

    --- Cabeçalho fixo: aparece em todas as abas, com o que se olha o tempo
    --  todo. Evita ter de voltar ao Perfil no meio do combate só para ver
    --  quanto de PV sobrou.
    function NCN.pintarCabecalho(self, sheet)
        local nome = sheet.nome
        if nome == nil or nome == "" then nome = "SEM NOME" end
        NCN.txt(self.hdrNome, nome)

        local papel = {}
        if (sheet.profissao or "") ~= "" then papel[#papel+1] = sheet.profissao end
        if (sheet.alterEgo  or "") ~= "" then papel[#papel+1] = '"' .. sheet.alterEgo .. '"' end
        if (sheet.afiliacao or "") ~= "" then papel[#papel+1] = sheet.afiliacao end
        NCN.txt(self.hdrPapel, table.concat(papel, "  ·  "))

        local pv, pvA = NCN.num(sheet.pv), NCN.num(sheet.pvAtual)
        local fo, foA = NCN.num(sheet.focoNeural), NCN.num(sheet.focoAtual)
        local hu      = NCN.num(sheet.humanidade)

        NCN.txt(self.hdrPvTxt,   string.format("%d/%d", pvA, pv))
        NCN.txt(self.hdrFocoTxt, string.format("%d/%d", foA, fo))
        NCN.txt(self.hdrHumTxt,  string.format("%d/10", hu))

        local corPv = NCN.COR.magenta
        if pvA <= 0 then corPv = "#8B1130"
        elseif pv > 0 and pvA <= pv / 2 then corPv = NCN.COR.ambar end
        NCN.barra(self.hdrPvBarra,   pvA, pv, NCN.LARGURA_TRILHO, corPv)
        NCN.barra(self.hdrFocoBarra, foA, fo, NCN.LARGURA_TRILHO, NCN.COR.roxo)

        local corHum = NCN.COR.ciano
        local estado = sheet.humanidadeEstado or "ok"
        if estado == "alerta"  then corHum = NCN.COR.ambar end
        if estado == "critico" then corHum = NCN.COR.magenta end
        NCN.barra(self.hdrHumBarra, hu, R.HUMANIDADE_BASE, NCN.LARGURA_TRILHO, corHum)
        NCN.pintar(self.hdrHumTxt, corHum)
        NCN.pintar(self.hdrPvTxt, corPv)

        NCN.txt(self.hdrEsquiva,    tostring(NCN.num(sheet.esquiva)))
        NCN.txt(self.hdrIniciativa, tostring(NCN.num(sheet.iniciativa)))
        NCN.txt(self.hdrRd,         tostring(NCN.rdEquipada(sheet)))
        NCN.txt(self.hdrSaldo,      tostring(NCN.num(sheet.saldo)))
        NCN.pintar(self.hdrSaldo, NCN.num(sheet.saldo) < 0 and NCN.COR.magenta
                   or (NCN.num(sheet.saldo) == 0 and NCN.COR.verde or NCN.COR.ciano))

        local travada = NCN.travada(sheet)
        NCN.txt(self.lblEstadoFicha, travada and "FINALIZADA" or "EM CRIAÇÃO")
        NCN.pintar(self.lblEstadoFicha, travada and NCN.COR.magenta or NCN.COR.verde)
        NCN.fundo(self.faixaEstado,   travada and NCN.COR.magenta or NCN.COR.verde)
        NCN.txt(self.txtBtfinalizar, travada and "DESTRAVAR (MESTRE)" or "FINALIZAR FICHA")
    end

    function NCN.pintarPerfil(self, sheet)
        local estado = sheet.humanidadeEstado or "ok"
        local cor = NCN.COR.ciano
        if estado == "alerta"  then cor = NCN.COR.ambar end
        if estado == "critico" then cor = NCN.COR.magenta end
        NCN.pintar(self.hudHumanidade, cor)

        NCN.txt(self.lblHumanidadeAviso, sheet.humanidadeAviso)
        NCN.altura(self.linhaHumanidadeAviso,
                   (sheet.humanidadeAviso or "") ~= ""
                   and NCN.alturaDeTexto(sheet.humanidadeAviso, 20, 170, 2) or 0)

        local pv, pvAtual = NCN.num(sheet.pv), NCN.num(sheet.pvAtual)
        local corPv = NCN.COR.ciano
        if pvAtual <= 0 then corPv = NCN.COR.magenta
        elseif pv > 0 and pvAtual <= pv / 2 then corPv = NCN.COR.ambar end
        NCN.pintar(self.hudPvAtual, corPv)

        local avisoPv = ""
        if pvAtual <= 0 then
            avisoPv = string.format(
                "PV zerado — caído, inconsciente ou morrendo. Sem estabilização perde 1 PV/rodada; "
             .. "testes de VON permitem agir até %d (Cap. 4 e 11).%s",
                NCN.num(sheet.limiteMorte),
                sheet.temAutoEstabiliza == true
                    and " Selante de Feridas estabiliza sozinho." or "")
        end
        NCN.txt(self.lblPvAviso, avisoPv)
        NCN.altura(self.linhaPvAviso, avisoPv ~= "" and NCN.alturaDeTexto(avisoPv, 20, 170, 3) or 0)
    end

    function NCN.pintarAtributos(self, sheet)
        for _, a in ipairs(R.ATRIBUTOS) do
            local suf   = NCN.SUFIXO_ATRIBUTO[a.chave]
            local base  = NCN.atributoBase(sheet, a.chave)
            local total = NCN.num(sheet["total" .. suf], base)
            NCN.txt(self["lblTotal" .. suf], tostring(total))
            NCN.txt(self["lblCusto" .. suf], tostring(NCN.num(sheet["custo" .. suf])))
            NCN.txt(self["lblConta" .. suf], R.contaCustoAtributo(a.chave, base))
            NCN.pintar(self["lblTotal" .. suf], total > base and NCN.COR.verde or a.cor)
        end
        NCN.txt(self.lblCustoAtributos, tostring(NCN.num(sheet.custoAtributosTotal)) .. " pts")

        for _, per in ipairs(D.PERICIAS) do
            -- Perícia sem treino fica apagada: o olho encontra na hora o que
            -- vale a pena rolar numa lista de 28 linhas.
            local treinada = NCN.num(sheet[per.campo .. "_nivel"]) > 0
            NCN.pintar(self["alvo_" .. per.campo], treinada and NCN.COR.magenta or NCN.COR.fraco)
            NCN.pintar(self["nome_" .. per.campo], treinada and NCN.COR.texto or NCN.COR.apagado)
            NCN.fundo(self["fundo_" .. per.campo], treinada and NCN.COR.painelAlt or NCN.COR.caixa)
        end
        NCN.txt(self.lblCustoPericias, tostring(NCN.num(sheet.custoPericiasTotal)) .. " pts")
    end

    function NCN.armaEquipada(sheet)
        for _, no in ipairs(NCN.filhos(sheet, NCN.LISTAS.armas)) do
            if no.equipada == true then return no end
        end
        return nil
    end

    function NCN.rdEquipada(sheet)
        local total = 0
        for _, no in ipairs(NCN.filhos(sheet, NCN.LISTAS.armaduras)) do
            if no.equipada == true then total = total + NCN.num(no.rd) end
        end
        return total + NCN.num(sheet.rdNatural) + NCN.num(sheet.ajusteRd)
    end

    function NCN.pintarCombate(self, sheet)
        local arma = NCN.armaEquipada(sheet)
        local dadosArma = arma and {
            tipo          = arma.tipo,
            classeAlcance = (arma.classeAlcance ~= "" and arma.classeAlcance) or nil,
            rajada        = arma.rajada == true,
            perfurante    = arma.perfurante == true,
        } or nil

        local modCena, explicaCena, alcancavel = NCN.modificadorDeCena(sheet, dadosArma)
        NCN.gravar(sheet, "cenaMod", modCena)
        NCN.gravar(sheet, "cenaExplica", explicaCena)

        if arma == nil then
            NCN.txt(self.lblArmaAtiva, "NENHUMA ARMA EQUIPADA")
            NCN.pintar(self.lblArmaAtiva, NCN.COR.fraco)
            NCN.txt(self.lblArmaDano,  "—")
            NCN.txt(self.lblAlvoAtaque, "—")
            NCN.txt(self.lblAtaqueConta, "Marque \"equip.\" numa arma da aba EQUIPAMENTO.")
            NCN.gravar(sheet, "cenaAlcancavel", true)
        else
            local campoPer = D.PERICIA_DE_ATAQUE[arma.tipo] or "cc_armado"
            local per      = D.PERICIA_POR_CAMPO[campoPer]
            local base     = NCN.num(sheet[campoPer .. "_alvo"])
            local alvo     = base + modCena
            NCN.gravar(sheet, "cenaAlvoAtaque", alvo)
            NCN.gravar(sheet, "cenaPericiaAtaque", campoPer)

            NCN.txt(self.lblArmaAtiva, string.upper(tostring(arma.nome or "")) ..
                (arma.traco ~= nil and arma.traco ~= "" and ("   ·   " .. arma.traco) or ""))
            NCN.pintar(self.lblArmaAtiva, NCN.COR.texto)
            NCN.txt(self.lblArmaDano, NCN.danoDaArma(sheet, arma))
            NCN.txt(self.lblAlvoAtaque, tostring(alvo))
            NCN.txt(self.lblAtaqueConta, string.format("%s %d%s%s",
                per and per.nome or "Perícia", base,
                modCena ~= 0 and ("  " .. R.comSinal(modCena)) or "",
                explicaCena ~= "" and ("   ·   " .. explicaCena) or ""))
            NCN.pintar(self.lblAlvoAtaque, alvo >= 13 and NCN.COR.verde
                       or (alvo >= 9 and NCN.COR.ciano or NCN.COR.ambar))
            NCN.gravar(sheet, "cenaAlcancavel", alcancavel)
        end

        local avisoAlc = (arma ~= nil and not alcancavel) and string.format(
            "%s não alcança a faixa %s (tabela de Alcance, Cap. 9). Escolha outra faixa ou outra arma.",
            arma.nome, sheet.cenaAlcance or "curta") or ""
        NCN.txt(self.lblAlcanceAviso, avisoAlc)
        NCN.altura(self.linhaAlcanceAviso, avisoAlc ~= ""
                   and NCN.alturaDeTexto(avisoAlc, 20, 160, 2) or 0)

        NCN.txt(self.lblEnganoso, NCN.textoEnganoso(sheet, arma))
        -- "nessa rodada os alvos não têm Reação — não rolam Esquiva, não
        --  aparam, não se defendem de forma nenhuma" (Cap. 4, 11-A)
        if sheet.cenaEmboscada == true then
            NCN.txt(self.lblEnganoso,
                "EMBOSCADA: nesta rodada o alvo não tem Reação nenhuma — não rola Esquiva. "
                .. "Só existe UMA rodada de surpresa; depois dela o combate é combate.")
            NCN.pintar(self.lblEnganoso, NCN.COR.verde)
        else
            NCN.pintar(self.lblEnganoso, NCN.COR.fraco)
        end

        NCN.txt(self.lblRdTotal, tostring(NCN.rdEquipada(sheet)))
        local rdVestida = NCN.somar(sheet, NCN.LISTAS.armaduras, "rd",
                                    function(n) return n.equipada == true end)
        NCN.txt(self.lblRdConta, string.format("armadura %d + natural %d + ajuste %d",
            rdVestida, NCN.num(sheet.rdNatural), NCN.num(sheet.ajusteRd)))

        -- O aviso é escrito UMA VEZ pela migração, contando o que ela corrigiu,
        -- e some sozinho assim que o mestre digita outro valor no ajuste. Nada
        -- de aviso permanente: aviso que fica para sempre vira paisagem.
        if (sheet.avisoRd or "") ~= ""
           and NCN.num(sheet.ajusteRd) ~= NCN.num(sheet.rdAutoCorrigido) then
            sheet.avisoRd = ""
        end
        local textoRd = sheet.avisoRd or ""
        NCN.txt(self.lblRdAviso, textoRd)
        NCN.altura(self.linhaRdAviso, textoRd ~= ""
                   and NCN.alturaDeTexto(textoRd, 20, 160, 2) or 0)

        local _, nomes = R.modificadorDeCondicoes(NCN.condicoesAtivas(sheet))
        NCN.txt(self.lblCondicoesAtivas, #nomes > 0 and table.concat(nomes, "  ·  ")
                or "nenhuma condição ativa")
        NCN.pintar(self.lblCondicoesAtivas, #nomes > 0 and NCN.COR.ambar or NCN.COR.fraco)

        NCN.txt(self.lblInterfaceCombate, sheet.temInterfaceCombate == true
            and "Interface de Combate instalada: penalidade de ataques múltiplos vira -1 / -3."
            or  "Sem Interface de Combate: penalidade de ataques múltiplos é -3 / -6.")
    end

    function NCN.pintarCyberware(self, sheet)
        local soma = NCN.num(sheet.somaCyberware)
        local qtd  = NCN.contar(sheet, NCN.LISTAS.cyberware, function(n) return n.instalado ~= false end)
        local todos= NCN.contar(sheet, NCN.LISTAS.cyberware)
        NCN.txt(self.lblCyberHumanidade, tostring(NCN.num(sheet.humanidade)))
        NCN.txt(self.lblCyberConta, sheet.humanidadeConta)
        NCN.barra(self.barraCyberHum, NCN.num(sheet.humanidade), R.HUMANIDADE_BASE, 150,
                  (sheet.humanidadeEstado == "critico" and NCN.COR.magenta)
                  or (sheet.humanidadeEstado == "alerta" and NCN.COR.ambar) or NCN.COR.ciano)
        NCN.txt(self.lblCyberSoma, string.format("%d  ·  %d de %d instalado(s)", soma, qtd, todos))
        NCN.txt(self.lblCyberAviso, sheet.humanidadeAviso)
        NCN.altura(self.linhaCyberAviso, (sheet.humanidadeAviso or "") ~= ""
                   and NCN.alturaDeTexto(sheet.humanidadeAviso, 20, 170, 2) or 0)

        local gasto = NCN.somar(sheet, NCN.LISTAS.cyberware, "preco",
                                function(n) return n.instalado ~= false end)
        NCN.txt(self.lblCyberGasto, R.eddies(gasto) .. " eddies em implantes")

        NCN.txt(self.lblCyberVazio, todos == 0
            and "Nenhum implante ainda. Abra o catálogo do Cap. 6 — cada peça custa Humanidade, e Humanidade não volta com XP (Cap. 13)."
            or "")
        NCN.altura(self.linhaCyberVazio, todos == 0 and 32 or 0)
    end

    function NCN.pintarTracos(self, sheet)
        NCN.txt(self.lblCustoVantagens, tostring(NCN.num(sheet.custoVantagensTotal)) .. " pts")
        NCN.txt(self.lblRetornoDesvantagens,
                tostring(NCN.num(sheet.retornoDesvantagensTotal)) .. " pts")

        local avisos = {}
        if sheet.retornoCortado == true then
            avisos[#avisos+1] = string.format(
                "Retorno cortado no teto: %d pts declarados, só %d entram (Cap. 14 — máximo de 120 pontos).",
                NCN.num(sheet.retornoDesvantagensTotal), NCN.num(sheet.retornoAplicado))
        end
        local qtd = NCN.num(sheet.qtdDesvantagens)
        if qtd > R.SUGESTAO_MAX_DESVANTAGENS then
            avisos[#avisos+1] = string.format(
                "%d desvantagens — o Cap. 14 sugere até %d. Não é proibido; é o mestre que decide.",
                qtd, R.SUGESTAO_MAX_DESVANTAGENS)
        end
        local texto = table.concat(avisos, "   ")
        NCN.txt(self.lblTracosAviso, texto)
        NCN.altura(self.linhaTracosAviso, texto ~= "" and NCN.alturaDeTexto(texto, 20, 170, 3) or 0)

        local semV = NCN.contar(sheet, NCN.LISTAS.vantagens) == 0
        NCN.txt(self.lblVantagensVazio, semV
            and "Nenhuma vantagem. As de Criação só entram agora — depois de finalizada a ficha, nunca mais (Cap. 8)." or "")
        NCN.altura(self.linhaVantagensVazio, semV and 28 or 0)

        local semD = NCN.contar(sheet, NCN.LISTAS.desvantagens) == 0
        NCN.txt(self.lblDesvantagensVazio, semD
            and "Nenhuma desvantagem. Elas devolvem até +40 pts, e só podem ser pegas na criação (Cap. 8)." or "")
        NCN.altura(self.linhaDesvantagensVazio, semD and 28 or 0)
    end

    function NCN.pintarRiqueza(self, sheet)
        NCN.txt(self.lblRiquezaConta, sheet.riquezaConta)
        NCN.txt(self.lblRiquezaCusto, tostring(NCN.num(sheet.custoRiqueza)) .. " pts")
        NCN.pintar(self.lblRiquezaCusto, NCN.num(sheet.custoRiqueza) < 0
                   and NCN.COR.verde or NCN.COR.magenta)

        local gasto = NCN.somar(sheet, NCN.LISTAS.armas,     "preco")
                    + NCN.somar(sheet, NCN.LISTAS.armaduras, "preco")
                    + NCN.somar(sheet, NCN.LISTAS.programas, "preco")
                    + NCN.somar(sheet, NCN.LISTAS.veiculos,  "preco")
                    + NCN.somar(sheet, NCN.LISTAS.cyberware, "preco")
        for _, no in ipairs(NCN.filhos(sheet, NCN.LISTAS.itens)) do
            gasto = gasto + NCN.num(no.preco) * math.max(1, NCN.num(no.qtd, 1))
        end
        NCN.gravar(sheet, "valorDoEquipamento", gasto)

        local iniciais = NCN.num(sheet.eddiesIniciaisTier)
        NCN.txt(self.lblValorEquipamento, R.eddies(gasto))
        NCN.txt(self.lblSobra, string.format("%s iniciais − %s em equipamento = %s",
            R.eddies(iniciais), R.eddies(gasto), R.eddies(iniciais - gasto)))
        NCN.pintar(self.lblSobra, (iniciais - gasto) < 0 and NCN.COR.ambar or NCN.COR.fraco)
        NCN.pintarResumosDeLista(self, sheet)
    end

    --- RESUMO POR LISTA, à direita dos botões.
    --
    -- Responde de relance o que hoje exige contar a lista com o dedo: quantos
    -- itens, qual está equipado, quanto custou. Vale principalmente quando a
    -- lista é longa e o item equipado rolou para fora da tela — o jogador
    -- descobre que esqueceu de equipar a arma DEPOIS de rolar o ataque errado.
    function NCN.pintarResumosDeLista(self, sheet)
        local armas = NCN.filhos(sheet, NCN.LISTAS.armas)
        local equipada = nil
        for _, no in ipairs(armas) do
            if no.equipada == true then equipada = tostring(no.nome or "sem nome") end
        end
        NCN.txt(self.lblResumoArmas, string.format("%d %s  ·  %s  ·  %s",
            #armas, #armas == 1 and "arma" or "armas",
            equipada and ("equipada: " .. equipada) or "nenhuma equipada",
            R.eddies(NCN.somar(sheet, NCN.LISTAS.armas, "preco"))))
        NCN.pintar(self.lblResumoArmas, equipada and NCN.COR.fraco or NCN.COR.ambar)

        local armaduras = NCN.filhos(sheet, NCN.LISTAS.armaduras)
        local vestida, rdVestida = nil, 0
        for _, no in ipairs(armaduras) do
            if no.equipada == true then
                vestida = tostring(no.nome or "sem nome")
                rdVestida = NCN.num(no.rd)
            end
        end
        NCN.txt(self.lblResumoArmaduras, string.format("%d %s  ·  %s  ·  %s",
            #armaduras, #armaduras == 1 and "peça" or "peças",
            vestida and ("vestida: " .. vestida .. " (RD " .. rdVestida .. ")")
                    or "nenhuma vestida",
            R.eddies(NCN.somar(sheet, NCN.LISTAS.armaduras, "preco"))))

        local itens, gastoItens = NCN.filhos(sheet, NCN.LISTAS.itens), 0
        for _, no in ipairs(itens) do
            gastoItens = gastoItens + NCN.num(no.preco) * math.max(1, NCN.num(no.qtd, 1))
        end
        NCN.txt(self.lblResumoItens, string.format("%d %s  ·  %s",
            #itens, #itens == 1 and "item" or "itens", R.eddies(gastoItens)))

        local programas, partes = NCN.filhos(sheet, NCN.LISTAS.programas), 0
        for _, no in ipairs(programas) do partes = partes + NCN.num(no.parte) end
        NCN.txt(self.lblResumoProgramas, string.format("%d %s  ·  %d %s de deck  ·  %s",
            #programas, #programas == 1 and "programa" or "programas",
            partes, partes == 1 and "parte" or "partes",
            R.eddies(NCN.somar(sheet, NCN.LISTAS.programas, "preco"))))
    end

    function NCN.pintarNet(self, sheet)
        local men  = NCN.num(sheet.totalMen, 10)
        local foco = NCN.num(sheet.focoNeural)
        NCN.txt(self.lblNetFoco, string.format("%d / %d", NCN.num(sheet.focoAtual), foco))
        NCN.barra(self.barraNetFoco, NCN.num(sheet.focoAtual), foco, 150, NCN.COR.roxo)
        NCN.txt(self.lblNetFocoConta, string.format("MEN %d x 2", men))

        local alvoBase = NCN.num(sheet.interface_alvo)
        local dificuldade, nomeSistema = 0, "—"
        for _, s in ipairs(R.SISTEMAS_NET) do
            if s.chave == (sheet.netSistema or "corpPadrao") then
                dificuldade, nomeSistema = s.dificuldade, s.nome
            end
        end
        -- "Cyberdeck Básico: necessário pra Interface; SEM ELE, -4" (Cap. 9)
        local temDeck, bonusDeck = false, 0
        for _, no in ipairs(NCN.filhos(sheet, NCN.LISTAS.itens)) do
            local it = EQ.itemPorNome(no.catId or no.nome)
            if it and it.cyberdeck then
                temDeck = true
                if (it.modInterface or 0) > bonusDeck then bonusDeck = it.modInterface end
            end
        end
        local penalDeck = temDeck and bonusDeck or EQ.PENALIDADE_SEM_CYBERDECK
        local alvo = alvoBase + dificuldade + penalDeck + NCN.num(sheet.netModManual)
        NCN.gravar(sheet, "netAlvo", alvo)

        NCN.txt(self.lblNetAlvo, tostring(alvo))
        NCN.txt(self.lblNetConta, string.format("Interface %d %s %s%s%s",
            alvoBase, R.comSinal(dificuldade), nomeSistema,
            penalDeck ~= 0 and ("   " .. R.comSinal(penalDeck) ..
                (temDeck and " cyberdeck" or " SEM CYBERDECK")) or "",
            NCN.num(sheet.netModManual) ~= 0
                and ("   " .. R.comSinal(NCN.num(sheet.netModManual)) .. " manual") or ""))
        NCN.pintar(self.lblNetAlvo, temDeck and NCN.COR.ciano or NCN.COR.ambar)

        local alerta = NCN.num(sheet.netAlerta)
        if alerta < 0 then alerta = 0 end
        if alerta > R.ALERTA_MAX then alerta = R.ALERTA_MAX end
        NCN.gravar(sheet, "netAlerta", alerta)
        NCN.txt(self.lblNetAlerta, string.format("%d / %d", alerta, R.ALERTA_MAX))
        NCN.txt(self.lblNetAlertaTexto, R.consequenciaAlerta(alerta))
        local corAl = alerta >= 5 and NCN.COR.magenta or (alerta >= 3 and NCN.COR.ambar or NCN.COR.ciano)
        NCN.pintar(self.lblNetAlerta, corAl)
        NCN.barra(self.barraNetAlerta, alerta, R.ALERTA_MAX, 150, corAl)

        local avisoFoco = ""
        if NCN.num(sheet.focoAtual) <= 0 then
            avisoFoco = "Foco zerado por ICE Branca/Cinza: ejetado e -2 em TODOS os testes até "
                     .. "descanso completo (Cap. 10). Se foi ICE Preta, role a Tabela de Flatline."
        end
        NCN.txt(self.lblNetFocoAviso, avisoFoco)
        NCN.altura(self.linhaNetFocoAviso, avisoFoco ~= ""
                   and NCN.alturaDeTexto(avisoFoco, 20, 170, 3) or 0)
        local efNet = NCN.efeitosNet(sheet)
        NCN.gravar(sheet, "netDanoNeuralMod", efNet.danoNeural)
        NCN.gravar(sheet, "netAlertaPorFalha", efNet.alertaPorFalha)
        NCN.txt(self.lblNetProgramas, #efNet.fontes > 0
            and table.concat(efNet.fontes, "  ·  ")
            or "nenhum programa com efeito automático instalado")
        NCN.pintar(self.lblNetProgramas, #efNet.fontes > 0 and NCN.COR.roxo or NCN.COR.fraco)

        NCN.txt(self.lblNetDeck, temDeck
            and "Cyberdeck presente." or "Sem cyberdeck: -4 em toda Interface (Cap. 9).")
        NCN.pintar(self.lblNetDeck, temDeck and NCN.COR.fraco or NCN.COR.ambar)
    end

    function NCN.pintarVeiculos(self, sheet)
        local hiato = NCN.num(sheet.hiato)
        if hiato < R.HIATO_MIN then hiato = R.HIATO_MIN end
        if hiato > R.HIATO_MAX then hiato = R.HIATO_MAX end
        NCN.gravar(sheet, "hiato", hiato)
        NCN.txt(self.lblHiato, tostring(hiato))
        NCN.barra(self.barraHiato, hiato, R.HIATO_MAX, 150,
                  hiato >= R.HIATO_MAX and NCN.COR.magenta or NCN.COR.ciano)

        local texto
        if hiato <= 0 then
            texto = "Hiato 0 — colado: dá pra embarcar, atirar sem penalidade extra ou forçar colisão."
        elseif hiato >= R.HIATO_MAX then
            texto = "Hiato 5 — o fugitivo escapou. A perseguição acabou."
        else
            texto = string.format("Hiato %d — perseguindo. Maior margem na rodada muda o Hiato em 1.", hiato)
        end
        NCN.txt(self.lblHiatoTexto, texto)
        NCN.pintar(self.lblHiato, hiato >= R.HIATO_MAX and NCN.COR.magenta
                   or (hiato <= 0 and NCN.COR.verde or NCN.COR.ciano))

        local v = nil
        for _, no in ipairs(NCN.filhos(sheet, NCN.LISTAS.veiculos)) do
            if no.ativo == true then v = no end
        end
        local dificuldade, nomeTerreno = -4, "—"
        for _, t in ipairs(R.TERRENO_PERSEGUICAO) do
            if t.chave == (sheet.terreno or "urbano") then
                dificuldade, nomeTerreno = t.dificuldade, t.nome
            end
        end
        if v == nil then
            NCN.txt(self.lblPerseguicaoAlvo, "—")
            NCN.txt(self.lblPerseguicaoConta, "Marque um veículo como ativo para montar o teste.")
            NCN.txt(self.lblVeiculoAtivo, "NENHUM VEÍCULO ATIVO")
            NCN.pintar(self.lblVeiculoAtivo, NCN.COR.fraco)

        else
            local campoPer = v.aereo == true and "pilot_aerea" or "pilot_terrestre"
            local nivel = NCN.num(sheet[campoPer .. "_nivel"])
            local ref   = NCN.num(sheet.totalRef, 10)
            local alvo  = R.alvoPerseguicao(ref, nivel, NCN.num(v.man), dificuldade)
                        + NCN.num(sheet.perseguicaoModManual)
            NCN.gravar(sheet, "perseguicaoAlvo", alvo)
            NCN.txt(self.lblPerseguicaoAlvo, tostring(alvo))
            NCN.txt(self.lblPerseguicaoConta, string.format(
                "REF %d + %s %s + MAN %s + terreno %s (%s)",
                ref, D.PERICIA_POR_CAMPO[campoPer].nome,
                R.comSinal(R.modificadorPericia(nivel)), R.comSinal(NCN.num(v.man)),
                R.comSinal(dificuldade), nomeTerreno))

            NCN.txt(self.lblVeiculoAtivo, string.format(
                "%s   ·   VEL %d   ·   MAN %s   ·   ESTRUTURA %d/%d   ·   RD %d",
                string.upper(tostring(v.nome or "?")), NCN.num(v.vel), R.comSinal(NCN.num(v.man)),
                NCN.num(v.peAtual), NCN.num(v.pe), NCN.num(v.rd)))
            NCN.pintar(self.lblVeiculoAtivo, NCN.COR.texto)
        end
    end

    function NCN.pintarProgressao(self, sheet)
        NCN.txt(self.lblOrcamentoConta, sheet.orcamentoConta)
        NCN.txt(self.lblGastoConta,     sheet.gastoConta)
        NCN.txt(self.lblDisponivel,     tostring(NCN.num(sheet.pontosDisponiveis)))
        NCN.txt(self.lblGastos,         tostring(NCN.num(sheet.pontosGastos)))
        local saldo = NCN.num(sheet.saldo)
        NCN.txt(self.lblSaldo, tostring(saldo))
        NCN.pintar(self.lblSaldo, saldo < 0 and NCN.COR.magenta
                   or (saldo == 0 and NCN.COR.verde or NCN.COR.ciano))

        local disp = NCN.num(sheet.pontosDisponiveis)
        NCN.barra(self.barraGasto, NCN.num(sheet.pontosGastos), disp > 0 and disp or 1, 150,
                  saldo < 0 and NCN.COR.magenta or NCN.COR.ciano)

        local aviso = ""
        if saldo < 0 then
            aviso = string.format("Faltam %d pontos. Baixe um atributo, uma perícia ou uma vantagem — "
                .. "ou peça ao mestre XP/ajuste manual.", -saldo)
        elseif saldo > 0 and NCN.travada(sheet) then
            aviso = string.format("Sobram %d pontos não gastos.", saldo)
        end
        NCN.txt(self.lblSaldoAviso, aviso)
        NCN.altura(self.linhaSaldoAviso, aviso ~= "" and NCN.alturaDeTexto(aviso, 20, 170, 2) or 0)

        local g = R.GUIA_DISTRIBUICAO
        NCN.txt(self.lblGuia, string.format(
            "Guia solto do Cap. 14: ~%d atributos, ~%d perícias, ~%d vantagens.  Você está em %d / %d / %d.",
            g.atributos, g.pericias, g.vantagens,
            NCN.num(sheet.custoAtributosTotal), NCN.num(sheet.custoPericiasTotal),
            NCN.num(sheet.custoVantagensTotal)))
    end

    function NCN.pintarTrava(self, sheet)
        local travada = NCN.travada(sheet)
        NCN.txt(self.lblEstadoTexto, travada
            and "Travados: atributos base, níveis de perícia, riqueza, desvantagens e vantagens de Criação. "
             .. "Livres: PV e Foco atuais, equipar, gastar eddies, condições, alerta, hiato e anotações."
            or  "Tudo editável. Ao finalizar, a ficha trava o que o livro só permite na criação (Cap. 8 e 14) "
             .. "e mantém livre o que é uso de jogo.")

        local criacao = { "edCor","edRef","edMen","edVon","cboRiqueza" }
        for _, n in ipairs(criacao) do NCN.habilitar(self[n], not travada) end
        for _, per in ipairs(D.PERICIAS) do
            NCN.habilitar(self["nivel_" .. per.campo], not travada)
        end

        NCN.txt(self.lblRecusa, sheet.ultimaRecusa or "")
        NCN.altura(self.linhaRecusa, (sheet.ultimaRecusa or "") ~= ""
                   and NCN.alturaDeTexto(sheet.ultimaRecusa, 22, 150, 3) or 0)
    end


    -- =======================================================================
    -- AÇÕES DOS BOTÕES
    --
    -- Os botões da ficha são retângulos desenhados, e um retângulo não sabe
    -- receber código diferente em cada uso de um template. Então cada botão
    -- carrega uma CHAVE e o despacho acontece aqui — o que também põe toda a
    -- lógica de clique em Lua, onde a simulação consegue exercitá-la.
    -- =======================================================================

    NCN.ACOES = {}

    NCN.ACOES.finalizar = function(self, sheet)
        if sheet.fichaFinalizada == true then
            if NCN.souMestre(sheet) then
                sheet.fichaFinalizada = false
                NCN.limparRecusa(self, sheet)
            else
                NCN.recusar(self, sheet,
                    "Só o mestre pode destravar uma ficha finalizada. "
                 .. "Peça a ele — ele destrava por este mesmo botão.")
                NCN.irParaAba(self, sheet, 1)
            end
        else
            sheet.fichaFinalizada = true
            NCN.limparRecusa(self, sheet)
        end
    end

    NCN.ACOES.rolarAtaque = function(self, sheet)
        local arma = NCN.armaEquipada(sheet)
        if arma == nil then
            NCN.recusar(self, sheet,
                "Nenhuma arma equipada. Marque \"equip.\" numa arma da aba EQUIPAMENTO — "
             .. "é ela que define a perícia, o dano e o alcance do ataque.")
            return
        end
        if sheet.cenaAlcancavel == false then
            NCN.recusar(self, sheet, NCN.num(0) == 0 and
                (tostring(arma.nome) .. " não alcança a faixa escolhida (Cap. 9). "
              .. "Troque a faixa de alcance ou a arma.") or "")
            return
        end
        NCN.rolarTeste(sheet, NCN.num(sheet.cenaAlvoAtaque),
            "Ataque com " .. tostring(arma.nome or "arma"), sheet.cenaExplica)
    end

    NCN.ACOES.rolarDano = function(self, sheet)
        local arma = NCN.armaEquipada(sheet)
        if arma == nil then
            NCN.recusar(self, sheet, "Nenhuma arma equipada — não há dado de dano para rolar.")
            return
        end
        NCN.rolarDano(sheet, NCN.danoDaArma(sheet, arma), NCN.num(sheet.cenaRdAlvo),
            arma.perfurante == true, (sheet.cenaAlvoCorpo or "torso") == "cabeca", arma.nome)
    end

    NCN.ACOES.rolarInterface = function(self, sheet)
        NCN.rolarTeste(sheet, NCN.num(sheet.netAlvo), "Interface", "invasão de sistema")
    end

    NCN.ACOES.rolarPerseguicao = function(self, sheet)
        local temAtivo = false
        for _, no in ipairs(NCN.filhos(sheet, NCN.LISTAS.veiculos)) do
            if no.ativo == true then temAtivo = true end
        end
        if not temAtivo then
            NCN.recusar(self, sheet,
                "Nenhum veículo ativo. Marque um na GARAGEM — a manobrabilidade dele "
             .. "entra no teste de perseguição.")
            return
        end
        NCN.rolarTeste(sheet, NCN.num(sheet.perseguicaoAlvo), "Perseguição",
            "compare a margem com a do outro lado")
    end

    -- ICE, Flatline e Choque passaram a sair pelas MACROS da mesa. O caminho
    -- antigo (rolarDados + escrever) tinha dois defeitos: `escrever` é local,
    -- então só quem clicou via o resultado da tabela; e não passa pelo
    -- TaleMark, então marcação saía com colchete na tela. A macro manda por
    -- `enviar`, que a mesa inteira vê formatado.
    --
    -- O Foco atual vai junto no /ice: é com ele que a macro sabe dizer se
    -- zerou e se é caso de Flatline (Cap. 10).
    NCN.ACOES.iceCinza = function(self, sheet)
        NCN.enviar(sheet, "/ice cinza " .. math.floor(NCN.num(sheet.focoAtual)))
    end
    NCN.ACOES.icePreto = function(self, sheet)
        NCN.enviar(sheet, "/ice preta " .. math.floor(NCN.num(sheet.focoAtual)))
    end
    NCN.ACOES.flatline = function(self, sheet) NCN.enviar(sheet, "/flat") end
    NCN.ACOES.choque   = function(self, sheet) NCN.enviar(sheet, "/choque") end

    --- Liga e desliga o espelho nas barrinhas do jogador.
    NCN.ACOES.barrasLigar = function(self, sheet)
        sheet.barrasLigadas = not (sheet.barrasLigadas ~= false)
        NCN.__barras[NCN.chaveDaFicha(sheet)] = nil   -- força reenvio ao religar
        NCN.recalcular(sheet, self)
    end

    NCN.ACOES.alertaMais  = function(self, sheet) sheet.netAlerta = NCN.num(sheet.netAlerta) + 1 end
    NCN.ACOES.alertaMenos = function(self, sheet) sheet.netAlerta = NCN.num(sheet.netAlerta) - 1 end
    NCN.ACOES.hiatoMais   = function(self, sheet) sheet.hiato = NCN.num(sheet.hiato) + 1 end
    NCN.ACOES.hiatoMenos  = function(self, sheet) sheet.hiato = NCN.num(sheet.hiato) - 1 end

    NCN.ACOES.curaCena = function(self, sheet)
        sheet.pvAtual = math.min(NCN.num(sheet.pv), NCN.num(sheet.pvAtual) + 1)
    end
    NCN.ACOES.curaDescanso = function(self, sheet)
        sheet.pvAtual = math.min(NCN.num(sheet.pv),
            NCN.num(sheet.pvAtual) + NCN.num(sheet.curaDescanso))
        sheet.focoAtual = NCN.num(sheet.focoNeural)
    end
    NCN.ACOES.curaRepouso = function(self, sheet)
        sheet.pvAtual   = NCN.num(sheet.pv)
        sheet.focoAtual = NCN.num(sheet.focoNeural)
    end

    NCN.ACOES.sessaoXp = function(self, sheet)
        local no = self.listaXp:append()
        if no ~= nil then no.xp = 2; no.descricao = "Participou da sessão" end
        sheet.xpGanho = NCN.num(sheet.xpGanho) + 2
    end

    -- Catálogos: um por tipo, todos abrindo o mesmo popup.
    local function abridor(tipo) return function(self, sheet) NCN.abrirCatalogo(self, sheet, tipo) end end
    NCN.ACOES.catCyberware   = abridor("cyberware")
    NCN.ACOES.catArma        = abridor("arma")
    NCN.ACOES.catArmadura    = abridor("armadura")
    NCN.ACOES.catItem        = abridor("item")
    NCN.ACOES.catVantagem    = abridor("vantagem")
    NCN.ACOES.catDesvantagem = abridor("desvantagem")
    NCN.ACOES.catPrograma    = abridor("programa")
    NCN.ACOES.catVeiculo     = abridor("veiculo")

    -- Linha em branco: para o que a mesa inventou e o livro não tem.
    local function novaLinha(lista, preencher)
        return function(self, sheet)
            local rl = self[lista]
            if rl == nil then return end
            local no = rl:append()
            if no ~= nil and preencher ~= nil then preencher(no) end
        end
    end
    NCN.ACOES.novoCyberware   = novaLinha("listaCyberware", function(n) n.instalado = true end)
    NCN.ACOES.novaArma        = novaLinha("listaArmas", function(n) n.tipo = "fogo" end)
    NCN.ACOES.novaArmadura    = novaLinha("listaArmaduras")
    NCN.ACOES.novoItem        = novaLinha("listaItens", function(n) n.qtd = 1 end)
    NCN.ACOES.novaVantagem    = novaLinha("listaVantagens")
    NCN.ACOES.novoPrograma    = novaLinha("listaProgramas")
    NCN.ACOES.novoVeiculo     = novaLinha("listaVeiculos")

    NCN.ACOES.catAdicionar = function(self, sheet) NCN.adicionarDoCatalogo(self, sheet) end
    NCN.ACOES.catFechar    = function(self, sheet) pcall(function() self.popCatalogo:close() end) end

    --- Trava de criação: a recusa diz por quê e quem libera, em vez de o
    --  botão simplesmente não fazer nada.
    NCN.ACOES_TRAVADAS = { catVantagem=true, catDesvantagem=true }

    function NCN.acao(self, sheet, chave)
        local fn = NCN.ACOES[chave]
        if fn == nil then return end
        if NCN.ACOES_TRAVADAS[chave] and NCN.travada(sheet) then
            NCN.recusar(self, sheet,
                "A ficha está finalizada: vantagens de Criação e desvantagens novas não "
             .. "entram mais (Cap. 8). O catálogo abre para consulta pelo próprio botão; "
             .. "só o mestre destrava a compra.")
            NCN.abrirCatalogo(self, sheet, chave == "catVantagem" and "vantagem" or "desvantagem")
            return
        end
        local ok, err = pcall(function() fn(self, sheet) end)
        if not ok then
            NCN.txt(self.lblErro, "Erro na ação " .. chave .. ": " .. tostring(err))
            NCN.altura(self.linhaErro, 22)
            return
        end
        NCN.recalcular(sheet, self)
    end

    -- Quais botões ficam pálidos, e quando.
    function NCN.pintarBotoes(self, sheet)
        local arma = NCN.armaEquipada(sheet)
        NCN.pintarBotao(self, "rolarAtaque", arma ~= nil and sheet.cenaAlcancavel ~= false,
                        NCN.COR.magenta)
        NCN.pintarBotao(self, "rolarDano", arma ~= nil, NCN.COR.magenta)
        local temAtivo = false
        for _, no in ipairs(NCN.filhos(sheet, NCN.LISTAS.veiculos)) do
            if no.ativo == true then temAtivo = true end
        end
        NCN.pintarBotao(self, "rolarPerseguicao", temAtivo, NCN.COR.verde)
        NCN.pintarBotao(self, "rolarInterface", true, NCN.COR.roxo)
        local travada = NCN.travada(sheet)
        NCN.pintarBotao(self, "catVantagem",    not travada, NCN.COR.ciano)
        NCN.pintarBotao(self, "catDesvantagem", not travada, NCN.COR.magenta)
        NCN.pintarBotao(self, "finalizar", true, travada and NCN.COR.magenta or NCN.COR.verde)
    end

    -- =======================================================================
    -- GRADES RESPONSIVAS
    -- =======================================================================

    -- ESTA LISTA E A ORDEM DOS <cardValor> NO XML TÊM QUE BATER. Um card que
    -- existe no XML e falta aqui mantém a largura declarada no template (130) e
    -- transborda a linha — foi o que aconteceu com "BonusDano" na v2.5: o card
    -- de Humanidade saiu cortado na borda direita da ficha.
    -- A verificação nº 26 confere as duas listas uma contra a outra.
    NCN.CARDS_HUD   = { "Pv","Foco","Esquiva","Vel","Iniciativa","Percepcao",
                        "BonusDano","Humanidade" }
    NCN.CARDS_ATRIB = { "Cor","Ref","Men","Von" }

    function NCN.ajustarGrades(self)
        local total = NCN.larguraDisponivel(self,
            { "linhaHud", "painel1" }, 20, NCN.LARGURA_FALLBACK)
        -- Os pisos subiram junto com a tipografia da v2.6: um card de 86px com
        -- rótulo de 12pt corta "PONTOS DE VIDA" no meio. Abaixo do piso o
        -- distribuidor para de encolher — em tela estreita é melhor o card
        -- passar um pouco do que o texto virar reticência.
        NCN.distribuirCards(self, "wrapHud", NCN.CARDS_HUD, total, 6, 98)

        local totalA = NCN.larguraDisponivel(self,
            { "linhaAtributos", "painel2" }, 20, NCN.LARGURA_FALLBACK)
        NCN.distribuirCards(self, "wrapAtrib", NCN.CARDS_ATRIB, totalA, 6, 182)

        -- A barra de abas divide a largura entre as dez, sem sobrar buraco
        local totalT = NCN.larguraDisponivel(self, { "barraAbas" }, 4, NCN.LARGURA_FALLBACK)
        local w = math.floor(totalT / #NCN.ABAS)
        if w < 86 then w = 86 end
        for _, aba in ipairs(NCN.ABAS) do
            NCN.largura(self["wrapAba" .. aba.id], w)
        end
    end

    -- =======================================================================
    -- MIGRAÇÃO
    --
    -- Ninguém pode perder o que escreveu porque a ficha evoluiu. Isto roda a
    -- cada abertura e só preenche o que está vazio — nunca sobrescreve.
    -- =======================================================================

    --- Copia um campo antigo para o novo, se o novo ainda não existe.
    function NCN.herdar(no, antigo, novo)
        if no == nil then return end
        if no[novo] == nil and no[antigo] ~= nil then no[novo] = no[antigo] end
    end

    function NCN.herdarCampo(sheet, lista, antigo, novo)
        for _, no in ipairs(NCN.filhos(sheet, lista)) do NCN.herdar(no, antigo, novo) end
    end

    --- Religa cada linha de uma lista ao catálogo e preenche o que está vazio.
    --  Procura por `catId` OU pelo nome digitado: conserta linha herdada da v1
    --  e linha que o jogador escreveu à mão com o nome certo. Nunca sobrescreve
    --  o que já tem valor — quem editou um preço continua com o preço dele.
    function NCN.religar(sheet, lista, buscar, copiar)
        if buscar == nil then return end
        for _, no in ipairs(NCN.filhos(sheet, lista)) do
            local chave = no.catId
            if chave == nil or chave == "" then chave = no.nome end
            local ok, it = pcall(buscar, chave)
            if ok and it ~= nil then
                if no.catId == nil or no.catId == "" then no.catId = it.nome end
                copiar(no, it)
            end
        end
    end

    function NCN.migrarNos(sheet)
        -- CYBERWARE: v1 gravava `custoHumanidade` e `descricao`, e não tinha
        -- a marca de instalado — sem ela, a caixinha nasce desmarcada mas o
        -- implante conta na Humanidade. Os dois têm de dizer a mesma coisa.
        for _, no in ipairs(NCN.filhos(sheet, NCN.LISTAS.cyberware)) do
            -- A v1 gravava o custo POSITIVO (a conta dela era `10 - custo`).
            -- Copiar sem inverter faz a Humanidade subir a cada implante.
            if no.humanidade == nil and no.custoHumanidade ~= nil then
                no.humanidade = -math.abs(NCN.num(no.custoHumanidade))
            end
            NCN.herdar(no, "descricao", "efeito")
            if no.instalado == nil then no.instalado = true end
            if no.catId == nil then
                local it = CY.porNome(no.nome)
                if it ~= nil then
                    no.catId = it.nome
                    if no.humanidade == nil then no.humanidade = it.humanidade end
                    if no.preco  == nil or NCN.num(no.preco) == 0 then no.preco = it.preco end
                    if (no.efeito or "") == "" then no.efeito = it.efeito end
                    if (no.categoria or "") == "" then no.categoria = it.categoria end
                end
            end
        end

        -- VANTAGENS e DESVANTAGENS: v1 chamava os dois de `valor`. Sem esta
        -- linha o orçamento zera e a ficha diz que sobram pontos que não há.
        for _, no in ipairs(NCN.filhos(sheet, NCN.LISTAS.vantagens)) do
            NCN.herdar(no, "valor", "custo")
            NCN.herdar(no, "descricao", "efeito")
            if no.catId == nil then
                local it = TR.vantagemPorNome(no.nome)
                if it ~= nil then
                    no.catId = it.nome
                    if no.custo == nil or NCN.num(no.custo) == 0 then no.custo = it.custo end
                    if (no.efeito or "") == "" then no.efeito = it.efeito end
                    if (no.categoria or "") == "" then no.categoria = it.categoria end
                end
            end
        end
        for _, no in ipairs(NCN.filhos(sheet, NCN.LISTAS.desvantagens)) do
            NCN.herdar(no, "valor", "retorno")
            NCN.herdar(no, "descricao", "efeito")
            if no.catId == nil then
                local it = TR.desvantagemPorNome(no.nome)
                if it ~= nil then
                    no.catId = it.nome
                    if no.retorno == nil or NCN.num(no.retorno) == 0 then no.retorno = it.retorno end
                    if (no.efeito or "") == "" then no.efeito = it.efeito end
                    if (no.resolve or "") == "" then no.resolve = it.resolve end
                end
            end
        end

        -- ARMAS: v1 tinha `alcance` como texto livre; agora `classeAlcance` é
        -- uma escolha da tabela do Cap. 9. O texto antigo vira nota, para não
        -- sumir da tela sem aviso.
        for _, no in ipairs(NCN.filhos(sheet, NCN.LISTAS.armas)) do
            if no.tipo == nil or no.tipo == "" then no.tipo = "fogo" end
            if (no.classeAlcance or "") == "" and (no.alcance or "") ~= "" then
                no.nota = ((no.nota or "") ~= "" and (no.nota .. " · ") or "")
                        .. "alcance (v1): " .. tostring(no.alcance)
                no.alcance = nil
            end
            if no.catId == nil then
                local it = EQ.armaPorNome(no.nome)
                if it ~= nil then
                    no.catId = it.nome
                    if (no.dano or "") == "" then no.dano = it.dano end
                    no.tipo = it.tipo
                    if (no.classeAlcance or "") == "" then no.classeAlcance = it.classeAlcance or "" end
                    if no.perfurante == nil then no.perfurante = it.perfurante == true end
                    if no.rajada == nil then no.rajada = it.rajada == true end
                    if no.preco == nil or NCN.num(no.preco) == 0 then no.preco = it.preco end
                end
            end
        end

        -- ITENS, PROGRAMAS e VEÍCULOS: as três listas que NÃO religavam.
        --
        -- O BUG: uma linha sem `catId` existe na tela mas não alimenta nada.
        -- O Cyberdeck ficava listado e o netrunner continuava com -4 em toda
        -- Interface (Cap. 9); o preço ficava vazio e sumia do total gasto; o
        -- programa não entrava na conta. As outras cinco listas religavam ao
        -- catálogo desde a v2.0 — estas três passaram batido.
        --
        -- `NCN.religar` procura pelo `catId` OU pelo nome, então conserta
        -- tanto linha de v1 quanto linha digitada à mão com o nome certo.
        NCN.herdarCampo(sheet, NCN.LISTAS.itens, "item", "nome")

        NCN.religar(sheet, NCN.LISTAS.itens, EQ.itemPorNome, function(no, it)
            if (no.efeito or "") == "" then no.efeito = it.efeito end
            if (no.categoria or "") == "" then no.categoria = it.categoria end
            if no.preco  == nil or NCN.num(no.preco)  == 0 then no.preco  = it.preco end
            if no.cargas == nil or NCN.num(no.cargas) == 0 then no.cargas = it.cargas or 0 end
        end)
        for _, no in ipairs(NCN.filhos(sheet, NCN.LISTAS.itens)) do
            if no.qtd == nil or NCN.num(no.qtd) == 0 then no.qtd = 1 end
        end

        NCN.religar(sheet, NCN.LISTAS.programas, EQ.programaPorNome, function(no, it)
            if (no.efeito or "") == "" then no.efeito = it.efeito end
            if no.preco == nil or NCN.num(no.preco) == 0 then no.preco = it.preco end
        end)

        NCN.religar(sheet, NCN.LISTAS.veiculos, EQ.veiculoPorNome, function(no, it)
            if no.vel == nil or NCN.num(no.vel) == 0 then no.vel = it.vel end
            if no.man   == nil then no.man   = it.man end
            if no.pe    == nil or NCN.num(no.pe)    == 0 then no.pe    = it.pe end
            if no.rd    == nil then no.rd    = it.rd end
            if no.preco == nil or NCN.num(no.preco) == 0 then no.preco = it.preco end
            if no.peAtual == nil or NCN.num(no.peAtual) == 0 then no.peAtual = no.pe end
            -- A nota do livro NÃO é mais copiada: ela vive no hint da linha,
            -- buscada pelo catId. Religar enchendo o campo devolveria a segunda
            -- linha em toda ficha antiga.
        end)

        for _, no in ipairs(NCN.filhos(sheet, NCN.LISTAS.armaduras)) do
            if no.catId == nil then
                local it = EQ.armaduraPorNome(no.nome)
                if it ~= nil then
                    no.catId = it.nome
                    if no.rd == nil or NCN.num(no.rd) == 0 then no.rd = it.rd end
                    if no.preco == nil or NCN.num(no.preco) == 0 then no.preco = it.preco end
                end
            end
        end
    end

    -- Campos que existiram na v1 e NÃO existem mais no XML. A ficha só os lê
    -- para migrar quem tem ficha antiga. Estão declarados aqui porque a
    -- verificação 32 reprova todo `sheet.<campo>` que não existe em lugar
    -- nenhum — e sem esta lista a única saída seria abrir exceção escondida
    -- na checagem, que é como uma checagem começa a mentir.
    NCN.CAMPOS_LEGADOS = {
        "focoNeuralAtual",   -- virou focoAtual
        "rdArmadura",        -- virou ajusteRd (a RD agora sai da armadura equipada)
        "xpTotal",           -- virou xpGanho
        "xpFalso",           -- virou ajustePontos
    }

    -- MIGRAÇÃO DE CAMPO SOLTO É DE UMA VEZ SÓ.
    --
    -- O BUG: o mestre zerava o ajuste de RD e ele VOLTAVA. A conversão da v1
    -- era guardada por `ajusteRd == nil`, e um campo numérico esvaziado no
    -- Firecast vira nil — não zero. Então, na abertura seguinte, a migração
    -- via "campo vazio, preciso converter" e escrevia o valor de novo. Um laço
    -- que nenhuma ficha conseguia sair, e que na tela parecia número saindo do
    -- nada. "Vindo de lugar nenhum" era a descrição literal do que acontecia.
    --
    -- A marca `versaoDados` fecha isso: converteu uma vez, nunca mais. E os
    -- campos da v1 são apagados depois de usados, para não haver de onde
    -- ressuscitar.
    -- 3: reparo do `tipo` das armas. Quando a lista de tipos ganhou
    --    `explosivo`, combos ligados a `field` reescreveram o campo de fichas em
    --    uso — Soco/Chute virou Explosivo e o ataque desarmado passou a rolar
    --    Explosivos (MEN). Aqui o tipo volta ao do catálogo, UMA VEZ.
    NCN.VERSAO_DADOS = 4

    function NCN.migrar(sheet)
        if NCN.num(sheet.versaoDados) < NCN.VERSAO_DADOS then
            if sheet.focoNeuralAtual ~= nil and sheet.focoAtual == nil then
                sheet.focoAtual = sheet.focoNeuralAtual
            end

            -- Quanto de RD vem de implante, que a v1 não calculava e o jogador
            -- somava à mão dentro de `rdArmadura`.
            local rdDeImplante = 0
            for _, no in ipairs(NCN.filhos(sheet, NCN.LISTAS.cyberware)) do
                if no.instalado ~= false then
                    local it = CY.porNome(no.catId or no.nome)
                    if it and type(it.mecanico) == "table" and it.mecanico.rdNatural then
                        rdDeImplante = rdDeImplante + it.mecanico.rdNatural
                    end
                end
            end

            local rdV1 = NCN.num(sheet.rdArmadura)
            if sheet.rdArmadura ~= nil and rdV1 > 0 then
                local limpo = rdV1 - rdDeImplante
                if limpo < 0 then limpo = 0 end
                if sheet.ajusteRd == nil
                   and NCN.contar(sheet, NCN.LISTAS.armaduras) == 0 then
                    sheet.ajusteRd = limpo
                elseif NCN.num(sheet.ajusteRd) == rdV1 and rdDeImplante > 0 then
                    -- O ajuste é IDÊNTICO ao total da v1: prova de que veio da
                    -- migração antiga e ninguém editou desde então. Aqui dá para
                    -- corrigir sem adivinhar — e a ficha diz o que fez.
                    sheet.ajusteRd = limpo
                    sheet.avisoRd = string.format(
                        "a ficha corrigiu o ajuste de RD de %d para %d: os %d de "
                        .. "implante vinham somados à mão desde a v1 e estavam "
                        .. "contando duas vezes. Se o número certo era outro, é "
                        .. "só digitar por cima.", rdV1, limpo, rdDeImplante)
                    sheet.rdAutoCorrigido = limpo
                end
            end

            if sheet.xpTotal ~= nil and sheet.xpGanho == nil then sheet.xpGanho = sheet.xpTotal end
            if sheet.xpFalso ~= nil and sheet.ajustePontos == nil then sheet.ajustePontos = sheet.xpFalso end

            -- apagados depois de usados: não há de onde ressuscitar
            sheet.rdArmadura, sheet.focoNeuralAtual = nil, nil
            sheet.xpTotal, sheet.xpFalso = nil, nil
            sheet.versaoDados = 2
        end

        -- CADA REPARO COM SUA PRÓPRIA GUARDA DE VERSÃO.
        -- A primeira versão disto era um `elseif` do bloco acima, e por isso não
        -- rodava em ficha que ainda estava na v1: ela caía no primeiro ramo e
        -- saía com a marca em dia sem nunca ter passado pelo reparo. Guarda por
        -- reparo, não por bloco.
        if NCN.num(sheet.versaoDados) < 3 then
            -- O catálogo é a fonte da verdade do `tipo` porque `tipo` não é
            -- escolha de mesa: é o que a arma É. E quem o alterou foi o combo,
            -- não uma pessoa. Arma digitada à mão, sem catId, não é tocada.
            for _, no in ipairs(NCN.filhos(sheet, NCN.LISTAS.armas)) do
                if (no.catId or "") ~= "" then
                    local it = EQ.armaPorNome(no.catId)
                    if it ~= nil and it.tipo ~= nil and no.tipo ~= it.tipo then
                        no.tipo = it.tipo
                    end
                end
            end
            sheet.versaoDados = 3
        end

        if NCN.num(sheet.versaoDados) < 4 then
            -- `detalheAberto` (booleano) virou `detalheModo` (1 aberto,
            -- 2 fechado, vazio = o jogador ainda não escolheu). O campo antigo
            -- não é convertido: ele nunca guardou "fechado" — só existia como
            -- `true`, e quem o tinha ligado já tem conteúdo que abre a linha por
            -- padrão. Convertê-lo prenderia a linha aberta de novo, que é
            -- exatamente o defeito que estamos tirando.
            -- Ele é apagado porque campo órfão na ficha é a forma de bug que
            -- este projeto mais encontrou: declarado, gravado, alimentando nada.
            for _, lista in ipairs({ NCN.LISTAS.armas, NCN.LISTAS.armaduras,
                                     NCN.LISTAS.itens, NCN.LISTAS.programas }) do
                for _, no in ipairs(NCN.filhos(sheet, lista)) do
                    if no.detalheAberto ~= nil then no.detalheAberto = nil end
                end
            end
            sheet.versaoDados = 4
        end
        -- Religar as listas ao catálogo continua rodando SEMPRE: é idempotente,
        -- e conserta linha que alguém acabou de digitar à mão.
        NCN.migrarNos(sheet)
    end

    -- =======================================================================
    -- RECÁLCULO — passa por aqui TUDO que a ficha calcula.
    -- Uma chamada sumir desta lista é um bug silencioso; há verificação de
    -- build conferindo que as rotinas essenciais continuam presentes.
    -- =======================================================================

    NCN.__recalculando = false

    -- ARMA EMBUTIDA — a fonte é o cyberware, não a compra.
    --
    -- O jeito fácil seria criar a linha uma vez, quando o cyberware entra. Isso
    -- responde mal à pergunta que este projeto sempre faz: **o que acontece
    -- quando a fonte do bônus sai da ficha?** Uma linha criada e esquecida
    -- deixaria a Lâmina Retrátil na lista de armas depois de o braço ser
    -- removido, e ninguém iria notar.
    --
    -- Então a linha é DERIVADA e reconciliada a cada recálculo: cria o que
    -- falta, apaga o que perdeu a fonte, e não toca em mais nada — quem ajustou
    -- o dano na mão continua com o dano dele. `preco = 0` porque o cyberware já
    -- foi pago; cobrar de novo estouraria o orçamento em silêncio.
    function NCN.sincronizarArmasEmbutidas(sheet, self, ef)
        if NCN.__sincronizandoArmas then return end
        local rl = self[NCN.CATALOGOS.arma.lista]
        if rl == nil then return end

        local esperadas = {}
        for _, a in ipairs(ef.armasEmbutidas) do esperadas[a.origem] = a end

        NCN.__sincronizandoArmas = true
        local ok = pcall(function()
            local sobrando = {}
            for _, no in ipairs(NCN.filhos(sheet, NCN.LISTAS.armas)) do
                local fonte = no.deCyberware
                if fonte ~= nil and fonte ~= "" then
                    if esperadas[fonte] == nil then
                        sobrando[#sobrando+1] = no
                    else
                        esperadas[fonte] = nil      -- já existe, nada a fazer
                    end
                end
            end
            for _, no in ipairs(sobrando) do NDB.deleteNode(no) end

            for origem, a in pairs(esperadas) do
                local no = rl:append()
                if no ~= nil then
                    no.deCyberware = origem
                    no.catId, no.nome = a.nome, a.nome
                    no.categoria = "Cyberware"
                    no.dano, no.tipo = a.dano, a.tipo
                    no.classeAlcance = ""
                    no.traco = "Embutida em " .. origem
                    no.perfurante, no.rajada = false, false
                    no.preco, no.equipada = 0, false
                    no.nota = "Vem do cyberware " .. origem ..
                              ". Sai da lista sozinha se o implante for removido."
                end
            end
        end)
        NCN.__sincronizandoArmas = false
        return ok
    end

    function NCN.recalcular(sheet, self)
        if sheet == nil then return end
        if NCN.__recalculando then return end
        NCN.__recalculando = true

        local ok, err = pcall(function()
            local ef = NCN.coletarEfeitos(sheet)
            -- A arma que vem do cyberware precisa existir na lista de armas
            -- ANTES do resto: ela conta como arma equipável, e a aba Combate
            -- lê a lista, não os efeitos.
            if self ~= nil then NCN.sincronizarArmasEmbutidas(sheet, self, ef) end
            NCN.calcularAtributos(sheet, ef)
            NCN.calcularDerivados(sheet, ef)
            NCN.calcularPericias(sheet, ef)
            NCN.calcularRiqueza(sheet, ef)
            NCN.calcularOrcamento(sheet, ef)

            if self ~= nil then
                NCN.pintarCabecalho(self, sheet)
                NCN.pintarPerfil(self, sheet)
                NCN.pintarAtributos(self, sheet)
                NCN.pintarCombate(self, sheet)
                NCN.pintarCyberware(self, sheet)
                NCN.pintarTracos(self, sheet)
                NCN.pintarRiqueza(self, sheet)
                NCN.pintarNet(self, sheet)
                NCN.pintarVeiculos(self, sheet)
                NCN.pintarProgressao(self, sheet)
                NCN.pintarTrava(self, sheet)
                NCN.pintarChips(self, sheet)
                NCN.pintarBotoes(self, sheet)
                NCN.pintarAbas(self, sheet)
                NCN.ajustarGrades(self)
                -- por último: as barras espelham o que já foi calculado.
                -- Nunca antes — barra é reflexo, não fonte.
                local n = NCN.sincronizarBarras(sheet)
                NCN.txt(self.lblBarrasEstado, NCN.estadoDasBarras(sheet, n))
            end
        end)

        NCN.__recalculando = false

        if not ok and self ~= nil then
            NCN.txt(self.lblErro, "Erro no recálculo: " .. tostring(err))
            NCN.altura(self.linhaErro, 22)
        elseif self ~= nil then
            NCN.altura(self.linhaErro, 0)
        end
    end

    -- =======================================================================
    -- INICIALIZAÇÃO
    -- =======================================================================

    function NCN.preencherCombos(self, sheet)
        local function encher(ctrl, lista, campoSheet)
            local nomes, chaves = {}, {}
            for _, t in ipairs(lista) do
                nomes[#nomes+1]  = t.nome
                chaves[#chaves+1] = t.chave
            end
            -- pelo campo, não pelo valor: os combos da ficha também estão
            -- ligados a `field`, e a lista de tipos de arma não é a única que
            -- pode ganhar item novo no meio
            NCN.encherComboDeCampo(ctrl, sheet, campoSheet, nomes, chaves)
        end
        encher(self.cboRiqueza,   R.RIQUEZA,             "riquezaTier")
        encher(self.cboCobertura, R.COBERTURA,           "cenaCobertura")
        encher(self.cboAlvoCorpo, R.ALVO_CORPO,          "cenaAlvoCorpo")
        encher(self.cboAlcance,   R.FAIXAS_ALCANCE,      "cenaAlcance")
        encher(self.cboSistema,   R.SISTEMAS_NET,        "netSistema")
        encher(self.cboTerreno,   R.TERRENO_PERSEGUICAO, "terreno")
        encher(self.cboEnganoso,  R.ENGANOSO_OPCOES,     "cenaEnganoso")
    end

    function NCN.iniciar(self, sheet)
        if sheet == nil then return end

        -- Padrões só na primeira abertura. Nunca sobrescrevem o que já existe.
        for _, a in ipairs(R.ATRIBUTOS) do
            if sheet[a.chave] == nil then sheet[a.chave] = R.ATRIBUTO_BASE end
        end
        if sheet.riquezaTier       == nil then sheet.riquezaTier       = "classeMedia" end
        if sheet.cenaCobertura     == nil then sheet.cenaCobertura     = "nenhuma" end
        if sheet.cenaAlvoCorpo     == nil then sheet.cenaAlvoCorpo     = "torso" end
        if sheet.cenaAlcance       == nil then sheet.cenaAlcance       = "curta" end
        if sheet.cenaOrdinalAtaque == nil then sheet.cenaOrdinalAtaque = 1 end
        if sheet.cenaEnganoso      == nil then sheet.cenaEnganoso      = 0 end
        if sheet.cenaEmboscada     == nil then sheet.cenaEmboscada     = false end
        if sheet.netSistema        == nil then sheet.netSistema        = "corpPadrao" end
        if sheet.terreno           == nil then sheet.terreno           = "urbano" end
        if sheet.netAlerta         == nil then sheet.netAlerta         = 0 end
        if sheet.hiato             == nil then sheet.hiato             = 3 end
        if sheet.fichaFinalizada   == nil then sheet.fichaFinalizada   = false end
        if sheet.abaAtiva          == nil then sheet.abaAtiva          = NCN.ABA_PADRAO end

        NCN.migrar(sheet)
        NCN.preencherCombos(self, sheet)
        NCN.recalcular(sheet, self)
        NCN.irParaAba(self, sheet, NCN.num(sheet.abaAtiva, NCN.ABA_PADRAO))
    end

    ]]></script>

    <!-- ==================================================================
         A PÁGINA INTEIRA
         Um retângulo de fundo é o pai de tudo: é ele que dá o preto de base
         e evita a moldura cinza do sistema aparecer nas bordas.
         ================================================================== -->
    <rectangle name="fundoPagina" align="client" color="#05060A">

    <!-- ================================================================== -->
    <!-- CABEÇALHO FIXO — vale para todas as abas                           -->
    <!-- O que se olha o tempo todo não pode exigir voltar pro Perfil.       -->
    <!-- ================================================================== -->
    <rectangle name="cabecalho" align="top" height="65" color="#0E1017"
               strokeColor="#1C2130" strokeSize="1">
        <rectangle name="faixaEstado" align="top" height="2" color="#3DD68C"/>

        <layout align="left" width="330" margins="{left=12,top=5,bottom=5}">
            <label name="hdrNome" align="top" height="27" text="SEM NOME"
                   fontSize="19" fontStyle="bold" fontColor="#23E5D3" vertTextAlign="center"/>
            <label name="hdrPapel" align="top" height="18" text="" class="rot"/>
        </layout>

        <!-- Barras de vida, foco e humanidade -->
        <layout align="left" width="133" margins="{left=8,top=8,bottom=6}">
            <label align="top" height="17" text="VIDA" class="rotMin"/>
            <label name="hdrPvTxt" align="top" height="21" text="0/0"
                   fontSize="16" fontStyle="bold" fontFamily="Rajdhani" fontColor="#FF3B7F"/>
            <rectangle align="top" height="5" width="104" color="#171B26">
                <rectangle name="hdrPvBarra" align="left" width="0" color="#FF3B7F"/>
            </rectangle>
        </layout>
        <layout align="left" width="133" margins="{top=8,bottom=6}">
            <label align="top" height="17" text="FOCO NEURAL" class="rotMin"/>
            <label name="hdrFocoTxt" align="top" height="21" text="0/0"
                   fontSize="16" fontStyle="bold" fontFamily="Rajdhani" fontColor="#8A63C9"/>
            <rectangle align="top" height="5" width="104" color="#171B26">
                <rectangle name="hdrFocoBarra" align="left" width="0" color="#8A63C9"/>
            </rectangle>
        </layout>
        <layout align="left" width="133" margins="{top=8,bottom=6}">
            <label align="top" height="17" text="HUMANIDADE" class="rotMin"/>
            <label name="hdrHumTxt" align="top" height="21" text="10/10"
                   fontSize="16" fontStyle="bold" fontFamily="Rajdhani" fontColor="#23E5D3"/>
            <rectangle align="top" height="5" width="104" color="#171B26">
                <rectangle name="hdrHumBarra" align="left" width="0" color="#23E5D3"/>
            </rectangle>
        </layout>

        <!-- Estado da ficha e trava, sempre à mão -->
        <layout align="right" width="286" margins="{right=12,top=8,bottom=8}">
            <layout align="left" width="146">
                <label name="lblEstadoFicha" align="top" height="20" text="EM CRIAÇÃO"
                       class="h2" horzTextAlign="trailing"/>
                <btn acao="finalizar" texto="Finalizar ficha" al="top" w="120" h="22" m="{}" dica="Trava o que o livro só permite na criação. O que é uso de jogo continua livre."/>
            </layout>
            <miniStat id="Esquiva"    rotulo="ESQ"   cor="#23E5D3"/>
            <miniStat id="Iniciativa" rotulo="INI"   cor="#FFB03A"/>
            <miniStat id="Rd"         rotulo="RD"    cor="#8B90A6"/>
            <miniStat id="Saldo"      rotulo="PTS"   cor="#3DD68C"/>
        </layout>
    </rectangle>

    <!-- ================================================================== -->
    <!-- BARRA DE ABAS — desenhada por nós                                  -->
    <!-- O tabControl nativo não tem nenhuma propriedade de estilo: a tira   -->
    <!-- cinza do sistema brigava com todo o resto da ficha.                -->
    <!-- ================================================================== -->
    <rectangle name="barraAbas" align="top" height="32" color="#05060A">
        <abaBotao i="1"  titulo="PERFIL"/>
        <abaBotao i="2"  titulo="ATRIB / PERÍCIAS"/>
        <abaBotao i="3"  titulo="COMBATE"/>
        <abaBotao i="4"  titulo="CYBERWARE"/>
        <abaBotao i="5"  titulo="TRAÇOS"/>
        <abaBotao i="6"  titulo="EQUIPAMENTO"/>
        <abaBotao i="7"  titulo="NETRUNNING"/>
        <abaBotao i="8"  titulo="VEÍCULOS"/>
        <abaBotao i="9"  titulo="PROGRESSÃO"/>
        <abaBotao i="10" titulo="BACKGROUND"/>
    </rectangle>
    <rectangle align="top" height="1" color="#1C2130"/>

    <!-- Faixas de recusa e de erro: acima do corpo, visíveis de qualquer aba -->
    <layout name="linhaRecusa" align="top" height="0">
        <rectangle align="client" color="#2A0E18" strokeColor="#FF3B7F" strokeSize="1">
            <label name="lblRecusa" align="client" text="" class="perigo" wordWrap="true"
                   margins="{left=10,right=10,top=3,bottom=3}"/>
        </rectangle>
    </layout>
    <layout name="linhaErro" align="top" height="0">
        <label name="lblErro" align="client" text="" class="perigo" wordWrap="true"/>
    </layout>

    <!-- ================================================================== -->
    <!-- CORPO — dez painéis, um visível por vez                            -->
    <!-- ================================================================== -->
    <layout name="corpo" align="client">

    <!-- ============================== ABA 1 — PERFIL ==================== -->
    <scrollBox name="painel1" align="client" margins="{left=10,right=10,top=8,bottom=8}">

        <tituloSec titulo="IDENTIDADE" cor="#23E5D3" ajuda=""/>
        <layout align="top" height="283" margins="{top=4}">
            <rectangle align="client" color="#0E1017" strokeColor="#1C2130" strokeSize="1"
                       xradius="4" yradius="4" cornerType="bevel">
                <layout align="right" width="220" margins="{right=8,top=8,bottom=8}">
                    <image align="client" field="imagemPerfil" editable="true"
                           animate="true" style="autoFit"/>
                </layout>
                <layout align="client" margins="{left=10,right=8,top=8,bottom=8}">
                    <layout align="top" height="45">
                        <campoTxt rot="NOME" campo="nome" w="280"/>
                        <campoTxt rot="ALTER EGO / RUA" campo="alterEgo" w="180"/>
                        <layout align="client" margins="{right=6}">
                            <label align="top" height="17" text="CONCEITO — quem era antes de virar edgerunner" class="rotMin"/>
                            <rectangle align="top" height="27" color="#080A0F" strokeColor="#232B3D" strokeSize="1" xradius="2" yradius="2" cornerType="round"><edit align="client" transparent="true" margins="{left=5,right=4}" field="conceito"></edit></rectangle>
                        </layout>
                    </layout>
                    <layout align="top" height="45" margins="{top=4}">
                        <campoTxt rot="PROFISSÃO / PAPEL" campo="profissao" w="160"/>
                        <campoTxt rot="GÊNERO" campo="genero" w="110"/>
                        <campoTxt rot="IDADE" campo="idade" w="70"/>
                        <campoTxt rot="ALTURA" campo="altura" w="80"/>
                        <campoTxt rot="PESO" campo="peso" w="80"/>
                        <layout align="client" margins="{right=6}">
                            <label align="top" height="17" text="AFILIAÇÃO / GANGUE / CORP" class="rotMin"/>
                            <rectangle align="top" height="27" color="#080A0F" strokeColor="#232B3D" strokeSize="1" xradius="2" yradius="2" cornerType="round"><edit align="client" transparent="true" margins="{left=5,right=4}" field="afiliacao"></edit></rectangle>
                        </layout>
                    </layout>

                    <layout align="top" height="18" margins="{top=10}">
                        <rectangle align="left" width="2" color="#FF3B7F"/>
                        <label align="client" text="   GANCHOS PARA O MESTRE — Cap. 14, passo 8" class="h2"
                               vertTextAlign="center"/>
                    </layout>
                    <layout align="top" height="45" margins="{top=2}">
                        <campoTxt rot="UM CONTATO" campo="ganchoContato" w="240"/>
                        <campoTxt rot="UM RIVAL" campo="ganchoRival" w="240"/>
                        <layout align="client" margins="{right=6}">
                            <label align="top" height="17" text="UM SEGREDO" class="rotMin"/>
                            <rectangle align="top" height="27" color="#080A0F" strokeColor="#232B3D" strokeSize="1" xradius="2" yradius="2" cornerType="round"><edit align="client" transparent="true" margins="{left=5,right=4}" field="ganchoSegredo"></edit></rectangle>
                        </layout>
                    </layout>
                    <label name="lblEstadoTexto" align="top" height="30" text="" class="ajuda"
                           wordWrap="true" margins="{top=8,right=6}"/>
                </layout>
            </rectangle>
        </layout>

        <tituloSec titulo="SINAIS VITAIS" cor="#FF3B7F" ajuda=""/>
        <layout name="linhaHud" align="top" height="142" margins="{top=4}">
            <cardPvFoco id="Pv"   rotulo="PONTOS DE VIDA" cor="#FF3B7F"
                        campoAtual="pvAtual"   campoMax="pv"         conta="pvConta"   ajuste="ajustePv"/>
            <cardPvFoco id="Foco" rotulo="FOCO NEURAL"    cor="#8A63C9"
                        campoAtual="focoAtual" campoMax="focoNeural" conta="focoConta" ajuste="ajusteFoco"/>
            <cardValor id="Esquiva"    rotulo="ESQUIVA"     cor="#23E5D3" campo="esquiva"    conta="esquivaConta"    ajuste="ajusteEsquiva"/>
            <cardValor id="Vel"        rotulo="VEL. BÁSICA" cor="#23E5D3" campo="velBasica"  conta="velConta"        ajuste="ajusteVel"/>
            <cardValor id="Iniciativa" rotulo="INICIATIVA"  cor="#FFB03A" campo="iniciativa" conta="iniciativaConta" ajuste="ajusteIniciativa"/>
            <cardValor id="Percepcao"  rotulo="PERCEPÇÃO"   cor="#3DD68C" campo="percepcao"  conta="percepcaoConta"  ajuste="ajustePercepcao"/>
            <cardValor id="BonusDano"  rotulo="BÔNUS DE DANO" cor="#FF3B7F" campo="bonusDano" conta="bonusDanoConta" ajuste="ajusteBonusDano"/>
            <cardValor id="Humanidade" rotulo="HUMANIDADE"  cor="#FF3B7F" campo="humanidade" conta="humanidadeConta" ajuste="ajusteHumanidade"/>
        </layout>

        <faixaAviso nome="Pv" cor="#FF3B7F" fundo="#2A0E18"/>
        <faixaAviso nome="Humanidade" cor="#FFB03A" fundo="#2A2210"/>

        <layout align="top" height="26" margins="{top=4}">
            <btn acao="barrasLigar" texto="BARRAS DA MESA" al="left" w="150" h="24" m="{}"
                 dica="Espelha PV, Foco, Humanidade e Alerta nas barrinhas do seu jogador, e escreve as duas linhas ao lado do nome"/>
            <label name="lblBarrasEstado" align="left" width="330" text="" class="conta"
                   vertTextAlign="center" margins="{left=10}"/>
        </layout>

        <tituloSec titulo="PERSONALIDADE E MANEIRISMOS" cor="#8A63C9" ajuda=""/>
        <layout align="top" height="213" margins="{top=4,bottom=8}">
            <rectangle align="client" color="#0E1017" strokeColor="#1C2130" strokeSize="1">
                <rectangle align="client" color="#080A0F" strokeColor="#232B3D" strokeSize="1"
                           xradius="2" yradius="2" cornerType="round"
                           margins="{left=6,right=6,top=6,bottom=6}">
                    <textEditor align="client" field="personalidade" transparent="true"
                                margins="{left=5,right=5,top=4,bottom=4}"/>
                </rectangle>
            </rectangle>
        </layout>

    </scrollBox>

    <!-- ====================== ABA 2 — ATRIBUTOS E PERÍCIAS =============== -->
    <scrollBox name="painel2" align="none" visible="false" margins="{left=10,right=10,top=8,bottom=8}">

        <tituloSec titulo="ATRIBUTOS — Cap. 2" cor="#23E5D3" ajuda="Faixa 7 a 16. Piso de 7 sem exceções — para um personagem mais frágil, use as Desvantagens do Cap. 8, que têm efeito mecânico próprio.  ·  Faixa 7 a 16. Piso de 7 sem exceções — para um personagem mais frágil, use as Desvantagens do Cap. 8, que têm efeito mecânico próprio.  ·  Baixar um atributo abaixo de 10 devolve METADE do custo de subir a mesma distância (Cap. 2)."/>
        <layout align="top" height="16" margins="{top=2}">
            <label height="0" align="client" class="ajuda"
                   text=""/>
        </layout>
        <layout name="linhaAtributos" align="top" height="142" margins="{top=4}">
            <cardAtributo id="Cor" sigla="COR" nome="CORPO"    cor="#FF3B7F" campo="cor" custo="6"/>
            <cardAtributo id="Ref" sigla="REF" nome="REFLEXOS" cor="#23E5D3" campo="ref" custo="8"/>
            <cardAtributo id="Men" sigla="MEN" nome="MENTE"    cor="#8A63C9" campo="men" custo="7"/>
            <cardAtributo id="Von" sigla="VON" nome="VONTADE"  cor="#FFB03A" campo="von" custo="5"/>
        </layout>
        <layout align="top" height="25" margins="{top=6}">
            <label align="left" width="169" text="CUSTO DE ATRIBUTOS" class="rot" vertTextAlign="center"/>
            <label name="lblCustoAtributos" align="left" width="90" text="0 pts"
                   class="num" vertTextAlign="center"/>
            <label height="0" align="client" class="ajuda" vertTextAlign="center"
                   text=""/>
        </layout>

        <tituloSec titulo="PERÍCIAS — Cap. 3" cor="#23E5D3" ajuda="Valor-Alvo = Atributo + Nível + Modificadores. Nível 0 aplica -3 se você tentar mesmo assim. O botão /a rola 3d6 e devolve o veredito com a margem.  ·  Em jogo você paga só a diferença entre níveis: 0→1 custa 3, 1→2 custa 5, 2→3 custa 7, 3→4 custa 10 (Cap. 13)."/>
        <layout align="top" height="16" margins="{top=2}">
            <label align="client" class="ajuda"
                   text=""/>
        </layout>
        <layout align="top" height="21" margins="{top=4}">
            <rectangle align="client" color="#0A0C12">
                <!-- AS LARGURAS AQUI TÊM DE SER IDÊNTICAS ÀS DE `pericLinha`.
                     Elas já divergiram uma vez: subi a tipografia, alarguei as
                     caixas da linha e esqueci o cabeçalho — o resultado foi um
                     cabeçalho apontando para a coluna errada em 28 linhas.
                     A verificação 38 compara as duas listas. -->
                <label align="left" width="236" text="  PERÍCIA" class="cab" vertTextAlign="center"/>
                <label align="left" width="40" text="NV"  class="cab" horzTextAlign="center" vertTextAlign="center"/>
                <label align="left" width="50" text="ALVO" class="cab" horzTextAlign="center" vertTextAlign="center"/>
                <label align="left" width="40" text="AJU" class="cab" horzTextAlign="center" vertTextAlign="center"/>
                <label align="left" width="36" text="PTS" class="cab" horzTextAlign="center" vertTextAlign="center"/>
                <label align="client" text="   DE ONDE VEM O ALVO" class="cab" vertTextAlign="center"/>
                <label align="right" width="34" text="ROLA" class="cab" horzTextAlign="center" vertTextAlign="center"/>
            </rectangle>
        </layout>

        <catPericia titulo="COMBATE" cor="#FF3B7F"/>
        <pericLinha nome="Combate C.C. (Armado)"            campo="cc_armado"/>
        <pericLinha nome="Combate C.C. (Desarmado)"         campo="cc_desarmado"/>
        <pericLinha nome="Combate à Distância (Fogo)"       campo="cd_fogo"/>
        <pericLinha nome="Combate à Distância (Arco)"       campo="cd_arco"/>
        <pericLinha nome="Armas Pesadas"                    campo="armas_pesadas"/>
        <pericLinha nome="Explosivos"                       campo="explosivos"/>

        <catPericia titulo="FÍSICAS" cor="#23E5D3"/>
        <pericLinha nome="Atletismo"                        campo="atletismo"/>
        <pericLinha nome="Furtividade"                      campo="furtividade"/>
        <pericLinha nome="Prestidigitação"                  campo="prestidigitacao"/>
        <pericLinha nome="Pilotagem Terrestre"              campo="pilot_terrestre"/>
        <pericLinha nome="Pilotagem Aérea/Drones"           campo="pilot_aerea"/>
        <pericLinha nome="Condução Arriscada"               campo="conducao_arriscada"/>

        <catPericia titulo="TÉCNICAS" cor="#8A63C9"/>
        <pericLinha nome="Interface"                        campo="interface"/>
        <pericLinha nome="Eletrônica"                       campo="eletronica"/>
        <pericLinha nome="Mecânica"                         campo="mecanica"/>
        <pericLinha nome="Engenharia de Cyberware"          campo="eng_cyber"/>
        <pericLinha nome="Ciência"                          campo="ciencia"/>
        <pericLinha nome="Medicina e Primeiros Socorros"    campo="medicina"/>
        <pericLinha nome="Pesquisa e Redes"                 campo="pesquisa"/>

        <catPericia titulo="SOCIAIS" cor="#FFB03A"/>
        <pericLinha nome="Persuasão"                        campo="persuasao"/>
        <pericLinha nome="Intimidação"                      campo="intimidacao"/>
        <pericLinha nome="Enganação"                        campo="enganacao"/>
        <pericLinha nome="Manha (Streetwise)"               campo="manha"/>
        <pericLinha nome="Etiqueta Corporativa"             campo="etiqueta"/>
        <pericLinha nome="Performance"                      campo="performance"/>

        <catPericia titulo="CONHECIMENTO E PERCEPÇÃO" cor="#3DD68C"/>
        <pericLinha nome="Percepção Ativa"                  campo="percepcao_ativa"/>
        <pericLinha nome="Tática"                           campo="tatica"/>
        <pericLinha nome="Sobrevivência"                    campo="sobrevivencia"/>

        <layout align="top" height="27" margins="{top=8,bottom=8}">
            <label align="left" width="169" text="CUSTO DE PERÍCIAS" class="rot" vertTextAlign="center"/>
            <label name="lblCustoPericias" align="left" width="90" text="0 pts"
                   class="num" vertTextAlign="center"/>
            <label height="0" align="client" class="ajuda" vertTextAlign="center"
                   text=""/>
        </layout>

    </scrollBox>

    <!-- ============================== ABA 3 — COMBATE ==================== -->
    <scrollBox name="painel3" align="none" visible="false" margins="{left=10,right=10,top=8,bottom=8}">

        <tituloSec titulo="ATAQUE — Cap. 4 e Cap. 15" cor="#FF3B7F" ajuda=""/>
        <layout align="top" height="124" margins="{top=4}">
            <rectangle align="client" color="#0E1017" strokeColor="#1C2130" strokeSize="1"
                       xradius="4" yradius="4" cornerType="bevel">
                <rectangle align="top" height="2" color="#FF3B7F"/>

                <layout align="left" width="148" margins="{left=10,top=6,bottom=8}">
                    <label align="top" height="17" text="VALOR-ALVO" class="rotMin" horzTextAlign="center"/>
                    <label name="lblAlvoAtaque" align="top" height="45" text="—"
                           fontSize="32" fontStyle="bold" fontFamily="Rajdhani"
                           fontColor="#23E5D3" horzTextAlign="center" vertTextAlign="center"/>
                    <btn acao="rolarAtaque" texto="ROLAR  /a" al="top" w="120" h="24" m="{}" dica="Rola 3d6 contra o Valor-Alvo e mostra o veredito com a margem"/>
                </layout>

                <layout align="left" width="148" margins="{left=8,top=6,bottom=8}">
                    <label align="top" height="17" text="DANO DA ARMA" class="rotMin" horzTextAlign="center"/>
                    <label name="lblArmaDano" align="top" height="45" text="—"
                           fontSize="24" fontStyle="bold" fontFamily="Rajdhani"
                           fontColor="#FF3B7F" horzTextAlign="center" vertTextAlign="center"/>
                    <btn acao="rolarDano" texto="ROLAR  /d" al="top" w="120" h="24" m="{}" dica="Rola o dano e já desconta a RD do alvo, aplicando Perfurante e tiro na cabeça"/>
                </layout>

                <layout align="client" margins="{left=12,right=10,top=8,bottom=8}">
                    <label name="lblArmaAtiva" align="top" height="23" text="NENHUMA ARMA EQUIPADA"
                           fontSize="16" fontStyle="bold" fontFamily="Rajdhani" vertTextAlign="center"/>
                    <label name="lblAtaqueConta" align="top" height="32" text="" class="conta" wordWrap="true"/>
                    <layout align="top" height="27" margins="{top=2}">
                        <label align="left" width="97" text="RD DO ALVO" class="rot" vertTextAlign="center"/>
                        <rectangle align="left" width="59" color="#080A0F" strokeColor="#232B3D" strokeSize="1" xradius="2" yradius="2" cornerType="round"><edit align="client" transparent="true" margins="{left=5,right=4}" field="cenaRdAlvo" type="number" horzTextAlign="center" hint="Roupa reforçada 1 · Colete leve 2 · Tática/corp 4 · Militar pesada 6"></edit></rectangle>
                        <label align="left" width="86" text="   SUA RD" class="rot" vertTextAlign="center"/>
                        <label name="lblRdTotal" align="left" width="39" text="0"
                               class="num" horzTextAlign="center" vertTextAlign="center"/>
                        <label align="left" width="34" text="  aj" class="rotMin" vertTextAlign="center"/>
                        <rectangle align="left" width="52" color="#080A0F" strokeColor="#2A3145" strokeSize="1" xradius="3" yradius="3" cornerType="round"><edit align="client" transparent="true" margins="{left=5,right=4}" field="ajusteRd" type="number" horzTextAlign="center" hint="Ajuste manual da SUA RD. Some à armadura vestida e à RD natural do cyberware — deixe vazio se não houver caso especial."></edit></rectangle>
                        <label name="lblRdConta" align="client" text="" class="conta" vertTextAlign="center" margins="{left=6}"/>
                    </layout>
                </layout>
            </rectangle>
        </layout>

        <faixaAviso nome="Rd" cor="#FFB03A" fundo="#2A2210"/>
        <faixaAviso nome="Alcance" cor="#FFB03A" fundo="#2A2210"/>

        <tituloSec titulo="MODIFICADORES DA CENA" cor="#23E5D3" ajuda="Sangramento, Envenenado, Em Chamas e Imobilizado não somam modificador de teste — o efeito é dano ou restrição de ação, e quem aplica é o mestre. Os demais entram no /a sozinhos."/>
        <!-- O bloco respira: 150 -> 186. Eram cinco campos, sete chips e mais
             uma linha de manobra espremidos em 150px, com 6px entre fileiras.
             O problema aqui nunca foi tamanho de letra: era a distância entre
             uma coisa e a outra. -->
        <layout align="top" height="192" margins="{top=4}">
            <rectangle align="client" color="#0E1017" strokeColor="#1C2130" strokeSize="1"
                       xradius="4" yradius="4" cornerType="bevel">
                <layout align="client" margins="{left=12,right=12,top=10,bottom=10}">
                    <layout align="top" height="49">
                        <campoCombo rot="COBERTURA DO ALVO" nome="cboCobertura" campo="cenaCobertura" w="180"/>
                        <campoCombo rot="ONDE MIRAR"        nome="cboAlvoCorpo" campo="cenaAlvoCorpo" w="164"/>
                        <campoCombo rot="FAIXA DE ALCANCE"  nome="cboAlcance"   campo="cenaAlcance"   w="150"/>
                        <layout align="left" width="121" margins="{right=8}">
                            <label align="top" height="18" text="Nº DO ATAQUE" class="rotMin"/>
                            <rectangle align="top" height="29" color="#080A0F" strokeColor="#232B3D" strokeSize="1" xradius="2" yradius="2" cornerType="round"><edit align="client" transparent="true" margins="{left=5,right=4}" field="cenaOrdinalAtaque" type="number" min="1" max="3" horzTextAlign="center" hint="Limite de 3 ataques por turno (Cap. 4)"></edit></rectangle>
                        </layout>
                        <layout align="client">
                            <label align="top" height="18" text="MODIFICADOR MANUAL" class="rotMin"/>
                            <rectangle align="top" height="29" color="#080A0F" strokeColor="#232B3D" strokeSize="1" xradius="2" yradius="2" cornerType="round"><edit align="client" transparent="true" margins="{left=5,right=4}" field="cenaModManual" type="number" horzTextAlign="center" hint="Vantagem +1 a +4, desvantagem -1 a -8 (Cap. 1)"></edit></rectangle>
                        </layout>
                    </layout>
                    <layout align="top" height="31" margins="{top=12}">
                        <chk campo="cenaFurtivo" rot="furtivo" al="left" w="112" cor="#3DD68C"/>
                        <chk campo="cenaAlvoCaido" rot="alvo caído" al="left" w="118" cor="#FFB03A"/>
                        <chk campo="cenaEuCaido" rot="você caído" al="left" w="118" cor="#FF3B7F"/>
                        <chk campo="cenaSupressao" rot="sob supressão" al="left" w="132" cor="#FF3B7F"/>
                        <chk campo="cenaRajada" rot="rajada" al="left" w="100" cor="#FFB03A"/>
                        <chk campo="cenaDeVeiculo" rot="de veículo" al="left" w="120" cor="#23E5D3"/>
                        <chk campo="cenaNoMotorista" rot="mirando no motorista" al="client" w="120" cor="#23E5D3"/>
                    </layout>
                    <layout align="top" height="31" margins="{top=12}">
                        <label align="left" width="140" text="ATAQUE ENGANOSO" class="rot" vertTextAlign="center"
                               hint="Cap. 4, pág. 11-A. Você tira do seu Valor-Alvo para tirar da Reação do alvo: cada −2 seu tira −1 dela. Declare ANTES de rolar."/>
                        <rectangle align="left" width="70" color="#080A0F" strokeColor="#232B3D" strokeSize="1" xradius="2" yradius="2" cornerType="round"><label align="right" width="16" text="▾" class="rot" horzTextAlign="center" vertTextAlign="center" hitTest="false"/><comboBox align="client" transparent="true" margins="{left=5,right=4}" name="cboEnganoso" field="cenaEnganoso">
                            <event name="onChange"><![CDATA[ NCN.recalcular(sheet, self); ]]></event>
                        </comboBox></rectangle>
                        <chk campo="cenaEmboscada" rot="emboscada: alvo sem Reação" al="left" w="200" cor="#3DD68C"/>
                        <label name="lblEnganoso" align="client" text="" class="ajuda"
                               vertTextAlign="center" wordWrap="true" margins="{left=8}"/>
                    </layout>
                    <layout align="top" height="27" margins="{top=10}">
                        <chk campo="rolarDireto" rot="rolar sem a macro da mesa" al="left" w="196" cor="#8A63C9"/>
                        <label name="lblInterfaceCombate" align="client" text="" class="ajuda"
                               vertTextAlign="center" margins="{left=8}"/>
                    </layout>
                </layout>
            </rectangle>
        </layout>

        <layout align="top" height="23" margins="{top=10}">
            <rectangle align="left" width="3" color="#FFB03A"/>
            <label align="left" width="300" text="   CONDIÇÕES E ESTADOS — Cap. 5" class="h1" vertTextAlign="center"/>
            <label name="lblCondicoesAtivas" align="client" text="nenhuma condição ativa"
                   class="ajuda" horzTextAlign="trailing" vertTextAlign="center"/>
        </layout>
        <layout align="top" height="4"/>
        <condLinha chave="sangramento"  nome="Sangramento"           efeito="1 PV por rodada. Remove com Primeiros Socorros (teste simples) ou Selante de Feridas." cor="#FF3B7F"/>
        <condLinha chave="envenenado"   nome="Envenenado"            efeito="1d6/rodada ignorando RD, e -2 em testes físicos. Medicina, ou Filtro Toxicológico automaticamente." cor="#3DD68C"/>
        <condLinha chave="emChamas"     nome="Em Chamas"             efeito="2d6/rodada ignorando RD. Remove com ação dedicada, água ou lama." cor="#FFB03A"/>
        <condLinha chave="amedrontado"  nome="Amedrontado"           efeito="-2 geral. Sai quando a fonte deixa a cena, ou com nova VON bem-sucedida." cor="#8A63C9"/>
        <condLinha chave="cego"         nome="Cego (temporário)"     efeito="-6 à distância, -2 corpo a corpo. Visão Noturna ou cyberóptica anula." cor="#8B90A6"/>
        <condLinha chave="atordoado"    nome="Atordoado / Ofuscado"  efeito="Perde a Esquiva na próxima defesa e -4 em qualquer teste até o fim da próxima rodada." cor="#FF3B7F"/>
        <condLinha chave="exausto"      nome="Exausto"               efeito="-2 em Atletismo, Combate e Pilotagem. Sai com uma cena completa de descanso." cor="#FFB03A"/>
        <condLinha chave="imobilizado"  nome="Imobilizado"           efeito="Só pode tentar se soltar. Teste de escape, ou um aliado libera." cor="#8B90A6"/>
        <condLinha chave="cyberpsicose" nome="Cyberpsicose em Combate" efeito="1d6 rodadas atacando o mais próximo, +2 de dano, sem Esquiva. Persuasão -6 de um aliado interrompe." cor="#FF3B7F"/>

        <layout align="top" height="30" margins="{top=8,bottom=8}">
            <label height="0" align="client" class="ajuda" wordWrap="true"
                   text=""/>
        </layout>

    </scrollBox>

    <!-- ============================== ABA 4 — CYBERWARE ================== -->
    <scrollBox name="painel4" align="none" visible="false" margins="{left=10,right=10,top=8,bottom=8}">

        <tituloSec titulo="CYBERWARE E HUMANIDADE — Cap. 6" cor="#FF3B7F" ajuda="Humanidade não volta com XP (Cap. 13). É a única moeda do sistema que só desce."/>
        <layout align="top" height="104" margins="{top=4}">
            <rectangle align="client" color="#0E1017" strokeColor="#1C2130" strokeSize="1"
                       xradius="4" yradius="4" cornerType="bevel">
                <rectangle align="top" height="2" color="#FF3B7F"/>
                <layout align="left" width="202" margins="{left=12,top=6,bottom=6}">
                    <label align="top" height="17" text="HUMANIDADE" class="rotMin" horzTextAlign="center"/>
                    <label name="lblCyberHumanidade" align="top" height="39" text="10"
                           fontSize="30" fontStyle="bold" fontFamily="Rajdhani"
                           fontColor="#FF3B7F" horzTextAlign="center" vertTextAlign="center"/>
                    <rectangle align="top" height="5" width="169" color="#171B26">
                        <rectangle name="barraCyberHum" align="left" width="0" color="#FF3B7F"/>
                    </rectangle>
                    <label name="lblCyberConta" align="top" height="16" text="" class="conta"
                           horzTextAlign="center" margins="{top=2}"/>
                </layout>
                <layout align="client" margins="{left=12,right=10,top=8,bottom=6}">
                    <layout align="top" height="21">
                        <label align="left" width="202" text="SOMA DOS CUSTOS INSTALADOS" class="rot" vertTextAlign="center"/>
                        <label name="lblCyberSoma" align="client" text="0" class="valForte" vertTextAlign="center"/>
                    </layout>
                    <label name="lblCyberGasto" align="top" height="18" text="" class="conta"/>
                    <layout align="top" height="27" margins="{top=4}">
                        <btn acao="catCyberware" texto="+ CATÁLOGO DE CYBERWARE" al="left" w="190" h="22" m="{}" dica="Abre sempre, mesmo com a ficha finalizada"/>
                        <btn acao="novoCyberware" texto="+ linha em branco" al="left" w="140" h="22" m="{left=6}" dica="Para o implante que a mesa inventou e o livro não tem"/>
                        <label height="0" align="client" class="ajuda" vertTextAlign="center"
                               text=""/>
                    </layout>
                </layout>
            </rectangle>
        </layout>

        <faixaAviso nome="Cyber" cor="#FFB03A" fundo="#2A2210"/>

        <layout align="top" height="21" margins="{top=10}">
            <rectangle align="client" color="#0A0C12">
                <label align="left" width="230" text="  IMPLANTE" class="cab" vertTextAlign="center"/>
                <label align="left" width="59"  text="INST." class="cab" horzTextAlign="center" vertTextAlign="center"/>
                <label align="client" text="   EFEITO" class="cab" vertTextAlign="center"/>
                <layout align="right" width="290">
                    <label align="left" width="90"  text="PREÇO"  class="cab" horzTextAlign="center" vertTextAlign="center"/>
                    <label align="left" width="59"  text="HUMAN." class="cab" horzTextAlign="center" vertTextAlign="center"/>
                    <label align="left" width="146" text="TIPO"   class="cab" horzTextAlign="center" vertTextAlign="center"/>
                    <label align="left" width="30"  text=""       class="cab"/>
                </layout>
            </rectangle>
        </layout>
        <layout name="linhaCyberVazio" align="top" height="0">
            <label name="lblCyberVazio" align="client" text="" class="ajuda" wordWrap="true" margins="{left=4,top=6}"/>
        </layout>
        <recordList name="listaCyberware" align="top" field="cyberware"
                    templateForm="itemCyberware" autoHeight="true" minQt="0" margins="{top=3,bottom=8}"/>

    </scrollBox>

    <!-- ============================== ABA 5 — TRAÇOS ===================== -->
    <scrollBox name="painel5" align="none" visible="false" margins="{left=10,right=10,top=8,bottom=8}">

        <layout align="top" height="23">
            <rectangle align="left" width="3" color="#23E5D3"/>
            <label align="left" width="300" text="   VANTAGENS — Cap. 8" class="h1" vertTextAlign="center"/>
