                    <btn acao="rolarPerseguicao" texto="ROLAR  /a" al="top" w="120" h="22" m="{}" dica=""/>
                </layout>

                <layout align="client" margins="{left=12,right=10,top=8,bottom=6}">
                    <layout align="top" height="43">
                        <campoCombo rot="TERRENO" nome="cboTerreno" campo="terreno" w="220"/>
                        <layout align="left" width="124" margins="{right=8}">
                            <label align="top" height="17" text="MOD. MANUAL" class="rotMin"/>
                            <rectangle align="top" height="25" color="#080A0F" strokeColor="#232B3D" strokeSize="1" xradius="2" yradius="2" cornerType="round"><edit align="client" transparent="true" margins="{left=5,right=4}" field="perseguicaoModManual" type="number" horzTextAlign="center"></edit></rectangle>
                        </layout>
                        <layout align="client">
                            <label align="top" height="17" text=" " class="rotMin"/>
                            <btn acao="choque" texto="CHOQUE (1d6) — falha crítica" al="top" w="120" h="22" m="{}" dica="Falha crítica de qualquer um dos dois: Choque imediato, não importa o Hiato"/>
                        </layout>
                    </layout>
                    <label name="lblVeiculoAtivo"     align="top" height="20" text="" class="valForte"/>
                    <label name="lblPerseguicaoConta" align="top" height="16" text="" class="conta" wordWrap="true"/>
                    <label name="lblHiatoTexto"       align="top" height="16" text="" class="ajuda" wordWrap="true"/>
                </layout>
            </rectangle>
        </layout>

        <tituloSec titulo="GARAGEM" cor="#3DD68C" ajuda="Marque um como ativo: é ele que entra no teste de perseguição.  ·  Marque um como ativo: é ele que entra no teste de perseguição.  ·  Atirar de veículo em movimento: -2 mais a penalidade de Hiato. Dano em quem não é o motorista vai pra Estrutura. Mirar no motorista custa -4 a mais, e a RD do veículo ainda reduz o dano separadamente. Colisão (Ram): 2d6 + 1d6 a cada 2 pontos de diferença de VEL, na Estrutura dos dois."/>
        <layout align="top" height="30" margins="{top=4}">
            <btn acao="catVeiculo" texto="+ CATÁLOGO DE VEÍCULOS" al="left" w="180" h="22" m="{}" dica=""/>
            <btn acao="novoVeiculo" texto="+ linha em branco" al="left" w="140" h="22" m="{left=6}" dica=""/>
            <label height="0" align="client" class="ajuda" vertTextAlign="center"
                   text=""/>
        </layout>
        <layout align="top" height="21" margins="{top=6}">
            <rectangle align="client" color="#0A0C12">
                <label align="left" width="210" text="  VEÍCULO" class="cab" vertTextAlign="center"/>
                <label align="left" width="59"  text="ATIVO" class="cab" horzTextAlign="center" vertTextAlign="center"/>
                <label align="client" text="  NOTA" class="cab" vertTextAlign="center"/>
                <layout align="right" width="336">
                    <label align="left" width="59"  text="VEL"       class="cab" horzTextAlign="center" vertTextAlign="center"/>
                    <label align="left" width="59"  text="MAN"       class="cab" horzTextAlign="center" vertTextAlign="center"/>
                    <label align="left" width="113" text="ESTRUTURA" class="cab" horzTextAlign="center" vertTextAlign="center"/>
                    <label align="left" width="52"  text="RD"        class="cab" horzTextAlign="center" vertTextAlign="center"/>
                    <label align="left" width="68"  text="PREÇO"     class="cab" horzTextAlign="center" vertTextAlign="center"/>
                    <label align="left" width="30"  text=""          class="cab"/>
                </layout>
            </rectangle>
        </layout>
        <recordList name="listaVeiculos" align="top" field="veiculos"
                    templateForm="itemVeiculo" autoHeight="true" minQt="0" margins="{top=3}"/>

        <layout align="top" height="39" margins="{top=10,bottom=8}">
            <label height="0" align="client" class="ajuda" wordWrap="true"
                   text=""/>
        </layout>

    </scrollBox>

    <!-- ========================== ABA 9 — PROGRESSÃO ===================== -->
    <scrollBox name="painel9" align="none" visible="false" margins="{left=10,right=10,top=8,bottom=8}">

        <tituloSec titulo="ORÇAMENTO — Cap. 14" cor="#3DD68C" ajuda=""/>
        <layout align="top" height="119" margins="{top=4}">
            <rectangle align="client" color="#0E1017" strokeColor="#1C2130" strokeSize="1"
                       xradius="4" yradius="4" cornerType="bevel">
                <rectangle align="top" height="2" color="#3DD68C"/>
                <layout align="left" width="198" margins="{left=12,top=8,bottom=8}">
                    <label align="top" height="17" text="SALDO" class="rotMin" horzTextAlign="center"/>
                    <label name="lblSaldo" align="top" height="52" text="80"
                           fontSize="40" fontStyle="bold" fontFamily="Rajdhani"
                           fontColor="#23E5D3" horzTextAlign="center" vertTextAlign="center"/>
                    <rectangle align="top" height="5" width="169" color="#171B26">
                        <rectangle name="barraGasto" align="left" width="0" color="#23E5D3"/>
                    </rectangle>
                </layout>
                <layout align="client" margins="{left=12,right=10,top=10,bottom=8}">
                    <layout align="top" height="25">
                        <label align="left" width="113" text="DISPONÍVEIS" class="rot" vertTextAlign="center"/>
                        <label name="lblDisponivel" align="left" width="68" text="80" class="num" vertTextAlign="center"/>
                        <label align="left" width="79" text="GASTOS" class="rot" vertTextAlign="center"/>
                        <label name="lblGastos" align="client" text="0" class="num" vertTextAlign="center"/>
                    </layout>
                    <label name="lblOrcamentoConta" align="top" height="16" text="" class="conta" wordWrap="true"/>
                    <label name="lblGastoConta"     align="top" height="16" text="" class="conta" wordWrap="true"/>
                    <label name="lblGuia"           align="top" height="16" text="" class="ajuda" wordWrap="true"/>
                </layout>
            </rectangle>
        </layout>

        <faixaAviso nome="Saldo" cor="#FF3B7F" fundo="#2A0E18"/>

        <tituloSec titulo="EXPERIÊNCIA — Cap. 13" cor="#FFB03A" ajuda="Faixa típica: 2 a 5 XP por sessão. Perícias pagam só a diferença entre níveis; atributos pagam a diferença de custo mas exigem uma cena de treino. Humanidade não se recupera com XP."/>
        <layout align="top" height="81" margins="{top=4}">
            <rectangle align="client" color="#0E1017" strokeColor="#1C2130" strokeSize="1">
                <layout align="client" margins="{left=10,right=10,top=6,bottom=6}">
                    <layout align="top" height="43">
                        <layout align="left" width="169" margins="{right=10}">
                            <label align="top" height="17" text="XP TOTAL GANHO" class="rotMin"/>
                            <rectangle align="top" height="25" color="#080A0F" strokeColor="#232B3D" strokeSize="1" xradius="2" yradius="2" cornerType="round"><edit align="client" transparent="true" margins="{left=5,right=4}" field="xpGanho" type="number" horzTextAlign="center" hint="2 por sessão, +1 por objetivo, +1 por interpretação, +1 por risco genuíno"></edit></rectangle>
                        </layout>
                        <layout align="left" width="191" margins="{right=10}">
                            <label align="top" height="17" text="AJUSTE MANUAL (MESTRE)" class="rotMin"/>
                            <rectangle align="top" height="25" color="#080A0F" strokeColor="#232B3D" strokeSize="1" xradius="2" yradius="2" cornerType="round"><edit align="client" transparent="true" margins="{left=5,right=4}" field="ajustePontos" type="number" horzTextAlign="center" hint="Pontos concedidos fora da tabela — a válvula de escape do mestre"></edit></rectangle>
                        </layout>
                        <layout align="left" width="169" margins="{right=10}">
                            <label align="top" height="17" text="REGISTRO" class="rotMin"/>
                            <btn acao="sessaoXp" texto="+ SESSÃO (2 XP)" al="top" w="120" h="22" m="{}" dica=""/>
                        </layout>
                        <label height="0" align="client" class="ajuda" vertTextAlign="center"
                               text=""/>
                    </layout>
                </layout>
            </rectangle>
        </layout>
        <recordList name="listaXp" align="top" field="xpLog"
                    templateForm="itemXp" autoHeight="true" minQt="0" margins="{top=4}"/>

        <tituloSec titulo="CURA E DESCANSO — Cap. 11" cor="#23E5D3" ajuda="Descanso completo recupera metade do PV máximo (arredondando pra cima) e todo o Foco Neural — exceto dano neural permanente de Flatline. Reconstituição Rápida dobra esses valores.  ·  Descanso completo recupera metade do PV máximo (arredondando pra cima) e todo o Foco Neural — exceto dano neural permanente de Flatline. Reconstituição Rápida dobra esses valores."/>
        <layout align="top" height="68" margins="{top=4,bottom=8}">
            <rectangle align="client" color="#0E1017" strokeColor="#1C2130" strokeSize="1">
                <layout align="client" margins="{left=10,right=10,top=6,bottom=6}">
                    <layout align="top" height="25">
                        <btn acao="curaCena" texto="CENA CURTA: +1 PV" al="left" w="160" h="20" m="{}" dica=""/>
                        <btn acao="curaDescanso" texto="DESCANSO COMPLETO (metade do PV)" al="left" w="220" h="20" m="{left=6}" dica=""/>
                        <btn acao="curaRepouso" texto="REPOUSO TOTAL: PV CHEIO" al="left" w="180" h="20" m="{left=6}" dica=""/>
                    </layout>
                    <label align="top" height="0" class="ajuda" wordWrap="true"
                           text=""/>
                </layout>
            </rectangle>
        </layout>

    </scrollBox>

    <!-- ========================== ABA 10 — BACKGROUND ==================== -->
    <scrollBox name="painel10" align="none" visible="false" margins="{left=10,right=10,top=8,bottom=8}">
        <tituloSec titulo="BACKGROUND E ANOTAÇÕES" cor="#8B90A6" ajuda=""/>
        <rectangle align="client" color="#0E1017" strokeColor="#1C2130" strokeSize="1"
                   margins="{top=4,bottom=4}">
            <richEdit align="client" field="background" backgroundColor="#080A0F"
                      defaultFontColor="#E8EAF2" animateImages="true"
                      margins="{left=4,right=4,top=4,bottom=4}"/>
        </rectangle>
    </scrollBox>

    </layout>
    </rectangle>

    <!-- ================================================================== -->
    <!-- CATÁLOGO — um popup só, para os oito catálogos do livro.           -->
    <!-- ABRE SEMPRE, inclusive com a ficha finalizada: consultar o dado do  -->
    <!-- próprio equipamento no meio do turno não pode depender de trava.    -->
    <!-- Quem trava é o botão de ADICIONAR, e ele diz por quê.               -->
    <!-- ================================================================== -->
    <popup name="popCatalogo" width="820" height="605" backOpacity="0.65">
        <rectangle align="client" color="#05060A" strokeColor="#23E5D3" strokeSize="1">
            <rectangle align="top" height="2" color="#23E5D3"/>

            <layout align="top" height="34" margins="{left=12,right=12,top=8}">
                <btn acao="catFechar" texto="fechar" al="right" w="80" h="24" m="{}" dica=""/>
                <label name="lblCatTitulo" align="client" text="CATÁLOGO" class="h1"
                       fontSize="14" vertTextAlign="center"/>
            </layout>

            <layout align="top" height="48" margins="{left=12,right=12,top=2}">
                <layout name="colCatCategoria" align="left" width="280" margins="{right=10}">
                    <label align="top" height="17" text="CATEGORIA" class="rotMin"/>
                    <rectangle align="top" height="27" color="#080A0F" strokeColor="#232B3D" strokeSize="1" xradius="2" yradius="2" cornerType="round"><label align="right" width="16" text="▾" class="rot" horzTextAlign="center" vertTextAlign="center" hitTest="false"/><comboBox align="client" transparent="true" margins="{left=5,right=4}" name="cboCatCategoria" field="catalogoCategoria">
                        <event name="onChange"><![CDATA[
                            NCN.preencherItensCatalogo(self, sheet);
                        ]]></event>
                    </comboBox></rectangle>
                </layout>
                <layout align="client">
                    <label align="top" height="17" text="ITEM" class="rotMin"/>
                    <rectangle align="top" height="27" color="#080A0F" strokeColor="#232B3D" strokeSize="1" xradius="2" yradius="2" cornerType="round"><label align="right" width="16" text="▾" class="rot" horzTextAlign="center" vertTextAlign="center" hitTest="false"/><comboBox align="client" transparent="true" margins="{left=5,right=4}" name="cboCatItem" field="catalogoItem">
                        <event name="onChange"><![CDATA[
                            NCN.pintarDetalheCatalogo(self, sheet);
                        ]]></event>
                    </comboBox></rectangle>
                </layout>
            </layout>

            <layout align="bottom" height="45" margins="{left=12,right=12,bottom=10}">
                <btn acao="catAdicionar" texto="ADICIONAR À FICHA" al="right" w="210" h="28" m="{}" dica="Copia os valores do livro para a ficha. Depois de adicionado, tudo continua editável."/>
                <label align="client" class="ajuda" vertTextAlign="center" wordWrap="true"
                       text="O item copia os valores do livro e passa a viver por conta própria — dá pra ajustar preço, dano ou efeito sem perder o vínculo com o catálogo."/>
            </layout>

            <layout name="linhaCatAviso" align="bottom" height="0" margins="{left=12,right=12,bottom=4}">
                <rectangle align="client" color="#2A0E18" strokeColor="#FF3B7F" strokeSize="1">
                    <label name="lblCatAviso" align="client" text="" class="perigo" wordWrap="true"
                           margins="{left=8,right=8,top=3,bottom=3}"/>
                </rectangle>
            </layout>

            <scrollBox align="client" margins="{left=12,right=12,top=6,bottom=4}">
                <rectangle align="top" height="1" color="#1C2130"/>
                <label name="lblCatNome" align="top" height="32" text="—"
                       fontSize="17" fontStyle="bold" fontColor="#23E5D3"
                       vertTextAlign="center" margins="{top=4}"/>
                <linhaCat i="1"/>
                <linhaCat i="2"/>
                <linhaCat i="3"/>
                <linhaCat i="4"/>
                <linhaCat i="5"/>
                <linhaCat i="6"/>
                <linhaCat i="7"/>
            </scrollBox>
        </rectangle>
    </popup>

    <!-- ================================================================== -->
    <!-- TEMPLATES                                                          -->
    <!-- ================================================================== -->

    <!-- Botão da barra de abas. O clique fica no retângulo; o texto e a marca
         levam hitTest="false" para não engolir o clique no caminho. -->
    <template name="abaBotao">
        <layout name="wrapAba$(i)" align="left" width="133" margins="{right=1}">
            <rectangle name="fundoAba$(i)" align="client" color="#05060A" cursor="handPoint"
                       hint="$(titulo)">
                <rectangle name="marcaAba$(i)" align="top" height="1" color="#1C2130" hitTest="false"/>
                <label name="txtAba$(i)" align="client" text="$(titulo)" class="aba"
                       horzTextAlign="center" vertTextAlign="center" hitTest="false"/>
                <event name="onClick"><![CDATA[ NCN.irParaAba(self, sheet, $(i)); ]]></event>
            </rectangle>
        </layout>
    </template>

    <!-- BOTÃO DESENHADO.
         `button` do SDK não tem `transparent` nem cor de fundo: herda só
         propriedades de fonte, e a caixa cinza do sistema fica. Como um
         retângulo não sabe receber código diferente a cada uso de um template,
         cada botão carrega uma CHAVE e o despacho acontece em NCN.ACOES —
         o que ainda põe toda a lógica de clique em Lua, onde dá para testar. -->
    <template name="btn">
        <layout name="wrapBt$(acao)" align="$(al)" width="$(w)" height="$(h)" margins="$(m)">
            <rectangle name="btBt$(acao)" align="client" color="#141A26" strokeColor="#2A3145"
                       strokeSize="1" xradius="3" yradius="3" cornerType="round"
                       cursor="handPoint" hint="$(dica)">
                <label name="txtBt$(acao)" align="client" text="$(texto)" class="aba"
                       horzTextAlign="center" vertTextAlign="center" hitTest="false"/>
                <event name="onClick"><![CDATA[ NCN.acao(self, sheet, "$(acao)"); ]]></event>
            </rectangle>
        </layout>
    </template>

    <!-- CHIP LIGA/DESLIGA. Substitui o checkBox do sistema, que também não é
         estilizável. O estado é a cor do bloco inteiro, não um risco de oito
         pixels — atravessa a mesa inteira de relance.
         O texto era 10px, menor que qualquer outra coisa da ficha: um chip é
         controle que se clica no meio do turno, não nota de rodapé. -->
    <template name="chk">
        <layout name="wrapChk$(campo)" align="$(al)" width="$(w)" margins="{right=4,top=2,bottom=2}">
            <rectangle name="chipChk$(campo)" align="client" color="#080A0F"
                       strokeColor="#2A3145" strokeSize="1" xradius="3" yradius="3"
                       cornerType="round" cursor="handPoint" hint="$(rot)">
                <label name="txtChk$(campo)" align="client" text="$(rot)" class="val"
                       fontSize="13" horzTextAlign="center" vertTextAlign="center" hitTest="false"/>
                <event name="onClick"><![CDATA[
                    NCN.alternar(self, sheet, "$(campo)", "$(cor)");
                ]]></event>
            </rectangle>
        </layout>
    </template>

    <!-- Número pequeno do cabeçalho: sempre visível, em qualquer aba -->
    <template name="miniStat">
        <layout align="left" width="43" margins="{left=4}">
            <label align="top" height="17" text="$(rotulo)" class="rotMin" horzTextAlign="center"/>
            <label name="hdr$(id)" align="top" height="27" text="0"
                   fontSize="19" fontStyle="bold" fontFamily="Rajdhani" fontColor="$(cor)"
                   horzTextAlign="center" vertTextAlign="center"/>
        </layout>
    </template>

    <!-- Título de seção com barra de cor à esquerda -->
    <!-- O título da seção carrega a explicação no `hint`: é o único elemento
         que existe uma vez por bloco e está sempre visível. Assim a frase de
         ajuda sai da tela sem sair da ficha — quem é novo na mesa passa o mouse
         no título e lê; quem já joga há seis sessões não lê a mesma frase toda
         vez que abre a aba. -->
    <template name="tituloSec">
        <layout align="top" height="24" margins="{top=10}">
            <rectangle align="left" width="3" color="$(cor)"/>
            <label align="client" text="   $(titulo)" class="h1" vertTextAlign="center"
                   hint="$(ajuda)"/>
        </layout>
    </template>

    <!-- Campo de texto com rótulo em cima: todos nascem na mesma altura, e é
         isso que faz a fileira inteira fechar alinhada -->
    <template name="campoTxt">
        <layout align="left" width="$(w)" margins="{right=8}">
            <label align="top" height="17" text="$(rot)" class="rotMin"/>
            <rectangle align="top" height="27" color="#080A0F" strokeColor="#232B3D" strokeSize="1" xradius="2" yradius="2" cornerType="bevel"><edit align="client" transparent="true" margins="{left=5,right=4}" field="$(campo)"></edit></rectangle>
        </layout>
    </template>

    <template name="campoTxtClient">
        <layout align="client" margins="{right=8}">
            <label align="top" height="17" text="$(rot)" class="rotMin"/>
            <rectangle align="top" height="27" color="#080A0F" strokeColor="#232B3D" strokeSize="1" xradius="2" yradius="2" cornerType="bevel"><edit align="client" transparent="true" margins="{left=5,right=4}" field="$(campo)"></edit></rectangle>
        </layout>
    </template>

    <template name="campoCombo">
        <layout align="left" width="$(w)" margins="{right=8}">
            <label align="top" height="17" text="$(rot)" class="rotMin"/>
            <rectangle align="top" height="25" color="#080A0F" strokeColor="#232B3D" strokeSize="1" xradius="2" yradius="2" cornerType="round"><label align="right" width="16" text="▾" class="rot" horzTextAlign="center" vertTextAlign="center" hitTest="false"/><comboBox align="client" transparent="true" margins="{left=5,right=4}" name="$(nome)" field="$(campo)"></comboBox></rectangle>
        </layout>
    </template>

    <!-- Faixa de aviso: nasce com altura 0 e o script a abre quando há o que
         dizer. Reservar o espaço evita a página inteira pular ao aparecer. -->
    <template name="faixaAviso">
        <layout name="linha$(nome)Aviso" align="top" height="0" margins="{top=4}">
            <rectangle align="client" color="$(fundo)" strokeColor="$(cor)" strokeSize="1">
                <label name="lbl$(nome)Aviso" align="client" text="" class="aviso" wordWrap="true"
                       margins="{left=8,right=8,top=3,bottom=3}"/>
            </rectangle>
        </layout>
    </template>

    <!-- Card de valor derivado: faixa de cor, rótulo, valor, a conta, ajuste -->
    <template name="cardValor">
        <layout name="wrapHud$(id)" align="left" width="145" margins="{right=6}">
            <rectangle align="client" color="#0E1017" strokeColor="#1C2130" strokeSize="1"
                       xradius="4" yradius="4" cornerType="bevel">
                <rectangle align="top" height="3" color="$(cor)"/>
                <label align="top" height="16" text="$(rotulo)" class="rotMin"
                       horzTextAlign="center" margins="{top=5}"/>
                <rectangle align="top" height="58" color="#12141C" strokeColor="#232B3D"
                           strokeSize="1" xradius="3" yradius="3" cornerType="bevel"
                           margins="{left=10,right=10,top=1}">
                    <label name="hud$(id)" align="client" field="$(campo)" text="0"
                           fontSize="30" fontStyle="bold" fontFamily="Rajdhani" fontColor="$(cor)"
                           horzTextAlign="center" vertTextAlign="center" hitTest="false"/>
                </rectangle>
                <label align="top" height="20" field="$(conta)" class="conta"
                       horzTextAlign="center" wordWrap="true" margins="{top=6}"/>
                <layout align="top" height="24" margins="{left=8,right=8,bottom=6}">
                    <label align="left" width="30" text="aj" class="rotMin" vertTextAlign="center"/>
                    <rectangle align="client" color="#080A0F" strokeColor="#2A3145" strokeSize="1" xradius="3" yradius="3" cornerType="bevel"><edit align="client" transparent="true" margins="{left=5,right=4}" field="$(ajuste)" type="number" horzTextAlign="center" hint="A válvula de escape: o caso que o livro não previu entra aqui."></edit></rectangle>
                </layout>
            </rectangle>
        </layout>
    </template>

    <!-- Card com atual/máximo: PV e Foco Neural -->
    <template name="cardPvFoco">
        <layout name="wrapHud$(id)" align="left" width="145" margins="{right=6}">
            <rectangle align="client" color="#0E1017" strokeColor="#1C2130" strokeSize="1"
                       xradius="4" yradius="4" cornerType="bevel">
                <rectangle align="top" height="3" color="$(cor)"/>
                <label align="top" height="16" text="$(rotulo)" class="rotMin"
                       horzTextAlign="center" margins="{top=5}"/>

                <layout align="top" height="16" margins="{left=10,right=10}">
                    <label align="left" width="62" text="ATUAL"  class="rotMin" horzTextAlign="center"/>
                    <label align="client"         text="MÁXIMO" class="rotMin" horzTextAlign="center"/>
                </layout>
                <layout align="top" height="32" margins="{left=10,right=10,top=1}">
                    <rectangle align="left" width="62" color="#080A0F" strokeColor="#2A3145" strokeSize="1" xradius="3" yradius="3" cornerType="round"><edit align="client" transparent="true" margins="{left=4,right=4}" name="hud$(id)Atual" field="$(campoAtual)" type="number" fontSize="24" fontStyle="bold" fontFamily="Rajdhani" horzTextAlign="center" fontColor="#FFFFFF" hint="Valor atual — livre mesmo com a ficha finalizada"></edit></rectangle>
                    <label align="client" field="$(campoMax)" fontSize="24" fontStyle="bold"
                           fontFamily="Rajdhani" fontColor="$(cor)"
                           horzTextAlign="center" vertTextAlign="center"/>
                </layout>

                <progressBar name="barra$(id)" align="top" height="7" color="$(cor)"
                             field="$(campoAtual)" fieldMax="$(campoMax)" min="0"
                             margins="{left=10,right=10,top=6}"/>

                <label align="top" height="20" field="$(conta)" class="conta"
                       horzTextAlign="center" wordWrap="true" margins="{top=3}"/>
                <layout align="top" height="24" margins="{left=8,right=8,bottom=6}">
                    <label align="left" width="30" text="aj" class="rotMin" vertTextAlign="center"/>
                    <rectangle align="client" color="#080A0F" strokeColor="#2A3145" strokeSize="1" xradius="3" yradius="3" cornerType="bevel"><edit align="client" transparent="true" margins="{left=5,right=4}" field="$(ajuste)" type="number" horzTextAlign="center"></edit></rectangle>
                </layout>
            </rectangle>
        </layout>
    </template>

    <!-- Card de atributo: comprado + bônus = total, com o custo e a conta -->
        <!-- Card de atributo: comprado + bônus = total, com o custo e o /a.
         O texto "pts por ponto acima de 10" e a conta do custo saíram da tela e
         vivem no hint do card: eram a mesma informação do número ao lado,
         repetida em quatro cards.

         NAO PONHA COMENTARIO DENTRO DE <template>. O rdk nao os ignora: ele
         expande o corpo inteiro para Lua, e o texto do comentario vira codigo.
         Quebrou duas vezes seguidas aqui — primeiro no $(placeholder) que eu
         havia citado, depois nas aspas do proprio comentario. Comentario de
         template mora AQUI FORA, como todos os outros deste arquivo.
         Verificacao 40. -->
<template name="cardAtributo">
        <layout name="wrapAtrib$(id)" align="left" width="213" margins="{right=6}">
            <rectangle align="client" color="#0E1017" strokeColor="#1C2130" strokeSize="1"
                       xradius="4" yradius="4" cornerType="round"
                       hint="$(nome) custa $(custo) pontos por ponto acima de 10. Faixa 7 a 16; baixar abaixo de 10 devolve METADE do custo de subir a mesma distância (Cap. 2). O BÔNUS não tem teto: é por ele que cyberware e traço passam de 16.">
                <rectangle align="top" height="3" color="$(cor)"/>

                <layout align="top" height="20" margins="{left=10,right=10,top=5}">
                    <label align="left" width="52" text="$(sigla)" fontSize="16" fontStyle="bold"
                           fontFamily="Rajdhani" fontColor="$(cor)" vertTextAlign="center"/>
                    <label align="client" text="$(nome)" class="rotMin"
                           horzTextAlign="trailing" vertTextAlign="center"/>
                </layout>

                <layout align="top" height="48" margins="{left=10,right=10,top=4}">
                    <layout align="left" width="56">
                        <label align="top" height="16" text="BASE" class="rotMin" horzTextAlign="center"/>
                        <rectangle align="top" height="32" color="#080A0F" strokeColor="#2A3145" strokeSize="1" xradius="3" yradius="3" cornerType="round"><edit align="client" transparent="true" margins="{left=4,right=4}" name="ed$(id)" field="$(campo)" type="number" min="7" max="16" fontSize="24" fontStyle="bold" fontFamily="Rajdhani" horzTextAlign="center" hint="Valor comprado. Piso de 7 e teto de 16 (Cap. 2)."></edit></rectangle>
                    </layout>
                    <label align="left" width="14" text="+" class="rot"
                           horzTextAlign="center" vertTextAlign="center" margins="{top=14}"/>
                    <layout align="left" width="56">
                        <label align="top" height="16" text="BÔNUS" class="rotMin" horzTextAlign="center"/>
                        <rectangle align="top" height="32" color="#080A0F" strokeColor="#2A3145" strokeSize="1" xradius="3" yradius="3" cornerType="round"><edit align="client" transparent="true" margins="{left=4,right=4}" field="bonus$(id)" type="number" fontSize="24" fontStyle="bold" fontFamily="Rajdhani" horzTextAlign="center" fontColor="#9AA0B8" hint="Sem teto: é por aqui que cyberware, traço e o mestre passam do 16."></edit></rectangle>
                    </layout>
                    <label align="left" width="14" text="=" class="rot"
                           horzTextAlign="center" vertTextAlign="center" margins="{top=14}"/>
                    <layout align="client">
                        <label align="top" height="16" text="TOTAL" class="rotMin" horzTextAlign="center"/>
                        <rectangle name="painelTotal$(id)" align="top" height="32" color="#12141C"
                                   strokeColor="$(cor)" strokeSize="1" xradius="3" yradius="3" cornerType="round">
                            <label name="lblTotal$(id)" align="client" text="10" fontSize="24"
                                   fontStyle="bold" fontFamily="Rajdhani" fontColor="$(cor)"
                                   horzTextAlign="center" vertTextAlign="center" hitTest="false"/>
                        </rectangle>
                    </layout>
                </layout>

                <layout align="top" height="24" margins="{left=10,right=10,top=5}">
                    <label align="left" width="42" text="custo" class="rotMin" vertTextAlign="center"/>
                    <label name="lblCusto$(id)" align="left" width="44" text="0" class="valForte"
                           vertTextAlign="center"/>
                    <rectangle name="btAtr$(id)" align="right" width="46" color="#141A26"
                               strokeColor="#2A3145" strokeSize="1" xradius="3" yradius="3"
                               cornerType="round" cursor="handPoint"
                               hint="Rola 3d6 contra o atributo puro, pela macro /a da mesa">
                        <label align="client" text="/a" class="aba" fontColor="$(cor)"
                               horzTextAlign="center" vertTextAlign="center" hitTest="false"/>
                        <event name="onClick"><![CDATA[
                            NCN.rolarTeste(sheet, NCN.num(sheet.total$(id)),
                                           "Teste de $(nome)", "$(sigla) puro, sem perícia");
                        ]]></event>
                    </rectangle>
                    <label align="client" text="" class="rotMin"
                           horzTextAlign="trailing" vertTextAlign="center" margins="{right=8}"/>
                </layout>

                <label name="lblConta$(id)" align="top" height="0" text="" class="conta"
                       horzTextAlign="center" wordWrap="true" margins="{left=6,right=6,bottom=6}"/>
            </rectangle>
        </layout>
    </template>

    <!-- Cabeçalho de categoria de perícia -->
    <template name="catPericia">
        <layout align="top" height="23" margins="{top=8,bottom=1}">
            <rectangle align="left" width="3" color="$(cor)"/>
            <label align="client" text="   $(titulo)" class="h2" vertTextAlign="center"/>
        </layout>
    </template>

    <!-- Linha de perícia: nível, Valor-Alvo, ajuste, custo, a conta e o /a -->
    <template name="pericLinha">
        <layout align="top" height="29" margins="{bottom=1}">
            <rectangle name="fundo_$(campo)" align="client" color="#080A0F"
                       strokeColor="#1C2130" strokeSize="1">
                <label name="nome_$(campo)" align="left" width="236" text="  $(nome)"
                       class="val" vertTextAlign="center"/>
                <rectangle align="left" width="40" color="#080A0F" strokeColor="#232B3D" strokeSize="1" xradius="2" yradius="2" cornerType="round"><edit align="client" transparent="true" margins="{left=5,right=4}" name="nivel_$(campo)" field="$(campo)_nivel" type="number" min="0" max="4" horzTextAlign="center" hint="Nível 0 a 4. O nível 1 apenas zera o −3 de destreinado; o bônus começa no 2 e para em +3 (Cap. 3)."></edit></rectangle>
                <label name="alvo_$(campo)" align="left" width="50" field="$(campo)_alvo"
                       fontSize="19" fontStyle="bold" fontFamily="Rajdhani" fontColor="#FF3B7F"
                       horzTextAlign="center" vertTextAlign="center"/>
                <rectangle align="left" width="40" color="#080A0F" strokeColor="#232B3D" strokeSize="1" xradius="2" yradius="2" cornerType="round"><edit align="client" transparent="true" margins="{left=5,right=4}" field="$(campo)_ajuste" type="number" horzTextAlign="center" hint="Ajuste manual permanente desta perícia. A válvula de escape: o caso que o livro não previu entra aqui."></edit></rectangle>
                <label align="left" width="36" field="$(campo)_custo" class="conta"
                       horzTextAlign="center" vertTextAlign="center"/>
                <rectangle name="btRolar_$(campo)" align="right" width="34" color="#141A26"
                           strokeColor="#2A3145" strokeSize="1" cursor="handPoint"
                           hint="Rola 3d6 contra o Valor-Alvo pela macro /a da mesa">
                    <label align="client" text="/a" class="aba" fontColor="#23E5D3"
                           horzTextAlign="center" vertTextAlign="center" hitTest="false"/>
                    <event name="onClick"><![CDATA[
                        NCN.rolarTeste(sheet, NCN.num(sheet.$(campo)_alvo),
                                       "$(nome)", sheet.$(campo)_conta);
                    ]]></event>
                </rectangle>
                <label name="conta_$(campo)" align="client" field="$(campo)_conta" class="conta"
                       vertTextAlign="center" margins="{left=8}"/>
            </rectangle>
        </layout>
        <dataLink field="$(campo)_nivel">
            <event name="onChange"><![CDATA[ NCN.recalcular(sheet, self); ]]></event>
        </dataLink>
        <dataLink field="$(campo)_ajuste">
            <event name="onChange"><![CDATA[ NCN.recalcular(sheet, self); ]]></event>
        </dataLink>
    </template>

    <!-- Linha de condição do Cap. 5. O chip acende na cor da condição: numa
         lista de nove, dá pra ver o que está ativo sem ler nada. -->
    <template name="condLinha">
        <layout align="top" height="24" margins="{bottom=1}">
            <rectangle align="client" color="#080A0F" strokeColor="#1C2130" strokeSize="1">
                <rectangle name="chipChkcond_$(chave)" align="left" width="225" color="#080A0F"
                           strokeColor="#2A3145" strokeSize="1" xradius="2" yradius="2"
                           cornerType="round" cursor="handPoint" hint="$(nome)"
                           margins="{left=3,top=2,bottom=2,right=6}">
                    <label name="txtChkcond_$(chave)" align="client" text="$(nome)" class="val"
                           fontSize="12" horzTextAlign="center" vertTextAlign="center" hitTest="false"/>
                    <event name="onClick"><![CDATA[
                        NCN.alternar(self, sheet, "cond_$(chave)", "$(cor)");
                    ]]></event>
                </rectangle>
                <label align="client" text="$(efeito)" class="conta" vertTextAlign="center"/>
            </rectangle>
        </layout>
        <dataLink field="cond_$(chave)">
            <event name="onChange"><![CDATA[ NCN.recalcular(sheet, self); ]]></event>
        </dataLink>
    </template>

    <!-- Linha de detalhe do catálogo -->
    <template name="linhaCat">
        <layout name="linhaCat$(i)" align="top" height="0" margins="{top=4}">
            <label name="lblCatRot$(i)" align="left" width="146" text="" class="rot"/>
            <label name="lblCatVal$(i)" align="client" text="" class="val" wordWrap="true"/>
        </layout>
    </template>

    <!-- ================================================================== -->
    <!-- EVENTOS DO FORMULÁRIO                                              -->
    <!-- ================================================================== -->

    <event name="onNodeReady"><![CDATA[
        NCN.iniciar(self, sheet);
    ]]></event>

    <event name="onShow"><![CDATA[
        -- É ao mostrar que o layout ganha tamanho real. Sem esta chamada a
        -- fileira de cards abre comprimida e só se ajeita quando o jogador
        -- mexe em algum campo.
        NCN.ajustarGrades(self);
        NCN.pintarAbas(self, sheet);
    ]]></event>

    <event name="onResize"><![CDATA[
        NCN.ajustarGrades(self);
    ]]></event>

    <!-- ================================================================== -->
    <!-- DATALINKS — o que dispara o recálculo                              -->
    <!-- (os das perícias e condições vivem dentro dos templates)           -->
    <!-- ================================================================== -->

    <dataLink fields="{'cor','ref','men','von','bonusCor','bonusRef','bonusMen','bonusVon'}">
        <event name="onChange"><![CDATA[ NCN.recalcular(sheet, self); ]]></event>
    </dataLink>

    <dataLink fields="{'ajustePv','ajusteFoco','ajusteEsquiva','ajusteVel','ajustePercepcao',
                       'ajusteHumanidade','ajusteIniciativa','ajusteRd','pvAtual','focoAtual'}">
        <event name="onChange"><![CDATA[ NCN.recalcular(sheet, self); ]]></event>
    </dataLink>

    <dataLink fields="{'riquezaTier','eddiesLimpos','eddiesSujos','xpGanho','ajustePontos'}">
        <event name="onChange"><![CDATA[ NCN.recalcular(sheet, self); ]]></event>
    </dataLink>

    <dataLink fields="{'cenaCobertura','cenaAlvoCorpo','cenaAlcance','cenaOrdinalAtaque',
                       'cenaModManual','cenaRdAlvo','cenaFurtivo','cenaAlvoCaido','cenaEuCaido',
                       'cenaSupressao','cenaRajada','cenaDeVeiculo','cenaNoMotorista'}">
        <event name="onChange"><![CDATA[ NCN.recalcular(sheet, self); ]]></event>
    </dataLink>

    <dataLink fields="{'netSistema','netModManual','netAlerta','terreno','hiato',
                       'perseguicaoModManual','fichaFinalizada'}">
        <event name="onChange"><![CDATA[ NCN.recalcular(sheet, self); ]]></event>
    </dataLink>

    <!-- O cabeçalho fixo mostra nome, papel e afiliação: precisa se repintar
         quando esses campos mudam, senão fica exibindo o nome antigo. -->
    <dataLink fields="{'nome','profissao','alterEgo','afiliacao'}">
        <event name="onChange"><![CDATA[ NCN.pintarCabecalho(self, sheet); ]]></event>
    </dataLink>

    <!-- `revisao` é o sinal que as linhas das listas emitem: elas vivem em
         outro formulário e não enxergam o `self` desta ficha. Ao mexer numa
         linha, ela toca este campo e a ficha inteira se repinta. -->
    <dataLink field="revisao">
        <event name="onChange"><![CDATA[ NCN.recalcular(sheet, self); ]]></event>
    </dataLink>

    <dataLink field="cyberware">
        <event name="onChildAdded"><![CDATA[   NCN.recalcular(sheet, self); ]]></event>
        <event name="onChildRemoved"><![CDATA[ NCN.recalcular(sheet, self); ]]></event>
    </dataLink>
    <dataLink field="armasEquipamento">
        <event name="onChildAdded"><![CDATA[   NCN.recalcular(sheet, self); ]]></event>
        <event name="onChildRemoved"><![CDATA[ NCN.recalcular(sheet, self); ]]></event>
    </dataLink>
    <dataLink field="armadurasEquipamento">
        <event name="onChildAdded"><![CDATA[   NCN.recalcular(sheet, self); ]]></event>
        <event name="onChildRemoved"><![CDATA[ NCN.recalcular(sheet, self); ]]></event>
    </dataLink>
    <dataLink field="itensUtilitarios">
        <event name="onChildAdded"><![CDATA[   NCN.recalcular(sheet, self); ]]></event>
        <event name="onChildRemoved"><![CDATA[ NCN.recalcular(sheet, self); ]]></event>
    </dataLink>
    <dataLink field="vantagens">
        <event name="onChildAdded"><![CDATA[   NCN.recalcular(sheet, self); ]]></event>
        <event name="onChildRemoved"><![CDATA[ NCN.recalcular(sheet, self); ]]></event>
    </dataLink>
    <dataLink field="desvantagens">
        <event name="onChildAdded"><![CDATA[   NCN.recalcular(sheet, self); ]]></event>
        <event name="onChildRemoved"><![CDATA[ NCN.recalcular(sheet, self); ]]></event>
    </dataLink>
    <dataLink field="programas">
        <event name="onChildAdded"><![CDATA[   NCN.recalcular(sheet, self); ]]></event>
        <event name="onChildRemoved"><![CDATA[ NCN.recalcular(sheet, self); ]]></event>
    </dataLink>
    <dataLink field="veiculos">
        <event name="onChildAdded"><![CDATA[   NCN.recalcular(sheet, self); ]]></event>
        <event name="onChildRemoved"><![CDATA[ NCN.recalcular(sheet, self); ]]></event>
    </dataLink>

</form>
